[
  {
    "start": 0.0,
    "end": 2.12,
    "text": "Saat deadline mendekat dan masalah"
  },
  {
    "start": 2.12,
    "end": 3.99,
    "text": "menumpuk di meja kerjamu,"
  },
  {
    "start": 3.99,
    "end": 5.86,
    "text": "sangat mudah bagi pikiran kita"
  },
  {
    "start": 5.86,
    "end": 8.35,
    "text": "untuk menjadi panik dan kalap."
  },
  {
    "start": 8.35,
    "end": 9.91,
    "text": "Dalam kondisi panik,"
  },
  {
    "start": 9.91,
    "end": 12.34,
    "text": "kita cenderung mengambil keputusan yang"
  },
  {
    "start": 12.34,
    "end": 14.71,
    "text": "terburu-buru yang pada akhirnya justru"
  },
  {
    "start": 14.71,
    "end": 16.58,
    "text": "memperburuk keadaan."
  },
  {
    "start": 16.58,
    "end": 18.26,
    "text": "Kapan pun kamu merasa mulai"
  },
  {
    "start": 18.26,
    "end": 19.75,
    "text": "kehilangan kendali,"
  },
  {
    "start": 19.75,
    "end": 21.5,
    "text": "hentikan apa pun yang sedang"
  },
  {
    "start": 21.5,
    "end": 22.93,
    "text": "kamu lakukan."
  },
  {
    "start": 22.93,
    "end": 25.3,
    "text": "Tarik napas dalam-dalam selama sepuluh"
  },
  {
    "start": 25.3,
    "end": 25.99,
    "text": "detik,"
  },
  {
    "start": 25.99,
    "end": 27.67,
    "text": "dan minum segelas air putih"
  },
  {
    "start": 27.67,
    "end": 28.73,
    "text": "dingin."
  },
  {
    "start": 28.73,
    "end": 30.6,
    "text": "Ingatlah bahwa kamu tidak bisa"
  },
  {
    "start": 30.6,
    "end": 33.4,
    "text": "menyelesaikan sepuluh masalah sekaligus dalam"
  },
  {
    "start": 33.4,
    "end": 34.71,
    "text": "satu detik."
  },
  {
    "start": 34.71,
    "end": 36.83,
    "text": "Kamu hanya bisa menyelesaikan satu"
  },
  {
    "start": 36.83,
    "end": 38.7,
    "text": "hal pada satu waktu."
  },
  {
    "start": 38.7,
    "end": 40.76,
    "text": "Pilihlah satu masalah yang paling"
  },
  {
    "start": 40.76,
    "end": 41.63,
    "text": "mendesak,"
  },
  {
    "start": 41.63,
    "end": 43.5,
    "text": "selesaikan dengan tenang,"
  },
  {
    "start": 43.5,
    "end": 46.3,
    "text": "baru beralih ke masalah berikutnya."
  },
  {
    "start": 46.3,
    "end": 48.67,
    "text": "Ketenangan adalah senjata paling ampuh"
  },
  {
    "start": 48.67,
    "end": 50.91,
    "text": "untuk menaklukkan tekanan."
  }
]