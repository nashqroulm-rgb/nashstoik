[
  {
    "start": 0.0,
    "end": 1.93,
    "text": "Berapa banyak dari kita yang"
  },
  {
    "start": 1.93,
    "end": 4.54,
    "text": "mengabaikan kebahagiaan nyata di depan"
  },
  {
    "start": 4.54,
    "end": 6.74,
    "text": "mata hanya karena sibuk mengejar"
  },
  {
    "start": 6.74,
    "end": 9.08,
    "text": "kemewahan yang belum tentu membuat"
  },
  {
    "start": 9.08,
    "end": 10.32,
    "text": "bahagia?"
  },
  {
    "start": 10.32,
    "end": 12.24,
    "text": "Secangkir kopi panas di pagi"
  },
  {
    "start": 12.24,
    "end": 12.93,
    "text": "hari,"
  },
  {
    "start": 12.93,
    "end": 15.48,
    "text": "aroma tanah basah setelah hujan,"
  },
  {
    "start": 15.48,
    "end": 17.4,
    "text": "atau tawa renyah orang tuamu"
  },
  {
    "start": 17.4,
    "end": 19.05,
    "text": "di meja makan."
  },
  {
    "start": 19.05,
    "end": 21.81,
    "text": "Hal-hal sederhana itulah yang sebenarnya"
  },
  {
    "start": 21.81,
    "end": 23.8,
    "text": "memberi nyawa dan rasa hangat"
  },
  {
    "start": 23.8,
    "end": 26.35,
    "text": "pada perjalanan hidup kita."
  },
  {
    "start": 26.35,
    "end": 28.89,
    "text": "Dunia periklanan akan selalu berusaha"
  },
  {
    "start": 28.89,
    "end": 31.23,
    "text": "meyakinkanmu bahwa kamu kurang ini"
  },
  {
    "start": 31.23,
    "end": 32.88,
    "text": "dan kurang itu agar kamu"
  },
  {
    "start": 32.88,
    "end": 34.74,
    "text": "terus berbelanja."
  },
  {
    "start": 34.74,
    "end": 36.53,
    "text": "Tapi orang yang bijak tahu"
  },
  {
    "start": 36.53,
    "end": 38.59,
    "text": "bahwa kekayaan sejati ada pada"
  },
  {
    "start": 38.59,
    "end": 40.79,
    "text": "mata yang bisa melihat keindahan"
  },
  {
    "start": 40.79,
    "end": 43.68,
    "text": "di balik hal-hal yang sederhana."
  },
  {
    "start": 43.68,
    "end": 44.71,
    "text": "Malam ini,"
  },
  {
    "start": 44.71,
    "end": 48.36,
    "text": "pandanglah sekelilingmu dengan mata syukur."
  },
  {
    "start": 48.36,
    "end": 50.9,
    "text": "Hidupmu sebenarnya sudah sangat indah"
  },
  {
    "start": 50.9,
    "end": 52.35,
    "text": "apa adanya."
  }
]