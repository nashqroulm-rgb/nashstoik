[
  {
    "start": 0.0,
    "end": 1.95,
    "text": "Uang adalah alat yang sangat"
  },
  {
    "start": 1.95,
    "end": 4.4,
    "text": "baik untuk melayani kehidupan,"
  },
  {
    "start": 4.4,
    "end": 6.14,
    "text": "tapi dia adalah tuan yang"
  },
  {
    "start": 6.14,
    "end": 8.65,
    "text": "sangat kejam jika kamu membiarkannya"
  },
  {
    "start": 8.65,
    "end": 10.81,
    "text": "mengendalikan jiwamu."
  },
  {
    "start": 10.81,
    "end": 12.84,
    "text": "Berapa banyak orang yang rela"
  },
  {
    "start": 12.84,
    "end": 14.65,
    "text": "merusak persaudaraan,"
  },
  {
    "start": 14.65,
    "end": 17.23,
    "text": "mengorbankan waktu bersama anak,"
  },
  {
    "start": 17.23,
    "end": 19.6,
    "text": "dan menjual kejujuran mereka hanya"
  },
  {
    "start": 19.6,
    "end": 21.77,
    "text": "demi mengejar angka di rekening"
  },
  {
    "start": 21.77,
    "end": 22.81,
    "text": "bank?"
  },
  {
    "start": 22.81,
    "end": 25.05,
    "text": "Mereka mengira uang bisa membeli"
  },
  {
    "start": 25.05,
    "end": 26.09,
    "text": "segalanya,"
  },
  {
    "start": 26.09,
    "end": 28.53,
    "text": "tapi kenyataannya uang tidak pernah"
  },
  {
    "start": 28.53,
    "end": 31.11,
    "text": "bisa membeli tidur yang nyenyak,"
  },
  {
    "start": 31.11,
    "end": 33.07,
    "text": "keluarga yang harmonis,"
  },
  {
    "start": 33.07,
    "end": 35.65,
    "text": "atau kedamaian hati nurani."
  },
  {
    "start": 35.65,
    "end": 38.3,
    "text": "Bekerjalah dengan giat untuk mencukupi"
  },
  {
    "start": 38.3,
    "end": 40.11,
    "text": "kebutuhan keluargamu,"
  },
  {
    "start": 40.11,
    "end": 42.28,
    "text": "tapi jangan pernah biarkan rasa"
  },
  {
    "start": 42.28,
    "end": 44.93,
    "text": "serakah membutakan matamu dari hal-hal"
  },
  {
    "start": 44.93,
    "end": 47.44,
    "text": "yang benar-benar bernilai."
  },
  {
    "start": 47.44,
    "end": 49.46,
    "text": "Kekayaan hakiki ada pada hati"
  },
  {
    "start": 49.46,
    "end": 51.9,
    "text": "yang selalu merasa cukup."
  },
  {
    "start": 51.9,
    "end": 54.21,
    "text": "Milikilah harta di tanganmu,"
  },
  {
    "start": 54.21,
    "end": 56.23,
    "text": "tapi jangan biarkan harta itu"
  },
  {
    "start": 56.23,
    "end": 58.04,
    "text": "meracuni dadamu."
  }
]