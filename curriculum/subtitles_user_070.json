[
  {
    "start": 0.0,
    "end": 1.83,
    "text": "Genap tujuh puluh hari kita"
  },
  {
    "start": 1.83,
    "end": 4.54,
    "text": "berjalan bersama meniti jalan ketenangan"
  },
  {
    "start": 4.54,
    "end": 5.62,
    "text": "batin."
  },
  {
    "start": 5.62,
    "end": 8.4,
    "text": "Perhatikan bagaimana dirimu sekarang saat"
  },
  {
    "start": 8.4,
    "end": 10.97,
    "text": "menghadapi omongan miring atau situasi"
  },
  {
    "start": 10.97,
    "end": 13.27,
    "text": "yang tidak menyenangkan."
  },
  {
    "start": 13.27,
    "end": 15.24,
    "text": "Kamu sudah jauh lebih mandiri"
  },
  {
    "start": 15.24,
    "end": 17.07,
    "text": "secara emosional."
  },
  {
    "start": 17.07,
    "end": 19.1,
    "text": "Kamu tidak lagi mudah terseret"
  },
  {
    "start": 19.1,
    "end": 21.26,
    "text": "oleh opini orang lain."
  },
  {
    "start": 21.26,
    "end": 24.11,
    "text": "Kemandirian jiwa adalah saat kebahagiaanmu"
  },
  {
    "start": 24.11,
    "end": 26.07,
    "text": "berakar kokoh di dalam dadamu"
  },
  {
    "start": 26.07,
    "end": 26.95,
    "text": "sendiri,"
  },
  {
    "start": 26.95,
    "end": 29.12,
    "text": "bukan pada persetujuan atau izin"
  },
  {
    "start": 29.12,
    "end": 30.88,
    "text": "dari orang lain."
  },
  {
    "start": 30.88,
    "end": 32.84,
    "text": "Kamu adalah kapten atas kapal"
  },
  {
    "start": 32.84,
    "end": 34.6,
    "text": "batinmu sendiri."
  },
  {
    "start": 34.6,
    "end": 36.97,
    "text": "Ombak di luar boleh bergelora,"
  },
  {
    "start": 36.97,
    "end": 38.94,
    "text": "tapi kemudi di tanganmu tetap"
  },
  {
    "start": 38.94,
    "end": 40.83,
    "text": "stabil dan tenang."
  },
  {
    "start": 40.83,
    "end": 41.85,
    "text": "Malam ini,"
  },
  {
    "start": 41.85,
    "end": 44.49,
    "text": "istirahatkan tubuhmu dengan rasa bangga"
  },
  {
    "start": 44.49,
    "end": 46.66,
    "text": "atas keteguhan hatimu."
  },
  {
    "start": 46.66,
    "end": 48.49,
    "text": "Tidurlah dengan damai,"
  },
  {
    "start": 48.49,
    "end": 51.33,
    "text": "esok petualangan baru menantimu."
  }
]