[
  {
    "start": 0.0,
    "end": 1.74,
    "text": "Kalau kamu hidup dari tepuk"
  },
  {
    "start": 1.74,
    "end": 3.22,
    "text": "tangan orang lain,"
  },
  {
    "start": 3.22,
    "end": 4.77,
    "text": "maka kamu akan mati oleh"
  },
  {
    "start": 4.77,
    "end": 6.51,
    "text": "caci maki mereka."
  },
  {
    "start": 6.51,
    "end": 8.64,
    "text": "Banyak orang yang jiwanya seperti"
  },
  {
    "start": 8.64,
    "end": 11.6,
    "text": "daun kering yang dipermainkan angin."
  },
  {
    "start": 11.6,
    "end": 13.8,
    "text": "Saat dipuji setinggi langit mereka"
  },
  {
    "start": 13.8,
    "end": 15.02,
    "text": "merasa bangga,"
  },
  {
    "start": 15.02,
    "end": 16.95,
    "text": "tapi saat dicibir sedikit saja"
  },
  {
    "start": 16.95,
    "end": 20.63,
    "text": "mereka langsung merasa hancur berkeping-keping."
  },
  {
    "start": 20.63,
    "end": 23.4,
    "text": "Mengapa kamu menyerahkan kendali perasaanmu"
  },
  {
    "start": 23.4,
    "end": 25.46,
    "text": "kepada penilaian orang lain yang"
  },
  {
    "start": 25.46,
    "end": 28.24,
    "text": "seringkali berubah-ubah sesuai suasana hati"
  },
  {
    "start": 28.24,
    "end": 29.33,
    "text": "mereka?"
  },
  {
    "start": 29.33,
    "end": 31.39,
    "text": "Jadilah seperti batu karang yang"
  },
  {
    "start": 31.39,
    "end": 33.39,
    "text": "kokoh di tepi pantai."
  },
  {
    "start": 33.39,
    "end": 35.13,
    "text": "Air laut yang pasang maupun"
  },
  {
    "start": 35.13,
    "end": 36.94,
    "text": "surut tidak akan pernah bisa"
  },
  {
    "start": 36.94,
    "end": 39.0,
    "text": "menggeser kedudukanmu."
  },
  {
    "start": 39.0,
    "end": 40.87,
    "text": "Lakukan hal yang benar karena"
  },
  {
    "start": 40.87,
    "end": 42.93,
    "text": "itu memang benar dan mulia,"
  },
  {
    "start": 42.93,
    "end": 45.25,
    "text": "bukan demi mencari pujian."
  },
  {
    "start": 45.25,
    "end": 47.57,
    "text": "Pujian sejati adalah ketenangan yang"
  },
  {
    "start": 47.57,
    "end": 49.25,
    "text": "kamu rasakan di dalam hati"
  },
  {
    "start": 49.25,
    "end": 50.99,
    "text": "nuranimu sendiri."
  }
]