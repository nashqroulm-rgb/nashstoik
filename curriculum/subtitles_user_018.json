[
  {
    "start": 0.0,
    "end": 1.39,
    "text": "Hari ini pasti ada saja"
  },
  {
    "start": 1.39,
    "end": 3.51,
    "text": "orang yang membuatmu kesal setengah"
  },
  {
    "start": 3.51,
    "end": 4.54,
    "text": "mati."
  },
  {
    "start": 4.54,
    "end": 6.35,
    "text": "Mungkin rekan kerja yang tidak"
  },
  {
    "start": 6.35,
    "end": 7.81,
    "text": "bertanggung jawab,"
  },
  {
    "start": 7.81,
    "end": 10.17,
    "text": "pengendara yang memotong jalanmu dengan"
  },
  {
    "start": 10.17,
    "end": 10.89,
    "text": "kasar,"
  },
  {
    "start": 10.89,
    "end": 12.83,
    "text": "atau orang yang berbicara dengan"
  },
  {
    "start": 12.83,
    "end": 14.22,
    "text": "nada ketus."
  },
  {
    "start": 14.22,
    "end": 16.22,
    "text": "Wajar kalau batinmu sempat merasa"
  },
  {
    "start": 16.22,
    "end": 18.21,
    "text": "jengkel dan ingin membalas dengan"
  },
  {
    "start": 18.21,
    "end": 19.54,
    "text": "kemarahan."
  },
  {
    "start": 19.54,
    "end": 21.3,
    "text": "Tapi sebelum kamu tidur malam"
  },
  {
    "start": 21.3,
    "end": 21.9,
    "text": "ini,"
  },
  {
    "start": 21.9,
    "end": 24.75,
    "text": "coba ubah sudut pandangmu sebentar."
  },
  {
    "start": 24.75,
    "end": 26.87,
    "text": "Pikirkan mereka bukan sebagai musuh"
  },
  {
    "start": 26.87,
    "end": 29.29,
    "text": "yang sengaja ingin merusak harimu,"
  },
  {
    "start": 29.29,
    "end": 31.52,
    "text": "melainkan sebagai guru kesabaran yang"
  },
  {
    "start": 31.52,
    "end": 34.19,
    "text": "sedang menguji ketahanan jiwamu."
  },
  {
    "start": 34.19,
    "end": 35.64,
    "text": "Kalau di dunia ini semua"
  },
  {
    "start": 35.64,
    "end": 37.51,
    "text": "orang selalu bersikap manis dan"
  },
  {
    "start": 37.51,
    "end": 38.79,
    "text": "ramah kepadamu,"
  },
  {
    "start": 38.79,
    "end": 41.02,
    "text": "bagaimana mungkin jiwamu bisa melatih"
  },
  {
    "start": 41.02,
    "end": 41.99,
    "text": "kesabaran,"
  },
  {
    "start": 41.99,
    "end": 43.02,
    "text": "keikhlasan,"
  },
  {
    "start": 43.02,
    "end": 45.02,
    "text": "dan kedewasaan batin?"
  },
  {
    "start": 45.02,
    "end": 47.01,
    "text": "Orang yang kasar sedang melatihmu"
  },
  {
    "start": 47.01,
    "end": 48.89,
    "text": "untuk tetap lembut."
  },
  {
    "start": 48.89,
    "end": 51.19,
    "text": "Orang yang egois sedang mengingatkanmu"
  },
  {
    "start": 51.19,
    "end": 53.06,
    "text": "untuk tetap peduli."
  },
  {
    "start": 53.06,
    "end": 54.76,
    "text": "Jangan biarkan racun di hati"
  },
  {
    "start": 54.76,
    "end": 57.36,
    "text": "mereka menular ke dalam dadamu."
  },
  {
    "start": 57.36,
    "end": 59.48,
    "text": "Maafkan ketidaktahuan mereka,"
  },
  {
    "start": 59.48,
    "end": 61.23,
    "text": "dan tidurlah dengan hati yang"
  },
  {
    "start": 61.23,
    "end": 62.75,
    "text": "tetap bersih."
  }
]