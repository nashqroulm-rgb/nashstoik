[
  {
    "start": 0.0,
    "end": 2.29,
    "text": "Batin yang tenang membutuhkan raga"
  },
  {
    "start": 2.29,
    "end": 4.32,
    "text": "yang dirawat dengan penuh rasa"
  },
  {
    "start": 4.32,
    "end": 6.61,
    "text": "hormat dan kasih sayang."
  },
  {
    "start": 6.61,
    "end": 8.97,
    "text": "Kita seringkali menuntut tubuh kita"
  },
  {
    "start": 8.97,
    "end": 11.06,
    "text": "bekerja keras tanpa henti,"
  },
  {
    "start": 11.06,
    "end": 13.89,
    "text": "memberinya makanan yang kurang sehat,"
  },
  {
    "start": 13.89,
    "end": 16.12,
    "text": "dan merampas jatah tidur malamnya"
  },
  {
    "start": 16.12,
    "end": 18.68,
    "text": "demi mengejar target materi."
  },
  {
    "start": 18.68,
    "end": 20.03,
    "text": "Ingatlah kawan,"
  },
  {
    "start": 20.03,
    "end": 22.6,
    "text": "tubuhmu adalah satu-satunya rumah yang"
  },
  {
    "start": 22.6,
    "end": 24.75,
    "text": "kamu miliki untuk menjalani sisa"
  },
  {
    "start": 24.75,
    "end": 27.38,
    "text": "kehidupanmu di muka bumi ini."
  },
  {
    "start": 27.38,
    "end": 28.4,
    "text": "Malam ini,"
  },
  {
    "start": 28.4,
    "end": 30.96,
    "text": "dengarkan sinyal lelah yang dikirimkan"
  },
  {
    "start": 30.96,
    "end": 32.51,
    "text": "oleh tubuhmu."
  },
  {
    "start": 32.51,
    "end": 34.8,
    "text": "Beri dia haknya untuk beristirahat"
  },
  {
    "start": 34.8,
    "end": 37.64,
    "text": "dan memulihkan sel-selnya dalam keheningan"
  },
  {
    "start": 37.64,
    "end": 39.46,
    "text": "tidur yang lelap."
  },
  {
    "start": 39.46,
    "end": 42.09,
    "text": "Sayangi ragamu sebagaimana kamu merawat"
  },
  {
    "start": 42.09,
    "end": 43.24,
    "text": "jiwamu."
  },
  {
    "start": 43.24,
    "end": 45.53,
    "text": "Saat tubuhmu sehat dan bugar,"
  },
  {
    "start": 45.53,
    "end": 47.49,
    "text": "batinmu akan jauh lebih mudah"
  },
  {
    "start": 47.49,
    "end": 49.71,
    "text": "memancarkan ketenangan."
  }
]