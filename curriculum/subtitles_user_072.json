[
  {
    "start": 0.0,
    "end": 2.56,
    "text": "Dikhianati atau diingkari janjinya oleh"
  },
  {
    "start": 2.56,
    "end": 4.53,
    "text": "orang yang kita percaya memang"
  },
  {
    "start": 4.53,
    "end": 6.76,
    "text": "meninggalkan bekas luka yang dalam"
  },
  {
    "start": 6.76,
    "end": 7.94,
    "text": "di hati."
  },
  {
    "start": 7.94,
    "end": 9.84,
    "text": "Wajar jika kamu merasa kecewa"
  },
  {
    "start": 9.84,
    "end": 11.68,
    "text": "dan sulit untuk percaya lagi"
  },
  {
    "start": 11.68,
    "end": 13.39,
    "text": "pada orang lain."
  },
  {
    "start": 13.39,
    "end": 15.68,
    "text": "Tapi jangan biarkan kekecewaan pada"
  },
  {
    "start": 15.68,
    "end": 17.85,
    "text": "satu orang membuat hatimu menjadi"
  },
  {
    "start": 17.85,
    "end": 19.88,
    "text": "keras dan membenci seluruh umat"
  },
  {
    "start": 19.88,
    "end": 21.07,
    "text": "manusia."
  },
  {
    "start": 21.07,
    "end": 23.1,
    "text": "Perilaku buruk orang itu adalah"
  },
  {
    "start": 23.1,
    "end": 25.86,
    "text": "cerminan dari karakternya yang lemah,"
  },
  {
    "start": 25.86,
    "end": 28.35,
    "text": "bukan kesalahanmu karena telah berbuat"
  },
  {
    "start": 28.35,
    "end": 29.33,
    "text": "baik."
  },
  {
    "start": 29.33,
    "end": 32.35,
    "text": "Ambillah hikmahnya dengan bijaksana."
  },
  {
    "start": 32.35,
    "end": 33.6,
    "text": "Di masa depan,"
  },
  {
    "start": 33.6,
    "end": 36.29,
    "text": "berikan kepercayaanmu secara bertahap dan"
  },
  {
    "start": 36.29,
    "end": 37.93,
    "text": "lebih selektif."
  },
  {
    "start": 37.93,
    "end": 40.62,
    "text": "Jangan biarkan racun pengkhianatan mereka"
  },
  {
    "start": 40.62,
    "end": 42.98,
    "text": "merampas ketulusan hatimu."
  },
  {
    "start": 42.98,
    "end": 45.15,
    "text": "Tetaplah menjadi orang yang jujur"
  },
  {
    "start": 45.15,
    "end": 46.86,
    "text": "dan dapat diandalkan,"
  },
  {
    "start": 46.86,
    "end": 49.68,
    "text": "karena dunia sangat membutuhkan orang-orang"
  },
  {
    "start": 49.68,
    "end": 50.99,
    "text": "sepertimu."
  }
]