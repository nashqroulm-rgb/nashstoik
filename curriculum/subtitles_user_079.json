[
  {
    "start": 0.0,
    "end": 2.36,
    "text": "Di tengah kesibukan mengejar karier"
  },
  {
    "start": 2.36,
    "end": 3.44,
    "text": "dan materi,"
  },
  {
    "start": 3.44,
    "end": 6.4,
    "text": "kita sering menganggap kehadiran orang-orang"
  },
  {
    "start": 6.4,
    "end": 8.56,
    "text": "terdekat sebagai hal yang lumrah"
  },
  {
    "start": 8.56,
    "end": 11.25,
    "text": "dan akan selalu ada selamanya."
  },
  {
    "start": 11.25,
    "end": 13.14,
    "text": "Kita lupa bahwa setiap detik"
  },
  {
    "start": 13.14,
    "end": 15.09,
    "text": "yang kita lalui bersama orang"
  },
  {
    "start": 15.09,
    "end": 15.7,
    "text": "tua,"
  },
  {
    "start": 15.7,
    "end": 16.64,
    "text": "pasangan,"
  },
  {
    "start": 16.64,
    "end": 19.0,
    "text": "atau anak-anak kita adalah pinjaman"
  },
  {
    "start": 19.0,
    "end": 20.76,
    "text": "waktu yang suatu saat akan"
  },
  {
    "start": 20.76,
    "end": 22.51,
    "text": "diambil kembali."
  },
  {
    "start": 22.51,
    "end": 24.53,
    "text": "Jangan tunggu sampai ada kabar"
  },
  {
    "start": 24.53,
    "end": 26.62,
    "text": "duka baru kamu menyadari betapa"
  },
  {
    "start": 26.62,
    "end": 28.77,
    "text": "berharganya suara tawa mereka di"
  },
  {
    "start": 28.77,
    "end": 29.99,
    "text": "rumahmu."
  },
  {
    "start": 29.99,
    "end": 31.0,
    "text": "Malam ini,"
  },
  {
    "start": 31.0,
    "end": 33.42,
    "text": "letakkan dulu pekerjaanmu."
  },
  {
    "start": 33.42,
    "end": 35.78,
    "text": "Tataplah mata orang-orang yang kamu"
  },
  {
    "start": 35.78,
    "end": 38.55,
    "text": "cintai dengan penuh kehangatan."
  },
  {
    "start": 38.55,
    "end": 40.97,
    "text": "Katakan bahwa kamu menyayangi mereka"
  },
  {
    "start": 40.97,
    "end": 43.33,
    "text": "dan bersyukur memiliki mereka dalam"
  },
  {
    "start": 43.33,
    "end": 44.54,
    "text": "hidupmu."
  },
  {
    "start": 44.54,
    "end": 46.9,
    "text": "Cinta yang diungkapkan dengan tulus"
  },
  {
    "start": 46.9,
    "end": 48.92,
    "text": "hari ini adalah bekal terindah"
  },
  {
    "start": 48.92,
    "end": 51.15,
    "text": "bagi perjalanan jiwamu."
  }
]