[
  {
    "start": 0.0,
    "end": 1.92,
    "text": "Berapa banyak teman yang kamu"
  },
  {
    "start": 1.92,
    "end": 3.91,
    "text": "miliki saat kamu sedang senang"
  },
  {
    "start": 3.91,
    "end": 5.77,
    "text": "dan punya banyak uang,"
  },
  {
    "start": 5.77,
    "end": 8.02,
    "text": "dan berapa banyak yang benar-benar"
  },
  {
    "start": 8.02,
    "end": 9.74,
    "text": "ada di sampingmu saat kamu"
  },
  {
    "start": 9.74,
    "end": 12.79,
    "text": "sedang terpuruk di titik terendah?"
  },
  {
    "start": 12.79,
    "end": 15.38,
    "text": "Kita seringkali membuang waktu berharga"
  },
  {
    "start": 15.38,
    "end": 17.83,
    "text": "untuk menyenangkan ratusan kenalan di"
  },
  {
    "start": 17.83,
    "end": 19.09,
    "text": "media sosial,"
  },
  {
    "start": 19.09,
    "end": 20.94,
    "text": "tapi melupakan satu atau dua"
  },
  {
    "start": 20.94,
    "end": 23.06,
    "text": "sahabat sejati yang selalu tulus"
  },
  {
    "start": 23.06,
    "end": 25.18,
    "text": "menopang hidup kita."
  },
  {
    "start": 25.18,
    "end": 27.5,
    "text": "Dengar baik-baik kawan."
  },
  {
    "start": 27.5,
    "end": 29.62,
    "text": "Sahabat sejati bukan mereka yang"
  },
  {
    "start": 29.62,
    "end": 31.94,
    "text": "selalu memuji dan membenarkan semua"
  },
  {
    "start": 31.94,
    "end": 33.53,
    "text": "kesalahanmu."
  },
  {
    "start": 33.53,
    "end": 35.72,
    "text": "Sahabat sejati adalah mereka yang"
  },
  {
    "start": 35.72,
    "end": 37.97,
    "text": "berani menegurmu dengan jujur saat"
  },
  {
    "start": 37.97,
    "end": 39.5,
    "text": "kamu salah jalan,"
  },
  {
    "start": 39.5,
    "end": 41.75,
    "text": "dan tetap merangkulmu tanpa pamrih"
  },
  {
    "start": 41.75,
    "end": 44.0,
    "text": "saat dunia menjauhimu."
  },
  {
    "start": 44.0,
    "end": 45.07,
    "text": "Malam ini,"
  },
  {
    "start": 45.07,
    "end": 47.65,
    "text": "luangkan waktu sebentar untuk mengingat"
  },
  {
    "start": 47.65,
    "end": 50.23,
    "text": "orang-orang baik yang pernah menemanimu"
  },
  {
    "start": 50.23,
    "end": 52.29,
    "text": "di masa-masa sulit."
  },
  {
    "start": 52.29,
    "end": 54.81,
    "text": "Kirimkan doa tulus untuk mereka,"
  },
  {
    "start": 54.81,
    "end": 57.46,
    "text": "atau kirimkan pesan sederhana menanyakan"
  },
  {
    "start": 57.46,
    "end": 59.11,
    "text": "kabar mereka."
  },
  {
    "start": 59.11,
    "end": 61.1,
    "text": "Satu hubungan tulus jauh lebih"
  },
  {
    "start": 61.1,
    "end": 63.49,
    "text": "berharga daripada seribu pujian semu"
  },
  {
    "start": 63.49,
    "end": 65.41,
    "text": "dari orang asing."
  }
]