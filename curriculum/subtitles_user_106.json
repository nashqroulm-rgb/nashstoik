[
  {
    "start": 0.0,
    "end": 2.07,
    "text": "Masa depan adalah ruang misteri"
  },
  {
    "start": 2.07,
    "end": 5.06,
    "text": "yang seringkali dipenuhi oleh monster-monster"
  },
  {
    "start": 5.06,
    "end": 7.4,
    "text": "khayalan yang kita ciptakan sendiri"
  },
  {
    "start": 7.4,
    "end": 9.46,
    "text": "di dalam kepala kita."
  },
  {
    "start": 9.46,
    "end": 11.93,
    "text": "Kita mencemaskan bagaimana nasib kita"
  },
  {
    "start": 11.93,
    "end": 13.53,
    "text": "sepuluh tahun lagi,"
  },
  {
    "start": 13.53,
    "end": 15.99,
    "text": "mencemaskan krisis ekonomi yang belum"
  },
  {
    "start": 15.99,
    "end": 17.26,
    "text": "tentu terjadi,"
  },
  {
    "start": 17.26,
    "end": 19.26,
    "text": "atau mencemaskan hari tua yang"
  },
  {
    "start": 19.26,
    "end": 20.66,
    "text": "masih jauh."
  },
  {
    "start": 20.66,
    "end": 22.12,
    "text": "Ketahuilah kawan,"
  },
  {
    "start": 22.12,
    "end": 23.72,
    "text": "kamu tidak hidup di masa"
  },
  {
    "start": 23.72,
    "end": 24.79,
    "text": "depan."
  },
  {
    "start": 24.79,
    "end": 26.39,
    "text": "Kamu hanya hidup di satu"
  },
  {
    "start": 26.39,
    "end": 28.05,
    "text": "detik saat ini."
  },
  {
    "start": 28.05,
    "end": 30.45,
    "text": "Satu-satunya cara paling ampuh untuk"
  },
  {
    "start": 30.45,
    "end": 32.52,
    "text": "membangun masa depan yang cerah"
  },
  {
    "start": 32.52,
    "end": 34.65,
    "text": "dan aman adalah dengan melakukan"
  },
  {
    "start": 34.65,
    "end": 36.52,
    "text": "yang terbaik pada tugas yang"
  },
  {
    "start": 36.52,
    "end": 38.12,
    "text": "ada di depan matamu hari"
  },
  {
    "start": 38.12,
    "end": 39.05,
    "text": "ini."
  },
  {
    "start": 39.05,
    "end": 40.98,
    "text": "Kendalikan apa yang bisa kamu"
  },
  {
    "start": 40.98,
    "end": 42.65,
    "text": "kendalikan saat ini,"
  },
  {
    "start": 42.65,
    "end": 44.91,
    "text": "lalu serahkan sisanya dengan penuh"
  },
  {
    "start": 44.91,
    "end": 46.25,
    "text": "keyakinan."
  },
  {
    "start": 46.25,
    "end": 48.51,
    "text": "Masa depan akan menyambutmu dengan"
  },
  {
    "start": 48.51,
    "end": 50.38,
    "text": "baik jika kamu setia merawat"
  },
  {
    "start": 50.38,
    "end": 51.64,
    "text": "hari ini."
  }
]