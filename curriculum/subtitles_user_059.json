[
  {
    "start": 0.0,
    "end": 1.51,
    "text": "Kita ini hidup di zaman"
  },
  {
    "start": 1.51,
    "end": 3.14,
    "text": "serba cepat di mana semua"
  },
  {
    "start": 3.14,
    "end": 5.96,
    "text": "orang menuntut hasil yang instan."
  },
  {
    "start": 5.96,
    "end": 7.27,
    "text": "Mau cepat kaya,"
  },
  {
    "start": 7.27,
    "end": 8.84,
    "text": "mau cepat terkenal,"
  },
  {
    "start": 8.84,
    "end": 10.35,
    "text": "dan mau cepat sampai ke"
  },
  {
    "start": 10.35,
    "end": 12.45,
    "text": "puncak tanpa mau melewati proses"
  },
  {
    "start": 12.45,
    "end": 14.67,
    "text": "belajar yang melelahkan."
  },
  {
    "start": 14.67,
    "end": 16.97,
    "text": "Akhirnya banyak orang yang batinnya"
  },
  {
    "start": 16.97,
    "end": 19.72,
    "text": "rapuh karena pondasinya dangkal."
  },
  {
    "start": 19.72,
    "end": 21.16,
    "text": "Ketahuilah kawan,"
  },
  {
    "start": 21.16,
    "end": 22.93,
    "text": "segala hal yang berharga di"
  },
  {
    "start": 22.93,
    "end": 25.09,
    "text": "dunia ini membutuhkan waktu untuk"
  },
  {
    "start": 25.09,
    "end": 28.04,
    "text": "berakar dan bertumbuh dengan kokoh."
  },
  {
    "start": 28.04,
    "end": 30.46,
    "text": "Bambu Cina butuh waktu bertahun-tahun"
  },
  {
    "start": 30.46,
    "end": 32.56,
    "text": "di dalam tanah untuk menumbuhkan"
  },
  {
    "start": 32.56,
    "end": 34.06,
    "text": "akarnya yang kuat,"
  },
  {
    "start": 34.06,
    "end": 36.81,
    "text": "sebelum akhirnya menjulang tinggi menembus"
  },
  {
    "start": 36.81,
    "end": 39.24,
    "text": "awan dalam hitungan minggu."
  },
  {
    "start": 39.24,
    "end": 41.66,
    "text": "Jangan gelisah kalau progresmu terasa"
  },
  {
    "start": 41.66,
    "end": 43.36,
    "text": "lambat hari ini."
  },
  {
    "start": 43.36,
    "end": 45.66,
    "text": "Yang terpenting kamu tidak berhenti"
  },
  {
    "start": 45.66,
    "end": 46.97,
    "text": "melangkah."
  },
  {
    "start": 46.97,
    "end": 48.47,
    "text": "Nikmati prosesnya,"
  },
  {
    "start": 48.47,
    "end": 50.83,
    "text": "jiwamu sedang dipersiapkan untuk hal"
  },
  {
    "start": 50.83,
    "end": 51.88,
    "text": "besar."
  }
]