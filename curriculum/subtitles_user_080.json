[
  {
    "start": 0.0,
    "end": 2.07,
    "text": "Berapa banyak karya hebat yang"
  },
  {
    "start": 2.07,
    "end": 4.22,
    "text": "tidak pernah lahir hanya karena"
  },
  {
    "start": 4.22,
    "end": 6.5,
    "text": "penciptanya merasa malu dan takut"
  },
  {
    "start": 6.5,
    "end": 9.2,
    "text": "ditertawakan oleh orang lain?"
  },
  {
    "start": 9.2,
    "end": 11.41,
    "text": "Rasa malu yang berlebihan adalah"
  },
  {
    "start": 11.41,
    "end": 13.21,
    "text": "rantai besi tak kasat mata"
  },
  {
    "start": 13.21,
    "end": 15.63,
    "text": "yang mengunci seluruh potensi hebat"
  },
  {
    "start": 15.63,
    "end": 17.91,
    "text": "yang telah semesta anugerahkan ke"
  },
  {
    "start": 17.91,
    "end": 19.5,
    "text": "dalam dirimu."
  },
  {
    "start": 19.5,
    "end": 20.96,
    "text": "Sadarilah kawan,"
  },
  {
    "start": 20.96,
    "end": 23.72,
    "text": "orang-orang yang suka menertawakan usaha"
  },
  {
    "start": 23.72,
    "end": 26.01,
    "text": "orang lain biasanya adalah mereka"
  },
  {
    "start": 26.01,
    "end": 28.22,
    "text": "yang tidak pernah berani mencoba"
  },
  {
    "start": 28.22,
    "end": 30.36,
    "text": "berkarya sama sekali."
  },
  {
    "start": 30.36,
    "end": 33.13,
    "text": "Komentar mencibir mereka akan terlupakan"
  },
  {
    "start": 33.13,
    "end": 35.27,
    "text": "dalam waktu beberapa hari,"
  },
  {
    "start": 35.27,
    "end": 37.49,
    "text": "tapi karya dan keberanianmu akan"
  },
  {
    "start": 37.49,
    "end": 39.84,
    "text": "membekas sepanjang masa."
  },
  {
    "start": 39.84,
    "end": 41.77,
    "text": "Hancurkan rasa malu semu itu"
  },
  {
    "start": 41.77,
    "end": 43.16,
    "text": "malam ini."
  },
  {
    "start": 43.16,
    "end": 45.51,
    "text": "Beranilah tampil apa adanya dengan"
  },
  {
    "start": 45.51,
    "end": 48.76,
    "text": "segala keunikan dan ketulusan niatmu."
  },
  {
    "start": 48.76,
    "end": 50.83,
    "text": "Dunia butuh karyamu."
  }
]