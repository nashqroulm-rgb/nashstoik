[
  {
    "start": 0.0,
    "end": 2.52,
    "text": "Mendengar namamu dibicarakan di belakang"
  },
  {
    "start": 2.52,
    "end": 4.92,
    "text": "punggungmu oleh orang-orang yang tidak"
  },
  {
    "start": 4.92,
    "end": 8.32,
    "text": "tahu kebenarannya memang sangat menyakitkan."
  },
  {
    "start": 8.32,
    "end": 10.65,
    "text": "Dorongan pertamamu pasti ingin segera"
  },
  {
    "start": 10.65,
    "end": 13.24,
    "text": "melabrak mereka dan mengklarifikasi semua"
  },
  {
    "start": 13.24,
    "end": 15.32,
    "text": "tuduhan palsu tersebut."
  },
  {
    "start": 15.32,
    "end": 17.33,
    "text": "Tapi tanyakan pada hatimu kawan:"
  },
  {
    "start": 17.33,
    "end": 19.85,
    "text": "apakah serigala peduli dengan gonggongan"
  },
  {
    "start": 19.85,
    "end": 22.19,
    "text": "anjing kecil di tepi jalan?"
  },
  {
    "start": 22.19,
    "end": 23.57,
    "text": "Tentu tidak."
  },
  {
    "start": 23.57,
    "end": 25.97,
    "text": "Serigala tetap melangkah anggun menuju"
  },
  {
    "start": 25.97,
    "end": 27.23,
    "text": "tujuannya."
  },
  {
    "start": 27.23,
    "end": 30.0,
    "text": "Orang-orang yang menyebarkan gosip tentangmu"
  },
  {
    "start": 30.0,
    "end": 32.65,
    "text": "sebenarnya sedang mengorbankan waktu hidup"
  },
  {
    "start": 32.65,
    "end": 34.67,
    "text": "mereka yang berharga hanya untuk"
  },
  {
    "start": 34.67,
    "end": 36.43,
    "text": "mengurusi hidupmu."
  },
  {
    "start": 36.43,
    "end": 39.02,
    "text": "Mengapa kamu harus merasa rugi?"
  },
  {
    "start": 39.02,
    "end": 41.47,
    "text": "Biarkan karakter dan integritas hidupmu"
  },
  {
    "start": 41.47,
    "end": 43.68,
    "text": "yang berbicara membantah fitnah itu"
  },
  {
    "start": 43.68,
    "end": 45.57,
    "text": "dari waktu ke waktu."
  },
  {
    "start": 45.57,
    "end": 47.78,
    "text": "Tetaplah tegak dan melangkah dengan"
  },
  {
    "start": 47.78,
    "end": 48.85,
    "text": "bersih."
  }
]