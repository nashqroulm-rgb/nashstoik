[
  {
    "start": 0.0,
    "end": 2.46,
    "text": "Banyak orang terjebak dalam kelumpuhan"
  },
  {
    "start": 2.46,
    "end": 3.69,
    "text": "analisis."
  },
  {
    "start": 3.69,
    "end": 6.73,
    "text": "Mereka terus menimbang-nimbang keputusan selama"
  },
  {
    "start": 6.73,
    "end": 9.38,
    "text": "berbulan-bulan karena takut memilih jalan"
  },
  {
    "start": 9.38,
    "end": 10.74,
    "text": "yang salah."
  },
  {
    "start": 10.74,
    "end": 12.87,
    "text": "Akhirnya peluang itu lewat begitu"
  },
  {
    "start": 12.87,
    "end": 13.52,
    "text": "saja,"
  },
  {
    "start": 13.52,
    "end": 15.33,
    "text": "dan mereka tetap terpuruk di"
  },
  {
    "start": 15.33,
    "end": 17.08,
    "text": "tempat yang sama."
  },
  {
    "start": 17.08,
    "end": 18.5,
    "text": "Ketahuilah kawan,"
  },
  {
    "start": 18.5,
    "end": 20.31,
    "text": "di dalam kehidupan ini tidak"
  },
  {
    "start": 20.31,
    "end": 22.45,
    "text": "ada keputusan yang seratus persen"
  },
  {
    "start": 22.45,
    "end": 24.26,
    "text": "bebas dari risiko."
  },
  {
    "start": 24.26,
    "end": 26.2,
    "text": "Setiap pilihan yang kamu ambil"
  },
  {
    "start": 26.2,
    "end": 28.98,
    "text": "pasti memiliki konsekuensi dan tantangannya"
  },
  {
    "start": 28.98,
    "end": 30.15,
    "text": "sendiri."
  },
  {
    "start": 30.15,
    "end": 32.54,
    "text": "Yang membuat sebuah keputusan menjadi"
  },
  {
    "start": 32.54,
    "end": 35.06,
    "text": "benar bukanlah ramalan masa depan,"
  },
  {
    "start": 35.06,
    "end": 38.23,
    "text": "melainkan komitmenmu untuk memperjuangkan pilihan"
  },
  {
    "start": 38.23,
    "end": 40.24,
    "text": "itu dengan sepenuh hati setelah"
  },
  {
    "start": 40.24,
    "end": 41.6,
    "text": "diputuskan."
  },
  {
    "start": 41.6,
    "end": 43.67,
    "text": "Kumpulkan fakta secukupnya,"
  },
  {
    "start": 43.67,
    "end": 45.87,
    "text": "dengarkan kata hati nuranimu,"
  },
  {
    "start": 45.87,
    "end": 48.91,
    "text": "lalu buatlah keputusan dengan berani."
  },
  {
    "start": 48.91,
    "end": 50.98,
    "text": "Lebih baik melangkah dan belajar"
  },
  {
    "start": 50.98,
    "end": 53.63,
    "text": "daripada diam dalam penyesalan."
  }
]