[
  {
    "start": 0.0,
    "end": 2.26,
    "text": "Banyak orang bermimpi ingin mengubah"
  },
  {
    "start": 2.26,
    "end": 5.27,
    "text": "hidupnya secara drastis dalam semalam."
  },
  {
    "start": 5.27,
    "end": 7.53,
    "text": "Mereka membuat target yang terlampau"
  },
  {
    "start": 7.53,
    "end": 8.23,
    "text": "besar,"
  },
  {
    "start": 8.23,
    "end": 9.98,
    "text": "lalu menyerah di hari ketiga"
  },
  {
    "start": 9.98,
    "end": 11.68,
    "text": "karena kelelahan."
  },
  {
    "start": 11.68,
    "end": 13.75,
    "text": "Kunci perubahan hidup yang sejati"
  },
  {
    "start": 13.75,
    "end": 16.51,
    "text": "bukanlah lompatan spektakuler yang dilakukan"
  },
  {
    "start": 16.51,
    "end": 17.71,
    "text": "sesekali."
  },
  {
    "start": 17.71,
    "end": 19.59,
    "text": "Kunci perubahan hidup ada pada"
  },
  {
    "start": 19.59,
    "end": 21.91,
    "text": "disiplin melakukan hal-hal kecil yang"
  },
  {
    "start": 21.91,
    "end": 25.05,
    "text": "bermanfaat secara konsisten setiap hari."
  },
  {
    "start": 25.05,
    "end": 27.06,
    "text": "Membaca lima halaman buku setiap"
  },
  {
    "start": 27.06,
    "end": 27.75,
    "text": "malam,"
  },
  {
    "start": 27.75,
    "end": 29.64,
    "text": "berjalan kaki lima belas menit"
  },
  {
    "start": 29.64,
    "end": 30.7,
    "text": "setiap pagi,"
  },
  {
    "start": 30.7,
    "end": 33.09,
    "text": "atau menyisihkan sedikit rezeki setiap"
  },
  {
    "start": 33.09,
    "end": 34.1,
    "text": "pekan."
  },
  {
    "start": 34.1,
    "end": 36.36,
    "text": "Tetesan air yang jatuh terus-menerus"
  },
  {
    "start": 36.36,
    "end": 37.93,
    "text": "ke atas batu karang,"
  },
  {
    "start": 37.93,
    "end": 40.44,
    "text": "perlahan-lahan akan mampu melubangi batu"
  },
  {
    "start": 40.44,
    "end": 42.01,
    "text": "yang keras itu."
  },
  {
    "start": 42.01,
    "end": 44.27,
    "text": "Jangan remehkan langkah kecilmu hari"
  },
  {
    "start": 44.27,
    "end": 45.52,
    "text": "ini kawan."
  },
  {
    "start": 45.52,
    "end": 48.1,
    "text": "Lakukan dengan setia dan tekun."
  },
  {
    "start": 48.1,
    "end": 50.11,
    "text": "Ribuan langkah kecil itulah yang"
  },
  {
    "start": 50.11,
    "end": 52.05,
    "text": "pada akhirnya akan membawamu ke"
  },
  {
    "start": 52.05,
    "end": 54.13,
    "text": "puncak gunung impianmu."
  }
]