[
  {
    "start": 0.0,
    "end": 2.51,
    "text": "Banyak orang mengira integritas hanya"
  },
  {
    "start": 2.51,
    "end": 5.36,
    "text": "diuji dalam keputusan-keputusan besar yang"
  },
  {
    "start": 5.36,
    "end": 7.46,
    "text": "disaksikan oleh banyak orang di"
  },
  {
    "start": 7.46,
    "end": 9.15,
    "text": "panggung dunia."
  },
  {
    "start": 9.15,
    "end": 11.93,
    "text": "Padahal integritas sejati justru dibentuk"
  },
  {
    "start": 11.93,
    "end": 13.9,
    "text": "dan diuji dalam hal-hal kecil"
  },
  {
    "start": 13.9,
    "end": 15.93,
    "text": "yang tidak pernah dilihat oleh"
  },
  {
    "start": 15.93,
    "end": 17.29,
    "text": "siapa pun."
  },
  {
    "start": 17.29,
    "end": 19.73,
    "text": "Apakah kamu tetap mengembalikan uang"
  },
  {
    "start": 19.73,
    "end": 22.03,
    "text": "kembalian yang berlebih saat kasir"
  },
  {
    "start": 22.03,
    "end": 24.47,
    "text": "toko keliru menghitungnya?"
  },
  {
    "start": 24.47,
    "end": 26.71,
    "text": "Apakah kamu tetap membuang sampah"
  },
  {
    "start": 26.71,
    "end": 28.74,
    "text": "pada tempatnya di jalanan yang"
  },
  {
    "start": 28.74,
    "end": 29.76,
    "text": "sepi?"
  },
  {
    "start": 29.76,
    "end": 31.93,
    "text": "Hal-hal kecil itulah yang secara"
  },
  {
    "start": 31.93,
    "end": 35.18,
    "text": "perlahan membangun pondasi kepribadianmu menjadi"
  },
  {
    "start": 35.18,
    "end": 37.01,
    "text": "kokoh atau rapuh."
  },
  {
    "start": 37.01,
    "end": 39.11,
    "text": "Lakukanlah hal yang benar dalam"
  },
  {
    "start": 39.11,
    "end": 42.23,
    "text": "setiap tindakan kecilmu setiap hari."
  },
  {
    "start": 42.23,
    "end": 44.47,
    "text": "Kebanggaan sejati di depan cermin"
  },
  {
    "start": 44.47,
    "end": 46.91,
    "text": "batinmu jauh lebih berharga daripada"
  },
  {
    "start": 46.91,
    "end": 49.55,
    "text": "seluruh pengakuan semu dunia."
  }
]