[
  {
    "start": 0.0,
    "end": 1.98,
    "text": "Banyak orang merasa malu atau"
  },
  {
    "start": 1.98,
    "end": 4.24,
    "text": "takut dianggap bodoh hanya karena"
  },
  {
    "start": 4.24,
    "end": 6.84,
    "text": "harus mengucapkan tiga kata sederhana:"
  },
  {
    "start": 6.84,
    "end": 8.61,
    "text": "saya tidak tahu."
  },
  {
    "start": 8.61,
    "end": 11.14,
    "text": "Kita sering memaksakan diri pura-pura"
  },
  {
    "start": 11.14,
    "end": 11.9,
    "text": "paham,"
  },
  {
    "start": 11.9,
    "end": 13.26,
    "text": "pura-pura ahli,"
  },
  {
    "start": 13.26,
    "end": 15.18,
    "text": "hanya demi menjaga gengsi di"
  },
  {
    "start": 15.18,
    "end": 17.02,
    "text": "depan orang lain."
  },
  {
    "start": 17.02,
    "end": 19.42,
    "text": "Akhirnya kita hidup dalam kepalsuan"
  },
  {
    "start": 19.42,
    "end": 22.08,
    "text": "yang sangat melelahkan batin."
  },
  {
    "start": 22.08,
    "end": 23.52,
    "text": "Sadarilah kawan,"
  },
  {
    "start": 23.52,
    "end": 25.57,
    "text": "mengakui bahwa kamu belum tahu"
  },
  {
    "start": 25.57,
    "end": 27.96,
    "text": "bukanlah tanda kelemahan."
  },
  {
    "start": 27.96,
    "end": 29.81,
    "text": "Justru itu adalah awal dari"
  },
  {
    "start": 29.81,
    "end": 32.54,
    "text": "lahirnya kebijaksanaan sejati."
  },
  {
    "start": 32.54,
    "end": 34.66,
    "text": "Orang yang paling malang adalah"
  },
  {
    "start": 34.66,
    "end": 36.65,
    "text": "mereka yang merasa sudah tahu"
  },
  {
    "start": 36.65,
    "end": 37.67,
    "text": "segalanya,"
  },
  {
    "start": 37.67,
    "end": 40.2,
    "text": "sehingga pintu hatinya tertutup rapat"
  },
  {
    "start": 40.2,
    "end": 42.46,
    "text": "untuk belajar hal baru."
  },
  {
    "start": 42.46,
    "end": 45.19,
    "text": "Jangan biarkan rasa gengsimu menghalangi"
  },
  {
    "start": 45.19,
    "end": 47.18,
    "text": "pertumbuhan jiwamu."
  },
  {
    "start": 47.18,
    "end": 48.82,
    "text": "Beranilah bertanya,"
  },
  {
    "start": 48.82,
    "end": 51.82,
    "text": "beranilah menjadi murid kehidupan."
  },
  {
    "start": 51.82,
    "end": 53.74,
    "text": "Dunia ini terlalu luas untuk"
  },
  {
    "start": 53.74,
    "end": 55.72,
    "text": "dipahami sendirian."
  },
  {
    "start": 55.72,
    "end": 57.23,
    "text": "Rendahkan hatimu,"
  },
  {
    "start": 57.23,
    "end": 59.62,
    "text": "dan nikmati setiap proses belajarmu"
  },
  {
    "start": 59.62,
    "end": 60.92,
    "text": "hari ini."
  }
]