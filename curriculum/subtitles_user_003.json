[
  {
    "start": 0.0,
    "end": 1.76,
    "text": "Berapa kali hari ini kamu buka"
  },
  {
    "start": 1.76,
    "end": 2.14,
    "text": "ponsel,"
  },
  {
    "start": 2.45,
    "end": 5.09,
    "text": "terus tanpa sadar merasa minder melihat"
  },
  {
    "start": 5.09,
    "end": 6.13,
    "text": "pencapaian orang lain?"
  },
  {
    "start": 7.02,
    "end": 9.12,
    "text": "Melihat orang lain seumuran sudah punya"
  },
  {
    "start": 9.12,
    "end": 10.37,
    "text": "ini dan itu,"
  },
  {
    "start": 10.9,
    "end": 12.33,
    "text": "jalan-jalan ke sana kemari."
  },
  {
    "start": 12.8,
    "end": 15.34,
    "text": "Lalu tiba-tiba dadamu terasa sesak dan"
  },
  {
    "start": 15.34,
    "end": 17.06,
    "text": "merasa hidupmu jalan di tempat."
  },
  {
    "start": 17.77,
    "end": 18.49,
    "text": "Dengar baik-baik,"
  },
  {
    "start": 18.49,
    "end": 18.82,
    "text": "kawan."
  },
  {
    "start": 19.33,
    "end": 21.57,
    "text": "Kamu merasa lelah malam ini bukan"
  },
  {
    "start": 21.57,
    "end": 22.95,
    "text": "karena kamu kurang berusaha,"
  },
  {
    "start": 23.32,
    "end": 26.04,
    "text": "tapi karena kepalamu terlalu ramai menampung"
  },
  {
    "start": 26.04,
    "end": 27.26,
    "text": "hidup orang lain."
  },
  {
    "start": 27.53,
    "end": 29.39,
    "text": "Apa yang kamu lihat di layar"
  },
  {
    "start": 29.39,
    "end": 32.06,
    "text": "itu cuma potongan terbaik mereka yang"
  },
  {
    "start": 32.06,
    "end": 32.65,
    "text": "sudah dipoles,"
  },
  {
    "start": 33.19,
    "end": 35.33,
    "text": "bukan kenyataan hidup mereka sehari-hari."
  },
  {
    "start": 35.89,
    "end": 38.97,
    "text": "Sementara kamu membandingkannya dengan seluruh kekuranganmu"
  },
  {
    "start": 38.97,
    "end": 40.67,
    "text": "yang ada di balik layar."
  },
  {
    "start": 41.01,
    "end": 43.19,
    "text": "Jelas tidak adil buat dirimu sendiri."
  },
  {
    "start": 43.68,
    "end": 46.46,
    "text": "Ketenangan itu letaknya ada di dalam"
  },
  {
    "start": 46.46,
    "end": 46.88,
    "text": "dadamu,"
  },
  {
    "start": 47.33,
    "end": 49.55,
    "text": "bukan di lini masa media sosial."
  },
  {
    "start": 50.11,
    "end": 52.48,
    "text": "Kamu tidak sedang balapan dengan siapapun"
  },
  {
    "start": 52.48,
    "end": 53.44,
    "text": "di dunia ini."
  },
  {
    "start": 54.12,
    "end": 54.91,
    "text": "Malam ini,"
  },
  {
    "start": 55.19,
    "end": 56.52,
    "text": "letakkan dulu ponselmu."
  },
  {
    "start": 57.06,
    "end": 58.46,
    "text": "Duduklah dalam hening,"
  },
  {
    "start": 58.94,
    "end": 62.06,
    "text": "nikmati hembusan napasmu sendiri dan bersyukurlah"
  },
  {
    "start": 62.53,
    "end": 65.37,
    "text": "kamu masih punya diri sendiri yang"
  },
  {
    "start": 65.37,
    "end": 67.42,
    "text": "setia berjuang sampai hari ini."
  }
]