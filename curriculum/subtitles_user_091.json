[
  {
    "start": 0.0,
    "end": 2.14,
    "text": "Malam ini kita menuntaskan pekan"
  },
  {
    "start": 2.14,
    "end": 4.61,
    "text": "ketigabelas dari ikhtiar kita merawat"
  },
  {
    "start": 4.61,
    "end": 6.34,
    "text": "ketenangan jiwa."
  },
  {
    "start": 6.34,
    "end": 8.81,
    "text": "Coba perhatikan bagaimana dadamu saat"
  },
  {
    "start": 8.81,
    "end": 11.35,
    "text": "menghadapi hal-hal yang tidak berjalan"
  },
  {
    "start": 11.35,
    "end": 14.22,
    "text": "sesuai rencanamu akhir-akhir ini."
  },
  {
    "start": 14.22,
    "end": 16.09,
    "text": "Dadamu kini sudah jauh lebih"
  },
  {
    "start": 16.09,
    "end": 18.29,
    "text": "lapang dari sebelumnya."
  },
  {
    "start": 18.29,
    "end": 20.9,
    "text": "Kelapangan dada adalah kemampuan jiwamu"
  },
  {
    "start": 20.9,
    "end": 24.1,
    "text": "untuk menampung berbagai ketidaksempurnaan dunia"
  },
  {
    "start": 24.1,
    "end": 27.04,
    "text": "tanpa merasa sesak atau terbebani."
  },
  {
    "start": 27.04,
    "end": 28.98,
    "text": "Ibarat lautan luas yang mampu"
  },
  {
    "start": 28.98,
    "end": 31.05,
    "text": "menampung air sungai yang keruh"
  },
  {
    "start": 31.05,
    "end": 34.05,
    "text": "tanpa kehilangan kebersihan dan kejernihannya"
  },
  {
    "start": 34.05,
    "end": 35.25,
    "text": "sendiri."
  },
  {
    "start": 35.25,
    "end": 36.26,
    "text": "Malam ini,"
  },
  {
    "start": 36.26,
    "end": 39.26,
    "text": "istirahatkan seluruh tubuhmu dalam ketenangan"
  },
  {
    "start": 39.26,
    "end": 40.66,
    "text": "yang dalam."
  },
  {
    "start": 40.66,
    "end": 43.0,
    "text": "Bersyukurlah atas setiap napas yang"
  },
  {
    "start": 43.0,
    "end": 45.74,
    "text": "masih mengalir di dalam ragamu."
  },
  {
    "start": 45.74,
    "end": 48.27,
    "text": "Tidurlah dengan damai kawan."
  }
]