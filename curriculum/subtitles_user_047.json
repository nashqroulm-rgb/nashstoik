[
  {
    "start": 0.0,
    "end": 1.88,
    "text": "Banyak orang merasa panik dan"
  },
  {
    "start": 1.88,
    "end": 3.77,
    "text": "cemas saat melihat uban mulai"
  },
  {
    "start": 3.77,
    "end": 5.84,
    "text": "tumbuh di rambutnya atau kerutan"
  },
  {
    "start": 5.84,
    "end": 8.12,
    "text": "mulai tampak di wajahnya."
  },
  {
    "start": 8.12,
    "end": 10.07,
    "text": "Mereka takut menjadi tua,"
  },
  {
    "start": 10.07,
    "end": 12.92,
    "text": "berusaha mati-matian menolak kenyataan alami"
  },
  {
    "start": 12.92,
    "end": 14.74,
    "text": "yang pasti akan dilalui oleh"
  },
  {
    "start": 14.74,
    "end": 16.75,
    "text": "setiap makhluk hidup."
  },
  {
    "start": 16.75,
    "end": 19.29,
    "text": "Padahal bertambahnya usia adalah sebuah"
  },
  {
    "start": 19.29,
    "end": 21.37,
    "text": "anugerah agung yang tidak sempat"
  },
  {
    "start": 21.37,
    "end": 23.7,
    "text": "dirasakan oleh mereka yang meninggal"
  },
  {
    "start": 23.7,
    "end": 25.2,
    "text": "di usia muda."
  },
  {
    "start": 25.2,
    "end": 27.73,
    "text": "Jangan sesali bertambahnya angka umurmu"
  },
  {
    "start": 27.73,
    "end": 28.77,
    "text": "kawan."
  },
  {
    "start": 28.77,
    "end": 31.24,
    "text": "Yang terpenting bukanlah seberapa lama"
  },
  {
    "start": 31.24,
    "end": 33.12,
    "text": "kamu hidup di dunia ini,"
  },
  {
    "start": 33.12,
    "end": 35.52,
    "text": "melainkan seberapa dalam dan bermakna"
  },
  {
    "start": 35.52,
    "end": 38.51,
    "text": "jejak kebaikan yang kamu tinggalkan."
  },
  {
    "start": 38.51,
    "end": 41.17,
    "text": "Jadilah pribadi yang semakin matang,"
  },
  {
    "start": 41.17,
    "end": 42.47,
    "text": "semakin tenang,"
  },
  {
    "start": 42.47,
    "end": 44.87,
    "text": "dan semakin bijak seiring berjalannya"
  },
  {
    "start": 44.87,
    "end": 45.91,
    "text": "waktu."
  },
  {
    "start": 45.91,
    "end": 48.12,
    "text": "Rangkul setiap fase hidupmu dengan"
  },
  {
    "start": 48.12,
    "end": 50.91,
    "text": "rasa syukur dan keanggunan batin."
  }
]