[
  {
    "start": 0.0,
    "end": 2.02,
    "text": "Berapa sering kamu berkata pada"
  },
  {
    "start": 2.02,
    "end": 4.17,
    "text": "dirimu sendiri: nanti kalau sudah"
  },
  {
    "start": 4.17,
    "end": 6.45,
    "text": "sukses baru aku bisa bahagia,"
  },
  {
    "start": 6.45,
    "end": 8.27,
    "text": "nanti kalau liburan baru aku"
  },
  {
    "start": 8.27,
    "end": 9.84,
    "text": "bisa tenang?"
  },
  {
    "start": 9.84,
    "end": 12.18,
    "text": "Kita suka sekali menunda kebahagiaan"
  },
  {
    "start": 12.18,
    "end": 13.75,
    "text": "ke masa depan yang belum"
  },
  {
    "start": 13.75,
    "end": 14.98,
    "text": "tentu datang,"
  },
  {
    "start": 14.98,
    "end": 17.46,
    "text": "sambil menyia-nyiakan hari yang sedang"
  },
  {
    "start": 17.46,
    "end": 19.61,
    "text": "kita jalani sekarang."
  },
  {
    "start": 19.61,
    "end": 21.5,
    "text": "Sadar atau tidak kawan,"
  },
  {
    "start": 21.5,
    "end": 23.39,
    "text": "hidup ini bukan tentang garis"
  },
  {
    "start": 23.39,
    "end": 25.47,
    "text": "akhir di masa depan."
  },
  {
    "start": 25.47,
    "end": 27.56,
    "text": "Hidup ini adalah tarikan napasmu"
  },
  {
    "start": 27.56,
    "end": 28.53,
    "text": "saat ini,"
  },
  {
    "start": 28.53,
    "end": 30.49,
    "text": "langkah kakimu hari ini,"
  },
  {
    "start": 30.49,
    "end": 32.25,
    "text": "dan senyuman yang bisa kamu"
  },
  {
    "start": 32.25,
    "end": 34.27,
    "text": "berikan kepada orang di dekatmu"
  },
  {
    "start": 34.27,
    "end": 35.63,
    "text": "sekarang."
  },
  {
    "start": 35.63,
    "end": 37.72,
    "text": "Masa lalu sudah menjadi kenangan"
  },
  {
    "start": 37.72,
    "end": 39.61,
    "text": "yang tidak bisa diubah,"
  },
  {
    "start": 39.61,
    "end": 41.56,
    "text": "masa depan adalah misteri yang"
  },
  {
    "start": 41.56,
    "end": 42.74,
    "text": "belum pasti,"
  },
  {
    "start": 42.74,
    "end": 45.02,
    "text": "dan satu-satunya milikmu yang nyata"
  },
  {
    "start": 45.02,
    "end": 47.03,
    "text": "hanyalah detik ini."
  },
  {
    "start": 47.03,
    "end": 49.12,
    "text": "Jangan sampai kamu terlalu sibuk"
  },
  {
    "start": 49.12,
    "end": 51.33,
    "text": "mengejar bayangan hari esok,"
  },
  {
    "start": 51.33,
    "end": 53.35,
    "text": "sampai kamu lupa melihat betapa"
  },
  {
    "start": 53.35,
    "end": 55.5,
    "text": "berharganya hari ini."
  },
  {
    "start": 55.5,
    "end": 57.65,
    "text": "Peluk keluargamu malam ini,"
  },
  {
    "start": 57.65,
    "end": 60.19,
    "text": "nikmati makanan sederhanamu dengan rasa"
  },
  {
    "start": 60.19,
    "end": 61.04,
    "text": "syukur,"
  },
  {
    "start": 61.04,
    "end": 63.19,
    "text": "dan berterima kasihlah atas napas"
  },
  {
    "start": 63.19,
    "end": 65.93,
    "text": "yang masih mengalir di dadamu."
  },
  {
    "start": 65.93,
    "end": 68.6,
    "text": "Hiduplah sepenuhnya hari ini."
  }
]