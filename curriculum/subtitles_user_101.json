[
  {
    "start": 0.0,
    "end": 3.07,
    "text": "Bahkan setelah berbulan-bulan melatih ketenangan"
  },
  {
    "start": 3.07,
    "end": 3.77,
    "text": "batin,"
  },
  {
    "start": 3.77,
    "end": 6.14,
    "text": "adakalanya kita masih bisa terpeleset"
  },
  {
    "start": 6.14,
    "end": 8.95,
    "text": "dan kehilangan kendali emosi kita."
  },
  {
    "start": 8.95,
    "end": 11.45,
    "text": "Mungkin kemarin kamu sempat marah-marah"
  },
  {
    "start": 11.45,
    "end": 12.66,
    "text": "kepada anakmu,"
  },
  {
    "start": 12.66,
    "end": 14.65,
    "text": "atau sempat merasa sangat cemas"
  },
  {
    "start": 14.65,
    "end": 17.08,
    "text": "terhadap urusan pekerjaanmu."
  },
  {
    "start": 17.08,
    "end": 18.74,
    "text": "Lalu muncul suara di dalam"
  },
  {
    "start": 18.74,
    "end": 20.98,
    "text": "kepalamu yang mencemooh dan berkata"
  },
  {
    "start": 20.98,
    "end": 23.02,
    "text": "bahwa semua latihanmu selama ini"
  },
  {
    "start": 23.02,
    "end": 24.62,
    "text": "sia-sia belaka."
  },
  {
    "start": 24.62,
    "end": 27.05,
    "text": "Jangan dengarkan suara yang melemahkan"
  },
  {
    "start": 27.05,
    "end": 28.33,
    "text": "itu kawan."
  },
  {
    "start": 28.33,
    "end": 31.02,
    "text": "Menjadi bijaksana bukanlah berarti menjadi"
  },
  {
    "start": 31.02,
    "end": 33.77,
    "text": "manusia sempurna yang tanpa cela."
  },
  {
    "start": 33.77,
    "end": 36.33,
    "text": "Menjadi bijaksana adalah kemampuan untuk"
  },
  {
    "start": 36.33,
    "end": 38.44,
    "text": "segera bangkit dan memaafkan diri"
  },
  {
    "start": 38.44,
    "end": 40.61,
    "text": "sendiri saat terpeleset."
  },
  {
    "start": 40.61,
    "end": 42.79,
    "text": "Tarik napas dalam-dalam."
  },
  {
    "start": 42.79,
    "end": 44.83,
    "text": "Bersihkan debu kegagalanmu,"
  },
  {
    "start": 44.83,
    "end": 46.88,
    "text": "dan mulailah kembali dengan hati"
  },
  {
    "start": 46.88,
    "end": 48.93,
    "text": "yang bersih malam ini."
  }
]