[
  {
    "start": 0.0,
    "end": 2.35,
    "text": "Kita sebagai manusia seringkali merasa"
  },
  {
    "start": 2.35,
    "end": 4.64,
    "text": "sangat tertekan karena ingin memiliki"
  },
  {
    "start": 4.64,
    "end": 6.38,
    "text": "kepastian atas segala hal di"
  },
  {
    "start": 6.38,
    "end": 7.8,
    "text": "hidup kita."
  },
  {
    "start": 7.8,
    "end": 9.84,
    "text": "Kita ingin memastikan karier kita"
  },
  {
    "start": 9.84,
    "end": 11.76,
    "text": "aman lima tahun ke depan,"
  },
  {
    "start": 11.76,
    "end": 14.18,
    "text": "ingin memastikan hubungan kita langgeng"
  },
  {
    "start": 14.18,
    "end": 15.17,
    "text": "selamanya,"
  },
  {
    "start": 15.17,
    "end": 17.03,
    "text": "dan ingin memastikan tidak ada"
  },
  {
    "start": 17.03,
    "end": 19.75,
    "text": "musibah yang datang menghampiri."
  },
  {
    "start": 19.75,
    "end": 22.04,
    "text": "Tapi kenyataan hidup mengajarkan kita"
  },
  {
    "start": 22.04,
    "end": 24.02,
    "text": "hal yang sebaliknya."
  },
  {
    "start": 24.02,
    "end": 25.88,
    "text": "Satu-satunya hal yang pasti di"
  },
  {
    "start": 25.88,
    "end": 28.05,
    "text": "dunia ini adalah ketidakpastian itu"
  },
  {
    "start": 28.05,
    "end": 29.29,
    "text": "sendiri."
  },
  {
    "start": 29.29,
    "end": 31.64,
    "text": "Rencana terbaik sekalipun bisa berubah"
  },
  {
    "start": 31.64,
    "end": 33.68,
    "text": "dalam hitungan detik."
  },
  {
    "start": 33.68,
    "end": 36.28,
    "text": "Tarik napas dalam-dalam kawan."
  },
  {
    "start": 36.28,
    "end": 38.51,
    "text": "Ketenangan batinmu tidak akan pernah"
  },
  {
    "start": 38.51,
    "end": 40.87,
    "text": "kamu dapatkan dari mengendalikan dunia"
  },
  {
    "start": 40.87,
    "end": 42.41,
    "text": "di luar sana."
  },
  {
    "start": 42.41,
    "end": 44.58,
    "text": "Ketenangan sejati justru lahir saat"
  },
  {
    "start": 44.58,
    "end": 46.56,
    "text": "kamu punya keyakinan batin bahwa"
  },
  {
    "start": 46.56,
    "end": 48.11,
    "text": "apa pun badai yang datang"
  },
  {
    "start": 48.11,
    "end": 49.1,
    "text": "esok hari,"
  },
  {
    "start": 49.1,
    "end": 51.08,
    "text": "kamu punya kesiapan mental untuk"
  },
  {
    "start": 51.08,
    "end": 52.69,
    "text": "menghadapinya."
  },
  {
    "start": 52.69,
    "end": 55.85,
    "text": "Belajarlah seperti pelaut yang tangguh."
  },
  {
    "start": 55.85,
    "end": 57.52,
    "text": "Dia tidak memohon agar laut"
  },
  {
    "start": 57.52,
    "end": 59.87,
    "text": "selalu tenang tanpa ombak."
  },
  {
    "start": 59.87,
    "end": 61.79,
    "text": "Dia melatih dirinya agar selalu"
  },
  {
    "start": 61.79,
    "end": 64.02,
    "text": "mampu mengendalikan kemudi di tengah"
  },
  {
    "start": 64.02,
    "end": 65.88,
    "text": "gelombang apa pun."
  }
]