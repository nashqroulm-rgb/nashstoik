[
  {
    "start": 0.0,
    "end": 2.14,
    "text": "Malam ini kita menuntaskan pekan"
  },
  {
    "start": 2.14,
    "end": 5.22,
    "text": "kelimabelas perjalanan suci merawat ketenangan"
  },
  {
    "start": 5.22,
    "end": 6.22,
    "text": "jiwa."
  },
  {
    "start": 6.22,
    "end": 9.03,
    "text": "Perhatikan bagaimana hatimu kini memandang"
  },
  {
    "start": 9.03,
    "end": 10.7,
    "text": "sesama manusia."
  },
  {
    "start": 10.7,
    "end": 13.38,
    "text": "Hati nuranimu sudah semakin jernih,"
  },
  {
    "start": 13.38,
    "end": 15.45,
    "text": "bersih dari prasangka buruk dan"
  },
  {
    "start": 15.45,
    "end": 17.66,
    "text": "dendam yang melelahkan."
  },
  {
    "start": 17.66,
    "end": 19.73,
    "text": "Kemurnian hati adalah saat kamu"
  },
  {
    "start": 19.73,
    "end": 21.8,
    "text": "mampu melihat kebaikan di balik"
  },
  {
    "start": 21.8,
    "end": 24.08,
    "text": "setiap orang yang kamu temui,"
  },
  {
    "start": 24.08,
    "end": 26.42,
    "text": "dan mendoakan kedamaian bagi mereka"
  },
  {
    "start": 26.42,
    "end": 29.09,
    "text": "yang belum menemukan jalannya."
  },
  {
    "start": 29.09,
    "end": 31.57,
    "text": "Kamu telah menjadi lentera ketenangan"
  },
  {
    "start": 31.57,
    "end": 34.11,
    "text": "yang menerangi sekelilingmu tanpa kamu"
  },
  {
    "start": 34.11,
    "end": 35.25,
    "text": "sadari."
  },
  {
    "start": 35.25,
    "end": 37.39,
    "text": "Rehatkan ragamu malam ini dengan"
  },
  {
    "start": 37.39,
    "end": 39.33,
    "text": "penuh ketenteraman."
  },
  {
    "start": 39.33,
    "end": 41.87,
    "text": "Biarkan malam membungkus jiwamu dengan"
  },
  {
    "start": 41.87,
    "end": 43.94,
    "text": "kesejukan yang abadi."
  },
  {
    "start": 43.94,
    "end": 47.15,
    "text": "Tidurlah dalam kedamaian mutlak kawan."
  }
]