[
  {
    "start": 0.0,
    "end": 1.68,
    "text": "Saat kamu berdiri di bawah"
  },
  {
    "start": 1.68,
    "end": 3.37,
    "text": "langit malam yang luas dan"
  },
  {
    "start": 3.37,
    "end": 6.09,
    "text": "menatap bintang-bintang di kejauhan,"
  },
  {
    "start": 6.09,
    "end": 8.48,
    "text": "pernahkah kamu merasa betapa kecilnya"
  },
  {
    "start": 8.48,
    "end": 11.01,
    "text": "dirimu di alam semesta ini?"
  },
  {
    "start": 11.01,
    "end": 13.21,
    "text": "Segala ambisi besar yang membuatmu"
  },
  {
    "start": 13.21,
    "end": 14.7,
    "text": "tidak bisa tidur,"
  },
  {
    "start": 14.7,
    "end": 17.22,
    "text": "segala perdebatan sengit yang membuatmu"
  },
  {
    "start": 17.22,
    "end": 18.07,
    "text": "tegang,"
  },
  {
    "start": 18.07,
    "end": 20.2,
    "text": "sebenarnya hanyalah riak kecil di"
  },
  {
    "start": 20.2,
    "end": 23.05,
    "text": "samudera waktu yang sangat luas."
  },
  {
    "start": 23.05,
    "end": 24.93,
    "text": "Sadar akan kecilnya diri kita"
  },
  {
    "start": 24.93,
    "end": 27.13,
    "text": "bukanlah untuk membuat kita merasa"
  },
  {
    "start": 27.13,
    "end": 29.66,
    "text": "rendah diri atau putus asa."
  },
  {
    "start": 29.66,
    "end": 31.79,
    "text": "Justru kesadaran kosmis itu hadir"
  },
  {
    "start": 31.79,
    "end": 33.87,
    "text": "untuk menaruh masalah hidup kita"
  },
  {
    "start": 33.87,
    "end": 36.52,
    "text": "ke dalam proporsi yang wajar."
  },
  {
    "start": 36.52,
    "end": 38.4,
    "text": "Masalah yang kamu hadapi hari"
  },
  {
    "start": 38.4,
    "end": 40.15,
    "text": "ini tidak sebesar yang kamu"
  },
  {
    "start": 40.15,
    "end": 41.51,
    "text": "takutkan."
  },
  {
    "start": 41.51,
    "end": 43.84,
    "text": "Hidup ini hanyalah sebuah perjalanan"
  },
  {
    "start": 43.84,
    "end": 45.65,
    "text": "singkat di mana kita bertamu"
  },
  {
    "start": 45.65,
    "end": 47.85,
    "text": "untuk sementara waktu."
  },
  {
    "start": 47.85,
    "end": 50.51,
    "text": "Nikmati perjalanan ini kawan."
  },
  {
    "start": 50.51,
    "end": 52.58,
    "text": "Jangan bawa terlalu banyak beban"
  },
  {
    "start": 52.58,
    "end": 54.07,
    "text": "ego dan dendam di dalam"
  },
  {
    "start": 54.07,
    "end": 55.69,
    "text": "koper jiwamu."
  },
  {
    "start": 55.69,
    "end": 57.76,
    "text": "Berjalanlah dengan ringan,"
  },
  {
    "start": 57.76,
    "end": 60.61,
    "text": "berbuatlah baik kepada sesama musafir,"
  },
  {
    "start": 60.61,
    "end": 62.81,
    "text": "dan hargai setiap pemandangan yang"
  },
  {
    "start": 62.81,
    "end": 64.37,
    "text": "kamu lewati."
  }
]