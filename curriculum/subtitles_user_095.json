[
  {
    "start": 0.0,
    "end": 2.24,
    "text": "Malam hari bukanlah sekadar jeda"
  },
  {
    "start": 2.24,
    "end": 3.91,
    "text": "antara hari ini dan hari"
  },
  {
    "start": 3.91,
    "end": 4.96,
    "text": "esok."
  },
  {
    "start": 4.96,
    "end": 7.13,
    "text": "Malam hari adalah anugerah suci"
  },
  {
    "start": 7.13,
    "end": 9.29,
    "text": "di mana semesta meredam seluruh"
  },
  {
    "start": 9.29,
    "end": 11.74,
    "text": "hiruk-pikuk dunia agar manusia bisa"
  },
  {
    "start": 11.74,
    "end": 14.67,
    "text": "pulang ke dalam dirinya sendiri."
  },
  {
    "start": 14.67,
    "end": 16.77,
    "text": "Kapan terakhir kali kamu duduk"
  },
  {
    "start": 16.77,
    "end": 18.79,
    "text": "diam di kegelapan malam,"
  },
  {
    "start": 18.79,
    "end": 21.52,
    "text": "hanya mendengarkan suara hembusan angin"
  },
  {
    "start": 21.52,
    "end": 24.24,
    "text": "atau detak jantungmu sendiri?"
  },
  {
    "start": 24.24,
    "end": 26.27,
    "text": "Tanpa dering notifikasi,"
  },
  {
    "start": 26.27,
    "end": 28.36,
    "text": "tanpa tuntutan pekerjaan,"
  },
  {
    "start": 28.36,
    "end": 30.32,
    "text": "dan tanpa sorotan mata siapa"
  },
  {
    "start": 30.32,
    "end": 31.3,
    "text": "pun."
  },
  {
    "start": 31.3,
    "end": 33.46,
    "text": "Di dalam keheningan itulah kamu"
  },
  {
    "start": 33.46,
    "end": 35.98,
    "text": "bisa merasakan kehadiran jiwamu yang"
  },
  {
    "start": 35.98,
    "end": 36.75,
    "text": "murni,"
  },
  {
    "start": 36.75,
    "end": 39.05,
    "text": "terbebas dari segala predikat dan"
  },
  {
    "start": 39.05,
    "end": 41.01,
    "text": "beban sosial yang melekat di"
  },
  {
    "start": 41.01,
    "end": 42.47,
    "text": "siang hari."
  },
  {
    "start": 42.47,
    "end": 43.52,
    "text": "Malam ini,"
  },
  {
    "start": 43.52,
    "end": 46.11,
    "text": "nikmatilah heningnya waktu."
  },
  {
    "start": 46.11,
    "end": 48.97,
    "text": "Biarkan ketenangan malam membasuh seluruh"
  },
  {
    "start": 48.97,
    "end": 52.11,
    "text": "luka dan keletihanmu secara lembut."
  }
]