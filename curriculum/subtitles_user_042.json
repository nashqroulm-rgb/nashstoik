[
  {
    "start": 0.0,
    "end": 2.39,
    "text": "Tujuh hari telah berlalu lagi,"
  },
  {
    "start": 2.39,
    "end": 3.96,
    "text": "dan malam ini kita tiba"
  },
  {
    "start": 3.96,
    "end": 6.49,
    "text": "di penghujung pekan keenam."
  },
  {
    "start": 6.49,
    "end": 8.81,
    "text": "Tanyakan pada dirimu dengan jujur:"
  },
  {
    "start": 8.81,
    "end": 10.72,
    "text": "apakah kamu sudah lebih bisa"
  },
  {
    "start": 10.72,
    "end": 13.66,
    "text": "menjaga emosimu saat menghadapi orang-orang"
  },
  {
    "start": 13.66,
    "end": 16.52,
    "text": "yang menjengkelkan di sekitarmu?"
  },
  {
    "start": 16.52,
    "end": 18.84,
    "text": "Kedewasaan emosi tidak diukur saat"
  },
  {
    "start": 18.84,
    "end": 21.57,
    "text": "keadaan sedang baik-baik saja."
  },
  {
    "start": 21.57,
    "end": 23.96,
    "text": "Kedewasaan emosimu teruji saat kamu"
  },
  {
    "start": 23.96,
    "end": 25.19,
    "text": "sedang lelah,"
  },
  {
    "start": 25.19,
    "end": 25.94,
    "text": "lapar,"
  },
  {
    "start": 25.94,
    "end": 27.11,
    "text": "atau dihina,"
  },
  {
    "start": 27.11,
    "end": 29.09,
    "text": "tapi kamu tetap memilih untuk"
  },
  {
    "start": 29.09,
    "end": 31.47,
    "text": "bersikap tenang dan adil."
  },
  {
    "start": 31.47,
    "end": 33.32,
    "text": "Jika sepekan ini kamu masih"
  },
  {
    "start": 33.32,
    "end": 35.3,
    "text": "sempat terpancing emosi,"
  },
  {
    "start": 35.3,
    "end": 37.35,
    "text": "tidak apa-apa kawan."
  },
  {
    "start": 37.35,
    "end": 39.53,
    "text": "Jangan patah semangat."
  },
  {
    "start": 39.53,
    "end": 42.06,
    "text": "Perjalanan membentuk jiwa yang tenang"
  },
  {
    "start": 42.06,
    "end": 44.86,
    "text": "membutuhkan waktu seumur hidup."
  },
  {
    "start": 44.86,
    "end": 47.18,
    "text": "Yang terpenting adalah kamu selalu"
  },
  {
    "start": 47.18,
    "end": 49.43,
    "text": "sadar dan mau bangkit memperbaiki"
  },
  {
    "start": 49.43,
    "end": 51.27,
    "text": "diri setiap hari."
  },
  {
    "start": 51.27,
    "end": 53.73,
    "text": "Maafkan kekuranganmu malam ini,"
  },
  {
    "start": 53.73,
    "end": 56.53,
    "text": "dan istirahatlah dengan damai menyongsong"
  },
  {
    "start": 56.53,
    "end": 57.97,
    "text": "pekan baru."
  }
]