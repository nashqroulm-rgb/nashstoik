[
  {
    "start": 0.0,
    "end": 2.04,
    "text": "Energi mentalmu setiap hari itu"
  },
  {
    "start": 2.04,
    "end": 2.96,
    "text": "terbatas,"
  },
  {
    "start": 2.96,
    "end": 5.07,
    "text": "sama seperti baterai di ponselmu"
  },
  {
    "start": 5.07,
    "end": 6.91,
    "text": "yang akan habis jika dipakai"
  },
  {
    "start": 6.91,
    "end": 8.5,
    "text": "terus-menerus."
  },
  {
    "start": 8.5,
    "end": 10.93,
    "text": "Tapi mengapa kita sering menghabiskan"
  },
  {
    "start": 10.93,
    "end": 13.04,
    "text": "baterai jiwa kita untuk meladeni"
  },
  {
    "start": 13.04,
    "end": 15.54,
    "text": "perdebatan kusir di media sosial,"
  },
  {
    "start": 15.54,
    "end": 17.65,
    "text": "memikirkan orang yang tidak kita"
  },
  {
    "start": 17.65,
    "end": 18.37,
    "text": "sukai,"
  },
  {
    "start": 18.37,
    "end": 20.22,
    "text": "atau mencemaskan hal yang di"
  },
  {
    "start": 20.22,
    "end": 21.73,
    "text": "luar kendali?"
  },
  {
    "start": 21.73,
    "end": 23.12,
    "text": "Saat malam tiba,"
  },
  {
    "start": 23.12,
    "end": 24.96,
    "text": "kita merasa sangat lelah dan"
  },
  {
    "start": 24.96,
    "end": 25.68,
    "text": "hampa,"
  },
  {
    "start": 25.68,
    "end": 27.79,
    "text": "padahal tidak ada hal bermanfaat"
  },
  {
    "start": 27.79,
    "end": 30.43,
    "text": "yang berhasil kita selesaikan."
  },
  {
    "start": 30.43,
    "end": 31.74,
    "text": "Mulai hari ini,"
  },
  {
    "start": 31.74,
    "end": 34.05,
    "text": "jadilah penjaga yang pelit terhadap"
  },
  {
    "start": 34.05,
    "end": 35.3,
    "text": "energimu."
  },
  {
    "start": 35.3,
    "end": 38.2,
    "text": "Alokasikan perhatianmu hanya untuk pekerjaan"
  },
  {
    "start": 38.2,
    "end": 39.25,
    "text": "yang nyata,"
  },
  {
    "start": 39.25,
    "end": 41.29,
    "text": "keluarga yang kamu cintai,"
  },
  {
    "start": 41.29,
    "end": 43.33,
    "text": "dan hal-hal yang membuat jiwamu"
  },
  {
    "start": 43.33,
    "end": 44.65,
    "text": "bertumbuh."
  },
  {
    "start": 44.65,
    "end": 47.15,
    "text": "Jangan biarkan pencuri energi merampas"
  },
  {
    "start": 47.15,
    "end": 48.93,
    "text": "kedamaian harimu."
  },
  {
    "start": 48.93,
    "end": 51.57,
    "text": "Lindungi batinmu dengan bijak."
  }
]