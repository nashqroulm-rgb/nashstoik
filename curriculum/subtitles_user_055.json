[
  {
    "start": 0.0,
    "end": 2.27,
    "text": "Hidup ini tidak selalu memberikan"
  },
  {
    "start": 2.27,
    "end": 4.19,
    "text": "apa yang kita inginkan,"
  },
  {
    "start": 4.19,
    "end": 6.39,
    "text": "tapi hidup selalu memberikan apa"
  },
  {
    "start": 6.39,
    "end": 8.94,
    "text": "yang kita butuhkan untuk mendewasakan"
  },
  {
    "start": 8.94,
    "end": 10.31,
    "text": "jiwa kita."
  },
  {
    "start": 10.31,
    "end": 11.89,
    "text": "Setiap kehilangan,"
  },
  {
    "start": 11.89,
    "end": 13.34,
    "text": "setiap air mata,"
  },
  {
    "start": 13.34,
    "end": 15.61,
    "text": "dan setiap perpisahan yang pernah"
  },
  {
    "start": 15.61,
    "end": 16.71,
    "text": "kamu lalui,"
  },
  {
    "start": 16.71,
    "end": 19.11,
    "text": "semuanya adalah bagian dari anyaman"
  },
  {
    "start": 19.11,
    "end": 21.31,
    "text": "takdir agung yang sedang menenun"
  },
  {
    "start": 21.31,
    "end": 23.58,
    "text": "dirimu menjadi manusia yang bijak"
  },
  {
    "start": 23.58,
    "end": 25.51,
    "text": "dan berjiwa besar."
  },
  {
    "start": 25.51,
    "end": 28.39,
    "text": "Berhentilah berperang melawan garis takdir"
  },
  {
    "start": 28.39,
    "end": 31.42,
    "text": "yang sudah tertulis di belakangmu."
  },
  {
    "start": 31.42,
    "end": 34.03,
    "text": "Ikhlaskan semua yang telah pergi,"
  },
  {
    "start": 34.03,
    "end": 36.03,
    "text": "dan peluklah semua yang masih"
  },
  {
    "start": 36.03,
    "end": 38.09,
    "text": "ada dengan kedua tanganmu yang"
  },
  {
    "start": 38.09,
    "end": 39.6,
    "text": "penuh cinta."
  },
  {
    "start": 39.6,
    "end": 42.15,
    "text": "Ketenangan tertinggi adalah saat kamu"
  },
  {
    "start": 42.15,
    "end": 44.07,
    "text": "bisa berkata dengan tulus di"
  },
  {
    "start": 44.07,
    "end": 45.93,
    "text": "dalam lubuk hatimu: apa pun"
  },
  {
    "start": 45.93,
    "end": 47.58,
    "text": "yang telah terjadi,"
  },
  {
    "start": 47.58,
    "end": 50.67,
    "text": "aku menerimanya dengan lapang dada."
  },
  {
    "start": 50.67,
    "end": 51.7,
    "text": "Malam ini,"
  },
  {
    "start": 51.7,
    "end": 54.38,
    "text": "serahkan segala kecemasanmu kepada Sang"
  },
  {
    "start": 54.38,
    "end": 56.17,
    "text": "Pemilik Semesta."
  },
  {
    "start": 56.17,
    "end": 59.4,
    "text": "Tidurlah dalam kepasrahan yang damai."
  }
]