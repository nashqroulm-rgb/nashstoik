[
  {
    "start": 0.0,
    "end": 1.97,
    "text": "Kebaikan yang paling murni di"
  },
  {
    "start": 1.97,
    "end": 4.0,
    "text": "dunia ini adalah kebaikan yang"
  },
  {
    "start": 4.0,
    "end": 5.97,
    "text": "kamu lakukan lalu segera kamu"
  },
  {
    "start": 5.97,
    "end": 8.14,
    "text": "lupakan saat itu juga."
  },
  {
    "start": 8.14,
    "end": 10.25,
    "text": "Banyak orang yang saat membantu"
  },
  {
    "start": 10.25,
    "end": 11.06,
    "text": "sesama,"
  },
  {
    "start": 11.06,
    "end": 13.64,
    "text": "diam-diam mencatatnya di dalam ingatan"
  },
  {
    "start": 13.64,
    "end": 14.45,
    "text": "mereka,"
  },
  {
    "start": 14.45,
    "end": 16.76,
    "text": "berharap suatu hari nanti kebaikan"
  },
  {
    "start": 16.76,
    "end": 18.86,
    "text": "itu bisa ditukar dengan imbalan"
  },
  {
    "start": 18.86,
    "end": 20.76,
    "text": "atau penghormatan."
  },
  {
    "start": 20.76,
    "end": 22.53,
    "text": "Itu bukanlah memberi,"
  },
  {
    "start": 22.53,
    "end": 25.85,
    "text": "melainkan berdagang secara terselubung."
  },
  {
    "start": 25.85,
    "end": 28.09,
    "text": "Jadilah seperti mentari pagi yang"
  },
  {
    "start": 28.09,
    "end": 30.67,
    "text": "membagikan cahaya hangatnya ke seluruh"
  },
  {
    "start": 30.67,
    "end": 32.77,
    "text": "bumi tanpa pernah menuntut bumi"
  },
  {
    "start": 32.77,
    "end": 35.49,
    "text": "harus membalas budi kepadanya."
  },
  {
    "start": 35.49,
    "end": 37.79,
    "text": "Bantulah sesamamu dengan hati yang"
  },
  {
    "start": 37.79,
    "end": 40.31,
    "text": "tulus semata-mata karena mereka butuh"
  },
  {
    "start": 40.31,
    "end": 43.43,
    "text": "bantuan dan kamu mampu melakukannya."
  },
  {
    "start": 43.43,
    "end": 45.87,
    "text": "Kebaikan yang dilakukan dengan tulus"
  },
  {
    "start": 45.87,
    "end": 47.9,
    "text": "akan menjadi berkah yang abadi"
  },
  {
    "start": 47.9,
    "end": 49.4,
    "text": "bagi jiwamu."
  }
]