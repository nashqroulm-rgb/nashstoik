[
  {
    "start": 0.0,
    "end": 2.04,
    "text": "Berapa kali kita terlibat dalam"
  },
  {
    "start": 2.04,
    "end": 3.09,
    "text": "percakapan,"
  },
  {
    "start": 3.09,
    "end": 5.33,
    "text": "tapi pikiran kita sebenarnya tidak"
  },
  {
    "start": 5.33,
    "end": 6.98,
    "text": "sedang mendengarkan,"
  },
  {
    "start": 6.98,
    "end": 9.68,
    "text": "melainkan cuma sibuk menyiapkan kata-kata"
  },
  {
    "start": 9.68,
    "end": 12.58,
    "text": "untuk memotong pembicaraan mereka?"
  },
  {
    "start": 12.58,
    "end": 15.14,
    "text": "Kita ingin selalu dianggap pintar,"
  },
  {
    "start": 15.14,
    "end": 16.92,
    "text": "ingin selalu didengar,"
  },
  {
    "start": 16.92,
    "end": 19.09,
    "text": "tapi sangat enggan untuk memahami"
  },
  {
    "start": 19.09,
    "end": 21.07,
    "text": "perasaan orang lain."
  },
  {
    "start": 21.07,
    "end": 22.45,
    "text": "Sadarilah kawan,"
  },
  {
    "start": 22.45,
    "end": 24.49,
    "text": "orang yang batinnya bijak tidak"
  },
  {
    "start": 24.49,
    "end": 27.13,
    "text": "merasa perlu memamerkan kepintarannya di"
  },
  {
    "start": 27.13,
    "end": 28.77,
    "text": "setiap obrolan."
  },
  {
    "start": 28.77,
    "end": 31.01,
    "text": "Mereka lebih suka memasang telinga"
  },
  {
    "start": 31.01,
    "end": 32.2,
    "text": "dengan tulus,"
  },
  {
    "start": 32.2,
    "end": 34.11,
    "text": "memahami apa yang tersirat di"
  },
  {
    "start": 34.11,
    "end": 36.87,
    "text": "balik kata-kata lawan bicaranya."
  },
  {
    "start": 36.87,
    "end": 39.31,
    "text": "Ketika kamu mendengarkan dengan penuh"
  },
  {
    "start": 39.31,
    "end": 40.3,
    "text": "perhatian,"
  },
  {
    "start": 40.3,
    "end": 42.47,
    "text": "kamu tidak hanya mendapatkan ilmu"
  },
  {
    "start": 42.47,
    "end": 43.13,
    "text": "baru,"
  },
  {
    "start": 43.13,
    "end": 45.23,
    "text": "tapi kamu juga memberikan hadiah"
  },
  {
    "start": 45.23,
    "end": 47.8,
    "text": "paling berharga kepada orang lain,"
  },
  {
    "start": 47.8,
    "end": 49.78,
    "text": "yaitu rasa dihargai."
  },
  {
    "start": 49.78,
    "end": 52.41,
    "text": "Latihlah dirimu untuk tidak terburu-buru"
  },
  {
    "start": 52.41,
    "end": 53.79,
    "text": "menghakimi."
  },
  {
    "start": 53.79,
    "end": 56.36,
    "text": "Dengarkan dengan hati yang lapang,"
  },
  {
    "start": 56.36,
    "end": 58.73,
    "text": "dan bicaralah hanya saat kata-katamu"
  },
  {
    "start": 58.73,
    "end": 60.84,
    "text": "membawa manfaat nyata."
  }
]