[
  {
    "start": 0.0,
    "end": 1.57,
    "text": "Malam ini genap dua puluh"
  },
  {
    "start": 1.57,
    "end": 3.71,
    "text": "delapan hari kita berjalan bersama"
  },
  {
    "start": 3.71,
    "end": 6.11,
    "text": "melatih ketenangan batin dan ketahanan"
  },
  {
    "start": 6.11,
    "end": 7.18,
    "text": "jiwa."
  },
  {
    "start": 7.18,
    "end": 8.94,
    "text": "Coba ingat kembali dirimu di"
  },
  {
    "start": 8.94,
    "end": 10.32,
    "text": "awal bulan lalu,"
  },
  {
    "start": 10.32,
    "end": 12.4,
    "text": "dan bandingkan dengan dirimu yang"
  },
  {
    "start": 12.4,
    "end": 15.23,
    "text": "sedang mendengarkan ini sekarang."
  },
  {
    "start": 15.23,
    "end": 17.62,
    "text": "Mungkin masalah hidupmu belum semuanya"
  },
  {
    "start": 17.62,
    "end": 18.51,
    "text": "selesai,"
  },
  {
    "start": 18.51,
    "end": 20.39,
    "text": "mungkin tantangan di luar sana"
  },
  {
    "start": 20.39,
    "end": 22.16,
    "text": "masih tetap ada."
  },
  {
    "start": 22.16,
    "end": 24.8,
    "text": "Tapi perhatikan bagaimana caramu merespons"
  },
  {
    "start": 24.8,
    "end": 26.63,
    "text": "keadaan sekarang."
  },
  {
    "start": 26.63,
    "end": 28.77,
    "text": "Kamu tidak lagi mudah panik,"
  },
  {
    "start": 28.77,
    "end": 30.65,
    "text": "kamu tidak lagi mudah tersulut"
  },
  {
    "start": 30.65,
    "end": 31.47,
    "text": "amarah,"
  },
  {
    "start": 31.47,
    "end": 33.05,
    "text": "dan kamu tahu kapan harus"
  },
  {
    "start": 33.05,
    "end": 36.19,
    "text": "melepaskan hal-hal yang bukan kuasamu."
  },
  {
    "start": 36.19,
    "end": 38.02,
    "text": "Itu adalah tanda bahwa jiwamu"
  },
  {
    "start": 38.02,
    "end": 40.35,
    "text": "sedang bertumbuh menjadi pribadi yang"
  },
  {
    "start": 40.35,
    "end": 42.87,
    "text": "jauh lebih matang dan bijak."
  },
  {
    "start": 42.87,
    "end": 45.32,
    "text": "Hargai setiap perjuangan kecilmu selama"
  },
  {
    "start": 45.32,
    "end": 47.21,
    "text": "sebulan ini kawan."
  },
  {
    "start": 47.21,
    "end": 49.29,
    "text": "Kamu sudah membuktikan bahwa kamu"
  },
  {
    "start": 49.29,
    "end": 51.36,
    "text": "mampu menjadi tuan atas pikiranmu"
  },
  {
    "start": 51.36,
    "end": 52.62,
    "text": "sendiri."
  },
  {
    "start": 52.62,
    "end": 54.82,
    "text": "Tarik napas dalam-dalam dengan rasa"
  },
  {
    "start": 54.82,
    "end": 56.02,
    "text": "syukur."
  },
  {
    "start": 56.02,
    "end": 58.41,
    "text": "Malam ini tidurlah dengan damai,"
  },
  {
    "start": 58.41,
    "end": 60.3,
    "text": "kita akan terus melangkah maju"
  },
  {
    "start": 60.3,
    "end": 63.01,
    "text": "bersama menyongsong masa depan."
  }
]