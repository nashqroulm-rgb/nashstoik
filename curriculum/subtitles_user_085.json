[
  {
    "start": 0.0,
    "end": 2.23,
    "text": "Banyak orang yang batinnya tersiksa"
  },
  {
    "start": 2.23,
    "end": 4.4,
    "text": "karena berusaha keras menahan roda"
  },
  {
    "start": 4.4,
    "end": 7.02,
    "text": "perubahan yang sedang berputar."
  },
  {
    "start": 7.02,
    "end": 8.87,
    "text": "Pekerjaan yang berganti,"
  },
  {
    "start": 8.87,
    "end": 10.46,
    "text": "usia yang bertambah,"
  },
  {
    "start": 10.46,
    "end": 12.44,
    "text": "atau sahabat lama yang perlahan"
  },
  {
    "start": 12.44,
    "end": 14.42,
    "text": "menjauh karena jalan hidup yang"
  },
  {
    "start": 14.42,
    "end": 15.57,
    "text": "berbeda."
  },
  {
    "start": 15.57,
    "end": 16.97,
    "text": "Ketahuilah kawan,"
  },
  {
    "start": 16.97,
    "end": 18.88,
    "text": "satu-satunya hal yang abadi di"
  },
  {
    "start": 18.88,
    "end": 21.05,
    "text": "kolong langit ini adalah perubahan"
  },
  {
    "start": 21.05,
    "end": 22.46,
    "text": "itu sendiri."
  },
  {
    "start": 22.46,
    "end": 24.43,
    "text": "Musim semi pasti berganti musim"
  },
  {
    "start": 24.43,
    "end": 25.14,
    "text": "gugur,"
  },
  {
    "start": 25.14,
    "end": 26.73,
    "text": "dan fajar pagi pasti akan"
  },
  {
    "start": 26.73,
    "end": 28.84,
    "text": "berganti menjadi malam."
  },
  {
    "start": 28.84,
    "end": 31.0,
    "text": "Menolak perubahan sama saja dengan"
  },
  {
    "start": 31.0,
    "end": 33.11,
    "text": "mencoba menahan air terjun dengan"
  },
  {
    "start": 33.11,
    "end": 35.21,
    "text": "kedua telapak tanganmu."
  },
  {
    "start": 35.21,
    "end": 37.13,
    "text": "Itu hanya akan membuatmu lelah"
  },
  {
    "start": 37.13,
    "end": 38.53,
    "text": "dan terluka."
  },
  {
    "start": 38.53,
    "end": 40.45,
    "text": "Orang yang bijak tidak melawan"
  },
  {
    "start": 40.45,
    "end": 41.72,
    "text": "arus perubahan,"
  },
  {
    "start": 41.72,
    "end": 44.85,
    "text": "melainkan menyesuaikan layar perahunya."
  },
  {
    "start": 44.85,
    "end": 47.46,
    "text": "Belajarlah berenang mengikuti alur takdir"
  },
  {
    "start": 47.46,
    "end": 49.63,
    "text": "dengan hati yang lapang."
  }
]