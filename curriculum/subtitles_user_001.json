[
  {
    "start": 0.0,
    "end": 2.13,
    "text": "Jika malam ini dada"
  },
  {
    "start": 2.13,
    "end": 4.26,
    "text": "terasa berat dan kamu"
  },
  {
    "start": 4.26,
    "end": 6.39,
    "text": "terus memutar ulang kejadian"
  },
  {
    "start": 6.39,
    "end": 8.52,
    "text": "yang sebenarnya sudah lewat berjam-jam yang lalu."
  },
  {
    "start": 9.17,
    "end": 12.63,
    "text": "Tarik nafas perlahan Kawan, hembuskan pelan-pelan."
  },
  {
    "start": 13.2,
    "end": 15.68,
    "text": "Biar kuberi tahu satu rahasia sederhana."
  },
  {
    "start": 16.27,
    "end": 18.13,
    "text": "Kamu merasa lelah bukan"
  },
  {
    "start": 18.13,
    "end": 19.99,
    "text": "karena hidupmu seberat itu,"
  },
  {
    "start": 19.99,
    "end": 21.84,
    "text": "tapi karena kamu memaksakan"
  },
  {
    "start": 21.84,
    "end": 23.7,
    "text": "diri memikul hal-hal yang"
  },
  {
    "start": 23.7,
    "end": 25.56,
    "text": "dari awal memang bukan kuasamu."
  },
  {
    "start": 26.15,
    "end": 27.62,
    "text": "Orang bijak zaman"
  },
  {
    "start": 27.62,
    "end": 29.09,
    "text": "dulu membagi beban"
  },
  {
    "start": 29.09,
    "end": 30.56,
    "text": "hidup menjadi dua bagian sederhana."
  },
  {
    "start": 31.02,
    "end": 32.99,
    "text": "Bagian pertama adalah hal-hal"
  },
  {
    "start": 32.99,
    "end": 34.95,
    "text": "di luar kendalimu, opini"
  },
  {
    "start": 34.95,
    "end": 36.92,
    "text": "orang lain tentang dirimu,"
  },
  {
    "start": 36.92,
    "end": 38.88,
    "text": "komentar sinis mereka dan"
  },
  {
    "start": 38.88,
    "end": 40.85,
    "text": "masa lalu yang sudah terjadi."
  },
  {
    "start": 41.34,
    "end": 42.66,
    "text": "Itu bukan tugasmu Kawan."
  },
  {
    "start": 43.14,
    "end": 44.68,
    "text": "Kamu tidak bisa memaksa"
  },
  {
    "start": 44.68,
    "end": 46.22,
    "text": "semua orang untuk menyukaimu."
  },
  {
    "start": 46.73,
    "end": 49.37,
    "text": "Malam ini pelan-pelan lepaskan."
  },
  {
    "start": 50.14,
    "end": 52.33,
    "text": "Lalu, bagian kedua adalah hal-hal"
  },
  {
    "start": 52.33,
    "end": 54.51,
    "text": "yang sepenuhnya ada di tanganmu."
  },
  {
    "start": 54.89,
    "end": 57.08,
    "text": "Yaitu bagaimana caramu merespons keadaan,"
  },
  {
    "start": 57.08,
    "end": 59.27,
    "text": "caramu menjaga diri sendiri dan"
  },
  {
    "start": 59.27,
    "end": 61.47,
    "text": "apa yang ingin kamu lakukan"
  },
  {
    "start": 61.47,
    "end": 63.66,
    "text": "esok pagi saat membuka mata."
  },
  {
    "start": 64.19,
    "end": 66.5,
    "text": "Fokuskan energimu di situ saja."
  },
  {
    "start": 66.97,
    "end": 68.66,
    "text": "Jangan biarkan ombak riuh"
  },
  {
    "start": 68.66,
    "end": 70.34,
    "text": "di luar sana menenggelamkan"
  },
  {
    "start": 70.34,
    "end": 72.03,
    "text": "perahu ketenangan di dalam hatimu."
  },
  {
    "start": 72.53,
    "end": 74.53,
    "text": "Maafkan harimu yang melelahkan"
  },
  {
    "start": 74.53,
    "end": 76.54,
    "text": "dan tidurlah dengan damai."
  }
]