[
  {
    "start": 0.0,
    "end": 1.96,
    "text": "Dunia ini dihuni oleh miliaran"
  },
  {
    "start": 1.96,
    "end": 4.58,
    "text": "manusia yang masing-masing dibentuk oleh"
  },
  {
    "start": 4.58,
    "end": 6.47,
    "text": "latar belakang keluarga,"
  },
  {
    "start": 6.47,
    "end": 7.84,
    "text": "luka masa kecil,"
  },
  {
    "start": 7.84,
    "end": 11.05,
    "text": "dan pengalaman hidup yang berbeda-beda."
  },
  {
    "start": 11.05,
    "end": 13.73,
    "text": "Sangat kekanak-kanakan jika kita menuntut"
  },
  {
    "start": 13.73,
    "end": 15.82,
    "text": "semua orang harus memiliki sudut"
  },
  {
    "start": 15.82,
    "end": 17.78,
    "text": "pandang dan cara berpikir yang"
  },
  {
    "start": 17.78,
    "end": 20.0,
    "text": "persis sama dengan kita."
  },
  {
    "start": 20.0,
    "end": 21.83,
    "text": "Saat kamu bertemu orang yang"
  },
  {
    "start": 21.83,
    "end": 23.86,
    "text": "tidak sependapat denganmu,"
  },
  {
    "start": 23.86,
    "end": 26.41,
    "text": "kamu tidak perlu memaksakan kebenaranmu"
  },
  {
    "start": 26.41,
    "end": 28.5,
    "text": "kepada mereka atau mencap mereka"
  },
  {
    "start": 28.5,
    "end": 29.54,
    "text": "bodoh."
  },
  {
    "start": 29.54,
    "end": 31.83,
    "text": "Orang yang bijak mampu mendengarkan"
  },
  {
    "start": 31.83,
    "end": 34.12,
    "text": "pandangan yang berbeda dengan penuh"
  },
  {
    "start": 34.12,
    "end": 35.23,
    "text": "rasa hormat,"
  },
  {
    "start": 35.23,
    "end": 37.91,
    "text": "tanpa harus mengorbankan prinsip hidupnya"
  },
  {
    "start": 37.91,
    "end": 39.08,
    "text": "sendiri."
  },
  {
    "start": 39.08,
    "end": 41.44,
    "text": "Kedewasaan berpikir adalah saat kamu"
  },
  {
    "start": 41.44,
    "end": 43.79,
    "text": "bisa hidup berdampingan secara damai"
  },
  {
    "start": 43.79,
    "end": 45.56,
    "text": "di tengah keberagaman,"
  },
  {
    "start": 45.56,
    "end": 48.04,
    "text": "tanpa perlu saling membenci."
  }
]