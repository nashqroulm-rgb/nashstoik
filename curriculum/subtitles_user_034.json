[
  {
    "start": 0.0,
    "end": 1.89,
    "text": "Niat untuk selalu menolong dan"
  },
  {
    "start": 1.89,
    "end": 4.47,
    "text": "meringankan beban sesama adalah perbuatan"
  },
  {
    "start": 4.47,
    "end": 6.23,
    "text": "yang sangat mulia."
  },
  {
    "start": 6.23,
    "end": 7.62,
    "text": "Tapi ingat kawan,"
  },
  {
    "start": 7.62,
    "end": 9.31,
    "text": "kamu tidak akan pernah bisa"
  },
  {
    "start": 9.31,
    "end": 11.14,
    "text": "menuangkan air dari teko yang"
  },
  {
    "start": 11.14,
    "end": 13.47,
    "text": "isinya sudah kosong kering."
  },
  {
    "start": 13.47,
    "end": 15.48,
    "text": "Banyak orang yang jiwanya hancur"
  },
  {
    "start": 15.48,
    "end": 17.12,
    "text": "dan kelelahan mental,"
  },
  {
    "start": 17.12,
    "end": 19.32,
    "text": "hanya karena mereka memaksakan diri"
  },
  {
    "start": 19.32,
    "end": 21.21,
    "text": "memikul masalah semua orang di"
  },
  {
    "start": 21.21,
    "end": 22.22,
    "text": "sekitarnya,"
  },
  {
    "start": 22.22,
    "end": 25.11,
    "text": "sampai lupa merawat dirinya sendiri."
  },
  {
    "start": 25.11,
    "end": 27.0,
    "text": "Menolonglah dengan tulus,"
  },
  {
    "start": 27.0,
    "end": 29.77,
    "text": "tapi ketahuilah batas kemampuanmu."
  },
  {
    "start": 29.77,
    "end": 31.72,
    "text": "Kamu bisa memberi nasihat,"
  },
  {
    "start": 31.72,
    "end": 33.92,
    "text": "kamu bisa meminjamkan telinga untuk"
  },
  {
    "start": 33.92,
    "end": 35.06,
    "text": "mendengarkan,"
  },
  {
    "start": 35.06,
    "end": 36.94,
    "text": "tapi kamu tidak bisa menjalani"
  },
  {
    "start": 36.94,
    "end": 39.65,
    "text": "hidup mereka menggantikan mereka."
  },
  {
    "start": 39.65,
    "end": 41.92,
    "text": "Jangan biarkan rasa empatimu berubah"
  },
  {
    "start": 41.92,
    "end": 44.5,
    "text": "menjadi beban yang menenggelamkan hidupmu"
  },
  {
    "start": 44.5,
    "end": 45.63,
    "text": "sendiri."
  },
  {
    "start": 45.63,
    "end": 47.89,
    "text": "Sayangi dirimu terlebih dahulu malam"
  },
  {
    "start": 47.89,
    "end": 48.46,
    "text": "ini,"
  },
  {
    "start": 48.46,
    "end": 50.1,
    "text": "agar besok pagi kamu punya"
  },
  {
    "start": 50.1,
    "end": 52.05,
    "text": "energi yang cukup untuk menebar"
  },
  {
    "start": 52.05,
    "end": 54.13,
    "text": "kebaikan kepada sesama."
  }
]