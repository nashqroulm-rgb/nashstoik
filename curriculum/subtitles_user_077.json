[
  {
    "start": 0.0,
    "end": 2.02,
    "text": "Sebelas pekan telah kita lalui"
  },
  {
    "start": 2.02,
    "end": 5.44,
    "text": "bersama menelusuri jalan ketenangan jiwa."
  },
  {
    "start": 5.44,
    "end": 7.19,
    "text": "Kini kamu tahu bahwa badai"
  },
  {
    "start": 7.19,
    "end": 9.34,
    "text": "hidup tidak akan pernah berhenti"
  },
  {
    "start": 9.34,
    "end": 11.49,
    "text": "datang silih berganti."
  },
  {
    "start": 11.49,
    "end": 13.24,
    "text": "Tapi kamu tidak lagi takut"
  },
  {
    "start": 13.24,
    "end": 14.59,
    "text": "pada badai itu,"
  },
  {
    "start": 14.59,
    "end": 16.94,
    "text": "karena kamu sudah menemukan jangkar"
  },
  {
    "start": 16.94,
    "end": 19.9,
    "text": "kedamaian di dalam dadamu sendiri."
  },
  {
    "start": 19.9,
    "end": 22.85,
    "text": "Ketenangan hakiki bukanlah ketiadaan masalah"
  },
  {
    "start": 22.85,
    "end": 24.6,
    "text": "di sekelilingmu."
  },
  {
    "start": 24.6,
    "end": 27.42,
    "text": "Ketenangan hakiki adalah keteguhan batinmu"
  },
  {
    "start": 27.42,
    "end": 29.64,
    "text": "yang tetap damai dan jernih,"
  },
  {
    "start": 29.64,
    "end": 31.93,
    "text": "bahkan di tengah riuhnya kekacauan"
  },
  {
    "start": 31.93,
    "end": 33.0,
    "text": "dunia."
  },
  {
    "start": 33.0,
    "end": 35.56,
    "text": "Hargai setiap langkah dan perjuanganmu"
  },
  {
    "start": 35.56,
    "end": 37.78,
    "text": "hingga malam ini kawan."
  },
  {
    "start": 37.78,
    "end": 39.66,
    "text": "Kamu adalah bukti hidup dari"
  },
  {
    "start": 39.66,
    "end": 42.95,
    "text": "ketahanan dan keanggunan batin manusia."
  },
  {
    "start": 42.95,
    "end": 43.96,
    "text": "Malam ini,"
  },
  {
    "start": 43.96,
    "end": 47.32,
    "text": "tidurlah dalam pelukan kedamaian jiwamu."
  },
  {
    "start": 47.32,
    "end": 49.47,
    "text": "Esok fajar baru akan menyambutmu"
  },
  {
    "start": 49.47,
    "end": 51.49,
    "text": "dengan penuh berkah."
  }
]