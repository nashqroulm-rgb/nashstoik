[
  {
    "start": 0.0,
    "end": 2.12,
    "text": "Menyimpan rasa benci dan dendam"
  },
  {
    "start": 2.12,
    "end": 4.45,
    "text": "pada orang yang pernah menyakitimu"
  },
  {
    "start": 4.45,
    "end": 6.64,
    "text": "itu seperti meminum racun setiap"
  },
  {
    "start": 6.64,
    "end": 7.32,
    "text": "hari,"
  },
  {
    "start": 7.32,
    "end": 9.31,
    "text": "tapi berharap orang lain yang"
  },
  {
    "start": 9.31,
    "end": 11.02,
    "text": "mati karenanya."
  },
  {
    "start": 11.02,
    "end": 13.0,
    "text": "Orang yang kamu benci mungkin"
  },
  {
    "start": 13.0,
    "end": 14.99,
    "text": "saat ini sedang tidur nyenyak"
  },
  {
    "start": 14.99,
    "end": 16.15,
    "text": "di rumahnya,"
  },
  {
    "start": 16.15,
    "end": 17.25,
    "text": "makan enak,"
  },
  {
    "start": 17.25,
    "end": 20.33,
    "text": "dan sama sekali tidak memikirkanmu."
  },
  {
    "start": 20.33,
    "end": 23.61,
    "text": "Sementara kamu menghabiskan malam-malammu dengan"
  },
  {
    "start": 23.61,
    "end": 25.39,
    "text": "dada yang panas dan kepala"
  },
  {
    "start": 25.39,
    "end": 27.03,
    "text": "yang mendidih."
  },
  {
    "start": 27.03,
    "end": 29.77,
    "text": "Memaafkan bukan berarti kamu membenarkan"
  },
  {
    "start": 29.77,
    "end": 32.65,
    "text": "perbuatan buruk mereka kepadamu."
  },
  {
    "start": 32.65,
    "end": 35.25,
    "text": "Memaafkan adalah keputusan tegas untuk"
  },
  {
    "start": 35.25,
    "end": 37.64,
    "text": "melepaskan belenggu rasa sakit dari"
  },
  {
    "start": 37.64,
    "end": 39.35,
    "text": "hatimu sendiri."
  },
  {
    "start": 39.35,
    "end": 41.95,
    "text": "Kamu memaafkan bukan demi mereka,"
  },
  {
    "start": 41.95,
    "end": 44.21,
    "text": "tapi demi kedamaian dan kesehatan"
  },
  {
    "start": 44.21,
    "end": 45.92,
    "text": "jiwamu sendiri."
  },
  {
    "start": 45.92,
    "end": 46.95,
    "text": "Malam ini,"
  },
  {
    "start": 46.95,
    "end": 49.89,
    "text": "putuskan rantai dendam itu kawan."
  },
  {
    "start": 49.89,
    "end": 51.74,
    "text": "Buang racun itu keluar dari"
  },
  {
    "start": 51.74,
    "end": 52.56,
    "text": "dadamu,"
  },
  {
    "start": 52.56,
    "end": 54.82,
    "text": "dan biarkan hatimu kembali ringan"
  },
  {
    "start": 54.82,
    "end": 56.19,
    "text": "melangkah."
  }
]