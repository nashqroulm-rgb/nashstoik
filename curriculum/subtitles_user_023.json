[
  {
    "start": 0.0,
    "end": 1.52,
    "text": "Kita ini hidup di zaman"
  },
  {
    "start": 1.52,
    "end": 4.23,
    "text": "serba mudah dan serba instan."
  },
  {
    "start": 4.23,
    "end": 6.15,
    "text": "Mau makan tinggal pesan lewat"
  },
  {
    "start": 6.15,
    "end": 6.95,
    "text": "layar,"
  },
  {
    "start": 6.95,
    "end": 9.39,
    "text": "mau dingin tinggal nyalakan pendingin"
  },
  {
    "start": 9.39,
    "end": 10.32,
    "text": "ruangan,"
  },
  {
    "start": 10.32,
    "end": 13.16,
    "text": "mau hiburan tinggal geser jari."
  },
  {
    "start": 13.16,
    "end": 15.08,
    "text": "Tapi tanpa kita sadari,"
  },
  {
    "start": 15.08,
    "end": 18.06,
    "text": "kenyamanan yang berlebihan seringkali membuat"
  },
  {
    "start": 18.06,
    "end": 19.98,
    "text": "mental kita menjadi manja dan"
  },
  {
    "start": 19.98,
    "end": 21.63,
    "text": "sangat rapuh."
  },
  {
    "start": 21.63,
    "end": 23.55,
    "text": "Sedikit saja ada kendala atau"
  },
  {
    "start": 23.55,
    "end": 24.67,
    "text": "rasa lapar,"
  },
  {
    "start": 24.67,
    "end": 26.86,
    "text": "kita langsung mengeluh dan merasa"
  },
  {
    "start": 26.86,
    "end": 28.31,
    "text": "menderita."
  },
  {
    "start": 28.31,
    "end": 30.69,
    "text": "Orang-orang bijak zaman dulu sengaja"
  },
  {
    "start": 30.69,
    "end": 33.47,
    "text": "melatih diri mereka dengan ketidaknyamanan"
  },
  {
    "start": 33.47,
    "end": 35.66,
    "text": "kecil secara berkala."
  },
  {
    "start": 35.66,
    "end": 38.1,
    "text": "Menahan diri dari makanan enak,"
  },
  {
    "start": 38.1,
    "end": 39.96,
    "text": "berjalan kaki di bawah terik"
  },
  {
    "start": 39.96,
    "end": 40.88,
    "text": "mentari,"
  },
  {
    "start": 40.88,
    "end": 43.59,
    "text": "atau mandi dengan air dingin."
  },
  {
    "start": 43.59,
    "end": 46.24,
    "text": "Bukan untuk menyiksa diri sendiri,"
  },
  {
    "start": 46.24,
    "end": 48.62,
    "text": "tapi untuk mengingatkan batin mereka"
  },
  {
    "start": 48.62,
    "end": 50.74,
    "text": "bahwa manusia bisa tetap bahagia"
  },
  {
    "start": 50.74,
    "end": 52.59,
    "text": "dan utuh meski dalam kondisi"
  },
  {
    "start": 52.59,
    "end": 54.44,
    "text": "serba sederhana."
  },
  {
    "start": 54.44,
    "end": 56.63,
    "text": "Jangan takut pada kesulitan kecil"
  },
  {
    "start": 56.63,
    "end": 58.94,
    "text": "dalam hidupmu hari ini."
  },
  {
    "start": 58.94,
    "end": 60.93,
    "text": "Setiap tetes keringat dan rasa"
  },
  {
    "start": 60.93,
    "end": 63.04,
    "text": "lelah sedang melatih jiwamu agar"
  },
  {
    "start": 63.04,
    "end": 65.03,
    "text": "tidak mudah tumbang saat badai"
  },
  {
    "start": 65.03,
    "end": 67.47,
    "text": "besar benar-benar datang."
  }
]