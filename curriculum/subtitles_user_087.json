[
  {
    "start": 0.0,
    "end": 2.56,
    "text": "Menunggu seringkali menjadi ujian paling"
  },
  {
    "start": 2.56,
    "end": 4.8,
    "text": "berat bagi ketahanan mental manusia"
  },
  {
    "start": 4.8,
    "end": 5.89,
    "text": "modern."
  },
  {
    "start": 5.89,
    "end": 8.06,
    "text": "Menunggu kabar lamaran kerja,"
  },
  {
    "start": 8.06,
    "end": 10.75,
    "text": "menunggu hasil pemeriksaan kesehatan,"
  },
  {
    "start": 10.75,
    "end": 12.8,
    "text": "atau menunggu balasan pesan dari"
  },
  {
    "start": 12.8,
    "end": 14.08,
    "text": "seseorang."
  },
  {
    "start": 14.08,
    "end": 16.26,
    "text": "Pikiran kita cenderung melayang ke"
  },
  {
    "start": 16.26,
    "end": 19.07,
    "text": "skenario terburuk yang menakutkan."
  },
  {
    "start": 19.07,
    "end": 20.41,
    "text": "Sadarilah kawan,"
  },
  {
    "start": 20.41,
    "end": 22.85,
    "text": "kegelisahanmu saat menunggu tidak akan"
  },
  {
    "start": 22.85,
    "end": 24.96,
    "text": "pernah bisa mempercepat jarum jam"
  },
  {
    "start": 24.96,
    "end": 27.39,
    "text": "berputar barang sedetik pun."
  },
  {
    "start": 27.39,
    "end": 29.5,
    "text": "Saat kamu sudah melakukan ikhtiar"
  },
  {
    "start": 29.5,
    "end": 30.46,
    "text": "terbaikmu,"
  },
  {
    "start": 30.46,
    "end": 32.38,
    "text": "masa tunggu adalah waktu untuk"
  },
  {
    "start": 32.38,
    "end": 35.33,
    "text": "menyerahkan hasilnya kepada semesta."
  },
  {
    "start": 35.33,
    "end": 37.76,
    "text": "Gunakan waktu menunggumu untuk hal-hal"
  },
  {
    "start": 37.76,
    "end": 40.25,
    "text": "yang bermanfaat bagi batinmu."
  },
  {
    "start": 40.25,
    "end": 41.41,
    "text": "Bacalah buku,"
  },
  {
    "start": 41.41,
    "end": 42.75,
    "text": "rawat tanamanmu,"
  },
  {
    "start": 42.75,
    "end": 45.25,
    "text": "atau nikmati heningnya malam."
  },
  {
    "start": 45.25,
    "end": 47.68,
    "text": "Ketenangan dalam menunggu adalah tanda"
  },
  {
    "start": 47.68,
    "end": 49.79,
    "text": "jiwa yang sudah matang."
  }
]