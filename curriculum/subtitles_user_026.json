[
  {
    "start": 0.0,
    "end": 1.91,
    "text": "Kita sering mengira bahwa untuk"
  },
  {
    "start": 1.91,
    "end": 3.2,
    "text": "merasa bahagia,"
  },
  {
    "start": 3.2,
    "end": 5.23,
    "text": "kita harus menunggu liburan mewah"
  },
  {
    "start": 5.23,
    "end": 6.96,
    "text": "ke luar negeri atau mencapai"
  },
  {
    "start": 6.96,
    "end": 9.24,
    "text": "target uang ratusan juta."
  },
  {
    "start": 9.24,
    "end": 12.25,
    "text": "Padahal kebahagiaan sejati seringkali bersembunyi"
  },
  {
    "start": 12.25,
    "end": 13.85,
    "text": "di balik hal-hal kecil dan"
  },
  {
    "start": 13.85,
    "end": 15.52,
    "text": "gratis di sekitar kita yang"
  },
  {
    "start": 15.52,
    "end": 18.16,
    "text": "sering kita lewati begitu saja."
  },
  {
    "start": 18.16,
    "end": 20.19,
    "text": "Hangatnya sinar mentari pagi yang"
  },
  {
    "start": 20.19,
    "end": 21.61,
    "text": "mengenai kulitmu,"
  },
  {
    "start": 21.61,
    "end": 23.33,
    "text": "segelas air putih sejuk yang"
  },
  {
    "start": 23.33,
    "end": 25.8,
    "text": "membasahi tenggorokanmu saat haus,"
  },
  {
    "start": 25.8,
    "end": 27.34,
    "text": "tawa renyah anak kecil di"
  },
  {
    "start": 27.34,
    "end": 28.32,
    "text": "sore hari,"
  },
  {
    "start": 28.32,
    "end": 30.54,
    "text": "atau obrolan santai bersama keluarga"
  },
  {
    "start": 30.54,
    "end": 32.26,
    "text": "di ruang tengah."
  },
  {
    "start": 32.26,
    "end": 34.72,
    "text": "Hal-hal sederhana itulah yang sebenarnya"
  },
  {
    "start": 34.72,
    "end": 37.0,
    "text": "menjaga kewarasan dan keindahan hidup"
  },
  {
    "start": 37.0,
    "end": 38.05,
    "text": "kita."
  },
  {
    "start": 38.05,
    "end": 39.34,
    "text": "Mulai hari ini,"
  },
  {
    "start": 39.34,
    "end": 41.44,
    "text": "latih matamu untuk melihat kembali"
  },
  {
    "start": 41.44,
    "end": 44.02,
    "text": "keajaiban-keajaiban kecil itu."
  },
  {
    "start": 44.02,
    "end": 46.24,
    "text": "Jangan biarkan pikiranmu yang selalu"
  },
  {
    "start": 46.24,
    "end": 48.27,
    "text": "mengejar hal besar membuatmu buta"
  },
  {
    "start": 48.27,
    "end": 50.42,
    "text": "terhadap berkah melimpah yang sudah"
  },
  {
    "start": 50.42,
    "end": 52.27,
    "text": "ada di pangkuanmu."
  },
  {
    "start": 52.27,
    "end": 54.43,
    "text": "Tersenyumlah malam ini."
  },
  {
    "start": 54.43,
    "end": 56.64,
    "text": "Hidupmu sebenarnya sudah sangat kaya"
  },
  {
    "start": 56.64,
    "end": 58.49,
    "text": "dengan hal-hal baik yang patut"
  },
  {
    "start": 58.49,
    "end": 60.03,
    "text": "kamu syukuri."
  }
]