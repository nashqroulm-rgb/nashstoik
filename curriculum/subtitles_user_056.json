[
  {
    "start": 0.0,
    "end": 1.71,
    "text": "Malam ini genap lima puluh"
  },
  {
    "start": 1.71,
    "end": 3.88,
    "text": "enam hari perjalanan kita melatih"
  },
  {
    "start": 3.88,
    "end": 6.19,
    "text": "ilmu ketenangan hidup dan ketahanan"
  },
  {
    "start": 6.19,
    "end": 7.18,
    "text": "jiwa."
  },
  {
    "start": 7.18,
    "end": 9.15,
    "text": "Dua bulan penuh kita melangkah"
  },
  {
    "start": 9.15,
    "end": 11.13,
    "text": "bersama setiap hari."
  },
  {
    "start": 11.13,
    "end": 13.36,
    "text": "Coba rasakan perbedaannya di dalam"
  },
  {
    "start": 13.36,
    "end": 15.08,
    "text": "dadamu sekarang."
  },
  {
    "start": 15.08,
    "end": 17.31,
    "text": "Ketenangan batin yang kamu rasakan"
  },
  {
    "start": 17.31,
    "end": 19.88,
    "text": "malam ini bukanlah kebetulan."
  },
  {
    "start": 19.88,
    "end": 21.59,
    "text": "Itu adalah buah manis dari"
  },
  {
    "start": 21.59,
    "end": 24.29,
    "text": "kesabaranmu melatih pikiranmu setiap hari"
  },
  {
    "start": 24.29,
    "end": 26.13,
    "text": "untuk tidak mudah goyah oleh"
  },
  {
    "start": 26.13,
    "end": 27.91,
    "text": "badai dunia luar."
  },
  {
    "start": 27.91,
    "end": 30.41,
    "text": "Kamu sudah membuktikan bahwa kedamaian"
  },
  {
    "start": 30.41,
    "end": 32.19,
    "text": "sejati bukanlah ilusi,"
  },
  {
    "start": 32.19,
    "end": 34.49,
    "text": "melainkan sebuah benteng kokoh yang"
  },
  {
    "start": 34.49,
    "end": 36.27,
    "text": "bisa kamu bangun sendiri di"
  },
  {
    "start": 36.27,
    "end": 37.79,
    "text": "dalam dadamu."
  },
  {
    "start": 37.79,
    "end": 40.42,
    "text": "Perjalanan ini belum selesai kawan,"
  },
  {
    "start": 40.42,
    "end": 42.07,
    "text": "tapi kamu sudah berada di"
  },
  {
    "start": 42.07,
    "end": 44.3,
    "text": "jalur yang sangat benar."
  },
  {
    "start": 44.3,
    "end": 46.61,
    "text": "Tarik napas dalam-dalam dengan rasa"
  },
  {
    "start": 46.61,
    "end": 48.52,
    "text": "syukur yang meluap."
  },
  {
    "start": 48.52,
    "end": 50.69,
    "text": "Terima kasih sudah setia berjuang"
  },
  {
    "start": 50.69,
    "end": 51.87,
    "text": "bersama."
  },
  {
    "start": 51.87,
    "end": 54.31,
    "text": "Tidurlah dengan damai malam ini,"
  },
  {
    "start": 54.31,
    "end": 56.35,
    "text": "esok fajar baru menanti langkah"
  },
  {
    "start": 56.35,
    "end": 57.47,
    "text": "kakimu."
  }
]