[
  {
    "start": 0.0,
    "end": 1.96,
    "text": "Harapan adalah hal yang indah"
  },
  {
    "start": 1.96,
    "end": 4.34,
    "text": "untuk memotivasi langkah kita,"
  },
  {
    "start": 4.34,
    "end": 6.57,
    "text": "tapi harapan yang tidak realistis"
  },
  {
    "start": 6.57,
    "end": 9.69,
    "text": "seringkali menjadi sumber penderitaan terbesar"
  },
  {
    "start": 9.69,
    "end": 11.58,
    "text": "bagi hati manusia."
  },
  {
    "start": 11.58,
    "end": 13.68,
    "text": "Kita sering berharap orang lain"
  },
  {
    "start": 13.68,
    "end": 15.92,
    "text": "akan berubah menjadi seperti yang"
  },
  {
    "start": 15.92,
    "end": 17.21,
    "text": "kita inginkan,"
  },
  {
    "start": 17.21,
    "end": 19.24,
    "text": "berharap hidup ini selalu adil"
  },
  {
    "start": 19.24,
    "end": 20.53,
    "text": "tanpa masalah,"
  },
  {
    "start": 20.53,
    "end": 22.56,
    "text": "atau berharap kerja keras kita"
  },
  {
    "start": 22.56,
    "end": 24.86,
    "text": "langsung berbuah instan."
  },
  {
    "start": 24.86,
    "end": 27.17,
    "text": "Ketika harapan muluk itu membentur"
  },
  {
    "start": 27.17,
    "end": 28.18,
    "text": "kenyataan,"
  },
  {
    "start": 28.18,
    "end": 30.35,
    "text": "kita jatuh terpuruk dalam jurang"
  },
  {
    "start": 30.35,
    "end": 32.52,
    "text": "kekecewaan yang dalam."
  },
  {
    "start": 32.52,
    "end": 35.02,
    "text": "Tarik napas perlahan kawan."
  },
  {
    "start": 35.02,
    "end": 37.4,
    "text": "Hiduplah berakar pada kenyataan apa"
  },
  {
    "start": 37.4,
    "end": 38.21,
    "text": "adanya,"
  },
  {
    "start": 38.21,
    "end": 40.99,
    "text": "bukan pada khayalan yang rapuh."
  },
  {
    "start": 40.99,
    "end": 43.76,
    "text": "Berusahalah sebaik mungkin dengan segenap"
  },
  {
    "start": 43.76,
    "end": 44.58,
    "text": "dayamu,"
  },
  {
    "start": 44.58,
    "end": 47.08,
    "text": "tapi lepaskan keterikatan hatimu pada"
  },
  {
    "start": 47.08,
    "end": 49.59,
    "text": "hasil yang di luar kuasamu."
  },
  {
    "start": 49.59,
    "end": 51.62,
    "text": "Saat kamu tidak menuntut dunia"
  },
  {
    "start": 51.62,
    "end": 53.45,
    "text": "harus selalu sempurna,"
  },
  {
    "start": 53.45,
    "end": 55.75,
    "text": "kamu akan menemukan kedamaian yang"
  },
  {
    "start": 55.75,
    "end": 58.26,
    "text": "sejati di dalam ketidaksempurnaan itu"
  },
  {
    "start": 58.26,
    "end": 59.48,
    "text": "sendiri."
  }
]