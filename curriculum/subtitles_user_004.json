[
  {
    "start": 0.0,
    "end": 2.07,
    "text": "Sakit hati memang kalau"
  },
  {
    "start": 2.07,
    "end": 4.14,
    "text": "mendengar orang meremehkan usahamu,"
  },
  {
    "start": 4.14,
    "end": 6.15,
    "text": "apalagi kalau yang berbicara"
  },
  {
    "start": 6.15,
    "end": 8.16,
    "text": "orang yang kamu kenal dekat."
  },
  {
    "start": 8.16,
    "end": 10.86,
    "text": "Rasanya ingin marah, ingin membalas,"
  },
  {
    "start": 10.86,
    "end": 13.56,
    "text": "dan membuktikan kalau mereka salah."
  },
  {
    "start": 13.56,
    "end": 16.24,
    "text": "Tapi coba pikir lagi Kawan."
  },
  {
    "start": 16.24,
    "end": 18.28,
    "text": "Sepadan tidak energimu dipakai"
  },
  {
    "start": 18.28,
    "end": 20.32,
    "text": "untuk meladeni itu semua?"
  },
  {
    "start": 20.32,
    "end": 22.42,
    "text": "Orang yang suka merendahkan"
  },
  {
    "start": 22.42,
    "end": 24.52,
    "text": "orang lain sebenarnya cuma"
  },
  {
    "start": 24.52,
    "end": 26.62,
    "text": "sedang menunjukkan betapa gelisah"
  },
  {
    "start": 26.62,
    "end": 28.72,
    "text": "dan sempitnya isi hati mereka sendiri."
  },
  {
    "start": 28.72,
    "end": 30.46,
    "text": "Orang yang hatinya damai,"
  },
  {
    "start": 30.46,
    "end": 32.2,
    "text": "tidak akan pernah punya"
  },
  {
    "start": 32.2,
    "end": 33.94,
    "text": "waktu untuk menginjak orang lain."
  },
  {
    "start": 33.94,
    "end": 35.79,
    "text": "Jadi, saat mereka"
  },
  {
    "start": 35.79,
    "end": 37.65,
    "text": "melempar kata-kata pedas,"
  },
  {
    "start": 37.65,
    "end": 39.5,
    "text": "ingat satu hal sederhana ini."
  },
  {
    "start": 39.5,
    "end": 41.27,
    "text": "Kamu punya pilihan untuk"
  },
  {
    "start": 41.27,
    "end": 43.03,
    "text": "menangkapnya ke dalam hati"
  },
  {
    "start": 43.03,
    "end": 44.8,
    "text": "atau membiarkannya jatuh ke tanah."
  },
  {
    "start": 44.8,
    "end": 46.72,
    "text": "Kalau kamu marah dan"
  },
  {
    "start": 46.72,
    "end": 48.64,
    "text": "kepikiran seharian, berarti kamu"
  },
  {
    "start": 48.64,
    "end": 50.56,
    "text": "baru saja menyerahkan kunci"
  },
  {
    "start": 50.56,
    "end": 52.48,
    "text": "ketenanganmu ke tangan mereka."
  },
  {
    "start": 52.48,
    "end": 54.58,
    "text": "Jangan biarkan orang yang"
  },
  {
    "start": 54.58,
    "end": 56.68,
    "text": "perilakunya buruk mengatur suasana hatimu."
  },
  {
    "start": 56.68,
    "end": 59.98,
    "text": "Tersenyumlah, lepaskan beban itu,"
  },
  {
    "start": 59.98,
    "end": 61.84,
    "text": "lalu lanjutkan hidupmu."
  },
  {
    "start": 61.84,
    "end": 63.95,
    "text": "Ketenangan hatimu jauh lebih"
  },
  {
    "start": 63.95,
    "end": 66.05,
    "text": "berharga daripada memenangkan perdebatan"
  },
  {
    "start": 66.05,
    "end": 68.16,
    "text": "yang tidak ada gunanya."
  }
]