[
  {
    "start": 0.0,
    "end": 1.81,
    "text": "Wajar sekali kalau kamu merasa"
  },
  {
    "start": 1.81,
    "end": 3.45,
    "text": "terluka saat ada orang yang"
  },
  {
    "start": 3.45,
    "end": 6.04,
    "text": "sengaja mencari-cari kesalahanmu."
  },
  {
    "start": 6.04,
    "end": 7.92,
    "text": "Tapi sebelum kamu terbawa emosi"
  },
  {
    "start": 7.92,
    "end": 9.61,
    "text": "dan sibuk membela diri,"
  },
  {
    "start": 9.61,
    "end": 11.61,
    "text": "coba renungkan satu hal sederhana"
  },
  {
    "start": 11.61,
    "end": 12.45,
    "text": "ini."
  },
  {
    "start": 12.45,
    "end": 14.02,
    "text": "Kritik dari orang lain itu"
  },
  {
    "start": 14.02,
    "end": 15.47,
    "text": "ada dua jenis."
  },
  {
    "start": 15.47,
    "end": 17.11,
    "text": "Kalau kritiknya benar,"
  },
  {
    "start": 17.11,
    "end": 18.86,
    "text": "anggap saja itu cermin gratis"
  },
  {
    "start": 18.86,
    "end": 20.98,
    "text": "untuk memperbaiki dirimu."
  },
  {
    "start": 20.98,
    "end": 22.79,
    "text": "Mengapa harus marah pada orang"
  },
  {
    "start": 22.79,
    "end": 24.66,
    "text": "yang menunjukkan ada kotoran di"
  },
  {
    "start": 24.66,
    "end": 25.75,
    "text": "wajahmu?"
  },
  {
    "start": 25.75,
    "end": 27.68,
    "text": "Tapi kalau kritiknya cuma fitnah"
  },
  {
    "start": 27.68,
    "end": 29.01,
    "text": "dan omong kosong,"
  },
  {
    "start": 29.01,
    "end": 31.07,
    "text": "buat apa kamu pusingkan?"
  },
  {
    "start": 31.07,
    "end": 33.19,
    "text": "Kebohongan mereka tidak akan pernah"
  },
  {
    "start": 33.19,
    "end": 36.09,
    "text": "mengubah siapa dirimu yang sebenarnya."
  },
  {
    "start": 36.09,
    "end": 38.02,
    "text": "Orang yang batinnya matang tidak"
  },
  {
    "start": 38.02,
    "end": 39.77,
    "text": "mudah goyah oleh pujian,"
  },
  {
    "start": 39.77,
    "end": 42.13,
    "text": "dan tidak runtuh oleh celaan."
  },
  {
    "start": 42.13,
    "end": 43.88,
    "text": "Mereka tahu nilai diri mereka"
  },
  {
    "start": 43.88,
    "end": 44.97,
    "text": "sendiri."
  },
  {
    "start": 44.97,
    "end": 47.39,
    "text": "Tarik napas dalam-dalam kawan."
  },
  {
    "start": 47.39,
    "end": 49.51,
    "text": "Jadikan setiap kritik sebagai bahan"
  },
  {
    "start": 49.51,
    "end": 52.29,
    "text": "bakar untuk memperbaiki kualitas hidupmu,"
  },
  {
    "start": 52.29,
    "end": 55.25,
    "text": "lalu lanjutkan langkahmu dengan tenang."
  }
]