[
  {
    "start": 0.0,
    "end": 2.62,
    "text": "Ketika seseorang melontarkan kritik pedas"
  },
  {
    "start": 2.62,
    "end": 3.51,
    "text": "kepadamu,"
  },
  {
    "start": 3.51,
    "end": 6.13,
    "text": "reaksi pertamamu seringkali ingin membela"
  },
  {
    "start": 6.13,
    "end": 8.75,
    "text": "diri dengan emosi yang menyala."
  },
  {
    "start": 8.75,
    "end": 11.44,
    "text": "Tapi tahan dirimu sejenak kawan."
  },
  {
    "start": 11.44,
    "end": 13.48,
    "text": "Jadilah penilai yang tenang atas"
  },
  {
    "start": 13.48,
    "end": 15.21,
    "text": "kata-kata mereka."
  },
  {
    "start": 15.21,
    "end": 17.51,
    "text": "Jika kritikan itu memang benar,"
  },
  {
    "start": 17.51,
    "end": 19.62,
    "text": "maka anggaplah itu sebagai cermin"
  },
  {
    "start": 19.62,
    "end": 21.6,
    "text": "gratis yang menunjukkan noda di"
  },
  {
    "start": 21.6,
    "end": 23.45,
    "text": "wajahmu agar kamu bisa segera"
  },
  {
    "start": 23.45,
    "end": 24.86,
    "text": "membasuhnya."
  },
  {
    "start": 24.86,
    "end": 26.71,
    "text": "Namun jika kritikan itu lahir"
  },
  {
    "start": 26.71,
    "end": 29.39,
    "text": "dari kebencian dan kebohongan belaka,"
  },
  {
    "start": 29.39,
    "end": 31.31,
    "text": "maka kata-kata itu sama sekali"
  },
  {
    "start": 31.31,
    "end": 33.67,
    "text": "tidak ada hubungannya dengan kualitas"
  },
  {
    "start": 33.67,
    "end": 34.76,
    "text": "dirimu."
  },
  {
    "start": 34.76,
    "end": 36.74,
    "text": "Itu hanyalah cerminan dari hati"
  },
  {
    "start": 36.74,
    "end": 39.1,
    "text": "mereka yang sedang gelisah."
  },
  {
    "start": 39.1,
    "end": 41.4,
    "text": "Jangan biarkan racun kata-kata orang"
  },
  {
    "start": 41.4,
    "end": 43.58,
    "text": "lain masuk dan mengotori kemurnian"
  },
  {
    "start": 43.58,
    "end": 44.66,
    "text": "jiwamu."
  },
  {
    "start": 44.66,
    "end": 46.77,
    "text": "Ambil pelajarannya jika ada,"
  },
  {
    "start": 46.77,
    "end": 49.71,
    "text": "lalu lanjutkan harimu dengan tenang."
  }
]