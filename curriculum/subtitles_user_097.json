[
  {
    "start": 0.0,
    "end": 2.98,
    "text": "Membicarakan kematian seringkali dianggap hal"
  },
  {
    "start": 2.98,
    "end": 6.16,
    "text": "yang menakutkan bagi kebanyakan orang."
  },
  {
    "start": 6.16,
    "end": 8.54,
    "text": "Padahal orang-orang bijak zaman dulu"
  },
  {
    "start": 8.54,
    "end": 11.52,
    "text": "selalu merenungkan kematian setiap hari,"
  },
  {
    "start": 11.52,
    "end": 13.51,
    "text": "bukan untuk berputus asa,"
  },
  {
    "start": 13.51,
    "end": 16.23,
    "text": "melainkan untuk menyadarkan mereka betapa"
  },
  {
    "start": 16.23,
    "end": 18.68,
    "text": "berharganya setiap tarikan napas hari"
  },
  {
    "start": 18.68,
    "end": 19.61,
    "text": "ini."
  },
  {
    "start": 19.61,
    "end": 21.53,
    "text": "Kenyataan bahwa hidup kita di"
  },
  {
    "start": 21.53,
    "end": 23.31,
    "text": "dunia ini fana dan terbatas"
  },
  {
    "start": 23.31,
    "end": 25.3,
    "text": "adalah hal yang membuat setiap"
  },
  {
    "start": 25.3,
    "end": 26.69,
    "text": "detik pertemuan,"
  },
  {
    "start": 26.69,
    "end": 28.02,
    "text": "setiap pelukan,"
  },
  {
    "start": 28.02,
    "end": 30.27,
    "text": "dan setiap senyuman menjadi sangat"
  },
  {
    "start": 30.27,
    "end": 31.53,
    "text": "bernilai."
  },
  {
    "start": 31.53,
    "end": 33.25,
    "text": "Jika kamu ingat bahwa hari"
  },
  {
    "start": 33.25,
    "end": 34.97,
    "text": "ini bisa saja menjadi hari"
  },
  {
    "start": 34.97,
    "end": 36.03,
    "text": "terakhirmu,"
  },
  {
    "start": 36.03,
    "end": 37.95,
    "text": "kamu tidak akan lagi membuang"
  },
  {
    "start": 37.95,
    "end": 40.2,
    "text": "waktu untuk bertengkar tentang hal"
  },
  {
    "start": 40.2,
    "end": 43.12,
    "text": "sepele atau menyimpan dendam lama."
  },
  {
    "start": 43.12,
    "end": 45.11,
    "text": "Hiduplah hari ini dengan penuh"
  },
  {
    "start": 45.11,
    "end": 47.29,
    "text": "kesadaran dan kebaikan."
  },
  {
    "start": 47.29,
    "end": 49.61,
    "text": "Jadikan setiap harimu sebagai karya"
  },
  {
    "start": 49.61,
    "end": 52.19,
    "text": "seni yang indah dan bermakna."
  }
]