[
  {
    "start": 0.0,
    "end": 1.66,
    "text": "Rasa iri adalah api kecil"
  },
  {
    "start": 1.66,
    "end": 3.18,
    "text": "di dalam dada yang jika"
  },
  {
    "start": 3.18,
    "end": 5.63,
    "text": "dibiarkan akan membakar habis seluruh"
  },
  {
    "start": 5.63,
    "end": 7.76,
    "text": "kebahagiaanmu sendiri."
  },
  {
    "start": 7.76,
    "end": 9.74,
    "text": "Saat melihat orang lain meraih"
  },
  {
    "start": 9.74,
    "end": 10.81,
    "text": "kesuksesan,"
  },
  {
    "start": 10.81,
    "end": 13.26,
    "text": "refleks pertama sebagian orang adalah"
  },
  {
    "start": 13.26,
    "end": 16.51,
    "text": "mencari-cari kelemahannya atau menganggapnya cuma"
  },
  {
    "start": 16.51,
    "end": 18.3,
    "text": "beruntung belaka."
  },
  {
    "start": 18.3,
    "end": 19.69,
    "text": "Sadarilah kawan,"
  },
  {
    "start": 19.69,
    "end": 21.54,
    "text": "rezeki dan berkah orang lain"
  },
  {
    "start": 21.54,
    "end": 23.8,
    "text": "tidak akan pernah mengurangi jatah"
  },
  {
    "start": 23.8,
    "end": 25.92,
    "text": "rezekimu di dunia ini."
  },
  {
    "start": 25.92,
    "end": 27.97,
    "text": "Langit semesta ini terlalu luas"
  },
  {
    "start": 27.97,
    "end": 30.56,
    "text": "dan berlimpah untuk diperebutkan dengan"
  },
  {
    "start": 30.56,
    "end": 32.02,
    "text": "rasa dengki."
  },
  {
    "start": 32.02,
    "end": 34.01,
    "text": "Ketika kamu melihat orang lain"
  },
  {
    "start": 34.01,
    "end": 34.94,
    "text": "berhasil,"
  },
  {
    "start": 34.94,
    "end": 37.72,
    "text": "ikutlah berbahagia untuk mereka."
  },
  {
    "start": 37.72,
    "end": 39.91,
    "text": "Doakan kebaikan bagi mereka,"
  },
  {
    "start": 39.91,
    "end": 42.03,
    "text": "lalu kembali fokus menabur benih"
  },
  {
    "start": 42.03,
    "end": 44.55,
    "text": "kebaikan di kebunmu sendiri."
  },
  {
    "start": 44.55,
    "end": 46.54,
    "text": "Hati yang tulus ikut bersyukur"
  },
  {
    "start": 46.54,
    "end": 48.79,
    "text": "atas kebahagiaan orang lain adalah"
  },
  {
    "start": 48.79,
    "end": 50.78,
    "text": "hati yang sudah sangat merdeka"
  },
  {
    "start": 50.78,
    "end": 52.77,
    "text": "dan penuh kedamaian."
  }
]