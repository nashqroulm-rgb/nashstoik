[
  {
    "start": 0.0,
    "end": 2.0,
    "text": "Pernah tidak kamu merasa hidupmu"
  },
  {
    "start": 2.0,
    "end": 4.26,
    "text": "seperti sedang dihujani masalah dari"
  },
  {
    "start": 4.26,
    "end": 6.39,
    "text": "segala arah sekaligus?"
  },
  {
    "start": 6.39,
    "end": 7.95,
    "text": "Kerjaan bermasalah,"
  },
  {
    "start": 7.95,
    "end": 9.71,
    "text": "urusan keluarga rumit,"
  },
  {
    "start": 9.71,
    "end": 13.27,
    "text": "dan pengeluaran mendadak datang bertubi-tubi."
  },
  {
    "start": 13.27,
    "end": 15.03,
    "text": "Rasanya kepala mau pecah dan"
  },
  {
    "start": 15.03,
    "end": 17.72,
    "text": "ingin lari saja dari kenyataan."
  },
  {
    "start": 17.72,
    "end": 20.35,
    "text": "Tarik napas dalam-dalam kawan."
  },
  {
    "start": 20.35,
    "end": 22.35,
    "text": "Berhentilah sejenak."
  },
  {
    "start": 22.35,
    "end": 24.55,
    "text": "Kamu memang tidak bisa menghentikan"
  },
  {
    "start": 24.55,
    "end": 26.36,
    "text": "badai hujan yang sedang turun"
  },
  {
    "start": 26.36,
    "end": 27.93,
    "text": "di luar sana."
  },
  {
    "start": 27.93,
    "end": 29.81,
    "text": "Tapi kamu selalu punya kendali"
  },
  {
    "start": 29.81,
    "end": 31.93,
    "text": "penuh untuk memutuskan apakah kamu"
  },
  {
    "start": 31.93,
    "end": 33.94,
    "text": "mau berpayung dengan tenang atau"
  },
  {
    "start": 33.94,
    "end": 35.88,
    "text": "ikut berlari panik sambil basah"
  },
  {
    "start": 35.88,
    "end": 37.01,
    "text": "kuyup."
  },
  {
    "start": 37.01,
    "end": 38.7,
    "text": "Kekacauan di luar sana baru"
  },
  {
    "start": 38.7,
    "end": 40.64,
    "text": "akan menjadi bencana kalau kamu"
  },
  {
    "start": 40.64,
    "end": 42.77,
    "text": "membiarkan kekacauan itu masuk dan"
  },
  {
    "start": 42.77,
    "end": 45.71,
    "text": "merusak ketenangan di dalam dadamu."
  },
  {
    "start": 45.71,
    "end": 48.28,
    "text": "Tarik garis batas yang tegas."
  },
  {
    "start": 48.28,
    "end": 50.59,
    "text": "Hadapi masalahmu satu per satu,"
  },
  {
    "start": 50.59,
    "end": 52.54,
    "text": "mulai dari yang paling mendesak"
  },
  {
    "start": 52.54,
    "end": 54.48,
    "text": "dan paling bisa kamu selesaikan"
  },
  {
    "start": 54.48,
    "end": 55.79,
    "text": "hari ini."
  },
  {
    "start": 55.79,
    "end": 57.55,
    "text": "Jangan biarkan badai di luar"
  },
  {
    "start": 57.55,
    "end": 60.17,
    "text": "menenggelamkan perahu batinmu."
  },
  {
    "start": 60.17,
    "end": 61.55,
    "text": "Tetaplah tenang,"
  },
  {
    "start": 61.55,
    "end": 63.87,
    "text": "badai pasti akan berlalu."
  }
]