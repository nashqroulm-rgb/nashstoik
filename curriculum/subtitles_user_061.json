[
  {
    "start": 0.0,
    "end": 1.8,
    "text": "Di mana tempat yang paling"
  },
  {
    "start": 1.8,
    "end": 3.94,
    "text": "membuatmu merasa aman dan damai"
  },
  {
    "start": 3.94,
    "end": 7.12,
    "text": "saat seluruh dunia terasa menekanmu?"
  },
  {
    "start": 7.12,
    "end": 9.19,
    "text": "Jika kamu tidak memiliki sudut"
  },
  {
    "start": 9.19,
    "end": 10.85,
    "text": "kecil di rumahmu atau di"
  },
  {
    "start": 10.85,
    "end": 13.54,
    "text": "dalam batinmu untuk melepas lelah,"
  },
  {
    "start": 13.54,
    "end": 16.24,
    "text": "hidupmu akan terasa seperti pertempuran"
  },
  {
    "start": 16.24,
    "end": 17.76,
    "text": "tanpa henti."
  },
  {
    "start": 17.76,
    "end": 18.79,
    "text": "Malam ini,"
  },
  {
    "start": 18.79,
    "end": 21.14,
    "text": "ciptakan sebuah sudut sederhana di"
  },
  {
    "start": 21.14,
    "end": 23.49,
    "text": "kamarmu yang bebas dari kebisingan"
  },
  {
    "start": 23.49,
    "end": 24.6,
    "text": "gawai."
  },
  {
    "start": 24.6,
    "end": 27.09,
    "text": "Cukup sebuah kursi yang nyaman,"
  },
  {
    "start": 27.09,
    "end": 29.23,
    "text": "cahaya lampu yang temaram,"
  },
  {
    "start": 29.23,
    "end": 32.27,
    "text": "dan hembusan napasmu yang teratur."
  },
  {
    "start": 32.27,
    "end": 34.41,
    "text": "Jadikan ruang kecil itu sebagai"
  },
  {
    "start": 34.41,
    "end": 36.35,
    "text": "tempat berteduh di mana kamu"
  },
  {
    "start": 36.35,
    "end": 38.76,
    "text": "bisa melepaskan semua topeng sosial"
  },
  {
    "start": 38.76,
    "end": 40.77,
    "text": "dan tuntutan dunia."
  },
  {
    "start": 40.77,
    "end": 42.63,
    "text": "Di ruangan itulah kamu bisa"
  },
  {
    "start": 42.63,
    "end": 44.91,
    "text": "jujur mengakui rasa lelahmu,"
  },
  {
    "start": 44.91,
    "end": 46.85,
    "text": "memaafkan kekuranganmu,"
  },
  {
    "start": 46.85,
    "end": 49.13,
    "text": "dan mengisi kembali jiwamu dengan"
  },
  {
    "start": 49.13,
    "end": 51.41,
    "text": "ketenangan yang jernih."
  }
]