[
  {
    "start": 0.0,
    "end": 1.88,
    "text": "Kadang hidup ini memang"
  },
  {
    "start": 1.88,
    "end": 3.75,
    "text": "berjalan tidak sesuai rencana."
  },
  {
    "start": 4.14,
    "end": 6.33,
    "text": "Kamu sudah berusaha"
  },
  {
    "start": 6.33,
    "end": 8.52,
    "text": "maksimal, sudah berjuang berminggu-minggu."
  },
  {
    "start": 9.21,
    "end": 10.75,
    "text": "Tapi hasilnya tetap"
  },
  {
    "start": 10.75,
    "end": 12.28,
    "text": "saja meleset dari harapan."
  },
  {
    "start": 12.83,
    "end": 15.01,
    "text": "Kecewa itu sangat manusiawi, kawan."
  },
  {
    "start": 15.65,
    "end": 18.06,
    "text": "Kalau mau sedih, sedihlah hari ini."
  },
  {
    "start": 18.33,
    "end": 19.99,
    "text": "Kamu tidak perlu berpura-pura"
  },
  {
    "start": 19.99,
    "end": 21.65,
    "text": "kuat di depan semua orang."
  },
  {
    "start": 22.18,
    "end": 24.09,
    "text": "Tapi setelah rasa kecewamu"
  },
  {
    "start": 24.09,
    "end": 26.01,
    "text": "reda, ingat satu hal ini."
  },
  {
    "start": 26.33,
    "end": 28.53,
    "text": "Jalan hidupmu belum buntu."
  },
  {
    "start": 28.91,
    "end": 31.06,
    "text": "Kamu cuma diminta berbelok sebentar."
  },
  {
    "start": 31.42,
    "end": 33.28,
    "text": "Orang-orang yang berjiwa besar bukan"
  },
  {
    "start": 33.28,
    "end": 35.15,
    "text": "mereka yang tidak pernah gagal."
  },
  {
    "start": 35.61,
    "end": 37.49,
    "text": "Tapi mereka yang bisa"
  },
  {
    "start": 37.49,
    "end": 39.36,
    "text": "mengambil pelajaran dari kegagalan"
  },
  {
    "start": 39.36,
    "end": 41.24,
    "text": "itu tanpa kehilangan arah."
  },
  {
    "start": 41.77,
    "end": 43.83,
    "text": "Anggap saja peristiwa pahit hari"
  },
  {
    "start": 43.83,
    "end": 45.9,
    "text": "ini sedang melatih mentalmu supaya"
  },
  {
    "start": 45.9,
    "end": 47.96,
    "text": "lebih kebal dan lebih matang."
  },
  {
    "start": 48.43,
    "end": 50.02,
    "text": "Tidak ada usaha"
  },
  {
    "start": 50.02,
    "end": 51.62,
    "text": "baik yang benar-benar sia-sia."
  },
  {
    "start": 52.02,
    "end": 53.86,
    "text": "Mungkin hasilnya bukan hari"
  },
  {
    "start": 53.86,
    "end": 55.7,
    "text": "ini, tapi ketahanan batin"
  },
  {
    "start": 55.7,
    "end": 57.55,
    "text": "yang kamu bangun bakal"
  },
  {
    "start": 57.55,
    "end": 59.39,
    "text": "jadi modal terbesar untuk masa depanmu."
  },
  {
    "start": 59.98,
    "end": 61.27,
    "text": "Tarik napas panjang."
  },
  {
    "start": 61.64,
    "end": 64.09,
    "text": "Yang sudah rusak, biarkan berlalu."
  },
  {
    "start": 64.63,
    "end": 67.04,
    "text": "Istirahatlah malam ini dan besok"
  },
  {
    "start": 67.04,
    "end": 69.45,
    "text": "kita mulai melangkah lagi pelan-pelan."
  }
]