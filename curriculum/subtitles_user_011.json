[
  {
    "start": 0.0,
    "end": 0.9,
    "text": "Capek ya,"
  },
  {
    "start": 0.9,
    "end": 3.49,
    "text": "kalau hidupmu terus-terusan dihabiskan cuma"
  },
  {
    "start": 3.49,
    "end": 5.77,
    "text": "buat berusaha menyenangkan semua orang"
  },
  {
    "start": 5.77,
    "end": 7.27,
    "text": "di sekitarmu?"
  },
  {
    "start": 7.27,
    "end": 9.14,
    "text": "Kamu takut berkata tidak,"
  },
  {
    "start": 9.14,
    "end": 12.14,
    "text": "kamu mengorbankan waktu istirahatmu sendiri,"
  },
  {
    "start": 12.14,
    "end": 14.0,
    "text": "dan kamu selalu merasa bersalah"
  },
  {
    "start": 14.0,
    "end": 15.63,
    "text": "kalau ada orang yang kecewa"
  },
  {
    "start": 15.63,
    "end": 16.77,
    "text": "padamu."
  },
  {
    "start": 16.77,
    "end": 18.81,
    "text": "Sadarilah satu kenyataan hidup ini"
  },
  {
    "start": 18.81,
    "end": 20.91,
    "text": "kawan: sebaik apa pun niatmu,"
  },
  {
    "start": 20.91,
    "end": 23.32,
    "text": "dan setulus apa pun pengorbananmu,"
  },
  {
    "start": 23.32,
    "end": 24.88,
    "text": "akan selalu ada orang yang"
  },
  {
    "start": 24.88,
    "end": 26.8,
    "text": "tidak suka kepadamu."
  },
  {
    "start": 26.8,
    "end": 28.55,
    "text": "Bahkan orang yang paling suci"
  },
  {
    "start": 28.55,
    "end": 30.05,
    "text": "dan berhati emas di dunia"
  },
  {
    "start": 30.05,
    "end": 32.51,
    "text": "ini pun tetap punya pembenci."
  },
  {
    "start": 32.51,
    "end": 35.04,
    "text": "Mengharapkan semua orang menyukaimu adalah"
  },
  {
    "start": 35.04,
    "end": 37.02,
    "text": "perlombaan tanpa garis akhir yang"
  },
  {
    "start": 37.02,
    "end": 39.73,
    "text": "cuma bakal menguras habis jiwamu."
  },
  {
    "start": 39.73,
    "end": 41.77,
    "text": "Nilai dirimu tidak ditentukan oleh"
  },
  {
    "start": 41.77,
    "end": 43.69,
    "text": "seberapa banyak pujian yang kamu"
  },
  {
    "start": 43.69,
    "end": 45.92,
    "text": "dapatkan dari orang lain."
  },
  {
    "start": 45.92,
    "end": 47.78,
    "text": "Nilai dirimu ada pada kejujuran"
  },
  {
    "start": 47.78,
    "end": 49.88,
    "text": "dan ketulusan hatimu saat menjalani"
  },
  {
    "start": 49.88,
    "end": 50.97,
    "text": "hidup."
  },
  {
    "start": 50.97,
    "end": 53.13,
    "text": "Beranilah berkata tidak pada hal-hal"
  },
  {
    "start": 53.13,
    "end": 55.35,
    "text": "yang merusak kedamaianmu."
  },
  {
    "start": 55.35,
    "end": 57.7,
    "text": "Hidupmu terlalu berharga untuk dijalani"
  },
  {
    "start": 57.7,
    "end": 60.46,
    "text": "berdasarkan ekspektasi orang lain."
  },
  {
    "start": 60.46,
    "end": 62.74,
    "text": "Cukup jadilah manusia yang baik,"
  },
  {
    "start": 62.74,
    "end": 64.49,
    "text": "dan biarkan orang lain dengan"
  },
  {
    "start": 64.49,
    "end": 66.35,
    "text": "pilihannya sendiri."
  }
]