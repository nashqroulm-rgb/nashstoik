[
  {
    "start": 0.0,
    "end": 1.97,
    "text": "Bila ada orang yang memandangmu"
  },
  {
    "start": 1.97,
    "end": 4.71,
    "text": "sebelah mata dan meremehkan potensimu,"
  },
  {
    "start": 4.71,
    "end": 7.38,
    "text": "jangan buru-buru tersinggung atau membalas"
  },
  {
    "start": 7.38,
    "end": 9.73,
    "text": "dengan kata-kata emosional."
  },
  {
    "start": 9.73,
    "end": 11.89,
    "text": "Pandangan mereka yang sempit tidak"
  },
  {
    "start": 11.89,
    "end": 14.12,
    "text": "akan pernah bisa mengubah kenyataan"
  },
  {
    "start": 14.12,
    "end": 17.24,
    "text": "tentang kemampuan dan keteguhan jiwamu."
  },
  {
    "start": 17.24,
    "end": 19.27,
    "text": "Jawaban terbaik untuk orang yang"
  },
  {
    "start": 19.27,
    "end": 22.01,
    "text": "meremehkanmu bukanlah perdebatan panjang di"
  },
  {
    "start": 22.01,
    "end": 23.47,
    "text": "media sosial."
  },
  {
    "start": 23.47,
    "end": 25.76,
    "text": "Jawaban terbaik adalah hasil kerjamu"
  },
  {
    "start": 25.76,
    "end": 27.6,
    "text": "yang nyata dan konsisten dari"
  },
  {
    "start": 27.6,
    "end": 29.07,
    "text": "hari ke hari."
  },
  {
    "start": 29.07,
    "end": 31.29,
    "text": "Biarkan mereka sibuk mencibir,"
  },
  {
    "start": 31.29,
    "end": 33.65,
    "text": "sementara kamu tetap fokus menajamkan"
  },
  {
    "start": 33.65,
    "end": 36.06,
    "text": "kemampuanmu dalam kesunyian."
  },
  {
    "start": 36.06,
    "end": 37.85,
    "text": "Pohon jati yang kokoh tumbuh"
  },
  {
    "start": 37.85,
    "end": 39.69,
    "text": "perlahan di dalam hutan,"
  },
  {
    "start": 39.69,
    "end": 42.36,
    "text": "tanpa perlu membuktikan kekuatannya kepada"
  },
  {
    "start": 42.36,
    "end": 43.76,
    "text": "rumput liar."
  },
  {
    "start": 43.76,
    "end": 45.73,
    "text": "Tetaplah melangkah tenang,"
  },
  {
    "start": 45.73,
    "end": 48.85,
    "text": "waktu yang akan membuktikan kualitasmu."
  }
]