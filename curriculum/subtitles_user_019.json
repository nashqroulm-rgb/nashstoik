[
  {
    "start": 0.0,
    "end": 1.92,
    "text": "Mengeluh itu terasa sangat mudah"
  },
  {
    "start": 1.92,
    "end": 3.91,
    "text": "dan melegakan untuk sesaat,"
  },
  {
    "start": 3.91,
    "end": 4.99,
    "text": "bukan?"
  },
  {
    "start": 4.99,
    "end": 6.91,
    "text": "Kita mengeluh tentang cuaca yang"
  },
  {
    "start": 6.91,
    "end": 8.11,
    "text": "terlalu panas,"
  },
  {
    "start": 8.11,
    "end": 10.22,
    "text": "mengeluh tentang atasan yang banyak"
  },
  {
    "start": 10.22,
    "end": 11.12,
    "text": "menuntut,"
  },
  {
    "start": 11.12,
    "end": 13.04,
    "text": "atau mengeluh tentang nasib yang"
  },
  {
    "start": 13.04,
    "end": 15.51,
    "text": "terasa tidak kunjung membaik."
  },
  {
    "start": 15.51,
    "end": 17.13,
    "text": "Tapi sadarilah kawan,"
  },
  {
    "start": 17.13,
    "end": 18.87,
    "text": "sebanyak apa pun kata keluhan"
  },
  {
    "start": 18.87,
    "end": 20.74,
    "text": "yang keluar dari mulutmu,"
  },
  {
    "start": 20.74,
    "end": 22.3,
    "text": "tidak ada satu pun masalah"
  },
  {
    "start": 22.3,
    "end": 24.22,
    "text": "yang akan selesai karena keluhan"
  },
  {
    "start": 24.22,
    "end": 25.49,
    "text": "tersebut."
  },
  {
    "start": 25.49,
    "end": 27.59,
    "text": "Mengeluh hanya akan menguras energi"
  },
  {
    "start": 27.59,
    "end": 29.45,
    "text": "positifmu dan membuat hal kecil"
  },
  {
    "start": 29.45,
    "end": 31.32,
    "text": "terasa sepuluh kali lipat lebih"
  },
  {
    "start": 31.32,
    "end": 32.4,
    "text": "berat."
  },
  {
    "start": 32.4,
    "end": 34.8,
    "text": "Orang-orang yang berjiwa tangguh memilih"
  },
  {
    "start": 34.8,
    "end": 36.79,
    "text": "untuk mengubah energi keluhan itu"
  },
  {
    "start": 36.79,
    "end": 39.31,
    "text": "menjadi energi tindakan nyata."
  },
  {
    "start": 39.31,
    "end": 41.6,
    "text": "Jika keadaan bisa kamu perbaiki,"
  },
  {
    "start": 41.6,
    "end": 44.36,
    "text": "perbaikilah dengan kedua tanganmu."
  },
  {
    "start": 44.36,
    "end": 46.04,
    "text": "Tapi jika keadaan itu memang"
  },
  {
    "start": 46.04,
    "end": 47.43,
    "text": "harus kamu lalui,"
  },
  {
    "start": 47.43,
    "end": 49.47,
    "text": "terimalah dengan lapang dada tanpa"
  },
  {
    "start": 49.47,
    "end": 51.82,
    "text": "meracuni pikiranmu sendiri."
  },
  {
    "start": 51.82,
    "end": 53.92,
    "text": "Jadilah seperti pohon beringin yang"
  },
  {
    "start": 53.92,
    "end": 55.0,
    "text": "kokoh."
  },
  {
    "start": 55.0,
    "end": 56.74,
    "text": "Dia tidak mengeluh saat musim"
  },
  {
    "start": 56.74,
    "end": 58.61,
    "text": "panas membakar atau musim hujan"
  },
  {
    "start": 58.61,
    "end": 59.93,
    "text": "mengguyur."
  },
  {
    "start": 59.93,
    "end": 62.03,
    "text": "Dia hanya terus menancapkan akarnya"
  },
  {
    "start": 62.03,
    "end": 64.68,
    "text": "dalam-dalam dan terus bertumbuh."
  }
]