[
  {
    "start": 0.0,
    "end": 1.87,
    "text": "Di era modern sekarang,"
  },
  {
    "start": 1.87,
    "end": 4.2,
    "text": "kita seringkali dinilai dari hal-hal"
  },
  {
    "start": 4.2,
    "end": 5.95,
    "text": "yang menempel di luar tubuh"
  },
  {
    "start": 5.95,
    "end": 7.05,
    "text": "kita."
  },
  {
    "start": 7.05,
    "end": 8.34,
    "text": "Apa jabatanmu,"
  },
  {
    "start": 8.34,
    "end": 9.63,
    "text": "berapa gajimu,"
  },
  {
    "start": 9.63,
    "end": 11.31,
    "text": "dan apa merek pakaian yang"
  },
  {
    "start": 11.31,
    "end": 12.93,
    "text": "kamu kenakan."
  },
  {
    "start": 12.93,
    "end": 15.39,
    "text": "Hal-hal duniawi itu seringkali membuat"
  },
  {
    "start": 15.39,
    "end": 17.2,
    "text": "kita merasa rendah diri saat"
  },
  {
    "start": 17.2,
    "end": 18.75,
    "text": "belum memilikinya,"
  },
  {
    "start": 18.75,
    "end": 21.08,
    "text": "atau sebaliknya membuat kita menjadi"
  },
  {
    "start": 21.08,
    "end": 23.73,
    "text": "sombong saat sudah meraihnya."
  },
  {
    "start": 23.73,
    "end": 26.25,
    "text": "Tarik napas perlahan kawan."
  },
  {
    "start": 26.25,
    "end": 29.29,
    "text": "Renungkan satu kebenaran abadi ini."
  },
  {
    "start": 29.29,
    "end": 31.03,
    "text": "Semua atribut luar itu bisa"
  },
  {
    "start": 31.03,
    "end": 33.49,
    "text": "hilang dalam sekejap mata."
  },
  {
    "start": 33.49,
    "end": 35.24,
    "text": "Jabatan bisa dicopot,"
  },
  {
    "start": 35.24,
    "end": 36.98,
    "text": "kekayaan bisa lenyap,"
  },
  {
    "start": 36.98,
    "end": 38.99,
    "text": "dan ketenaran bisa sirna begitu"
  },
  {
    "start": 38.99,
    "end": 40.08,
    "text": "saja."
  },
  {
    "start": 40.08,
    "end": 42.74,
    "text": "Satu-satunya hal yang benar-benar menjadi"
  },
  {
    "start": 42.74,
    "end": 44.74,
    "text": "milikmu dan tidak bisa dirampas"
  },
  {
    "start": 44.74,
    "end": 46.68,
    "text": "oleh siapa pun adalah karakter"
  },
  {
    "start": 46.68,
    "end": 48.49,
    "text": "batinmu sendiri."
  },
  {
    "start": 48.49,
    "end": 51.14,
    "text": "Seberapa jujur kamu saat sendirian,"
  },
  {
    "start": 51.14,
    "end": 53.79,
    "text": "seberapa setia kamu memegang janji,"
  },
  {
    "start": 53.79,
    "end": 55.86,
    "text": "dan seberapa tulus kamu menolong"
  },
  {
    "start": 55.86,
    "end": 57.54,
    "text": "orang lain yang tidak bisa"
  },
  {
    "start": 57.54,
    "end": 59.61,
    "text": "membalas kebaikanmu."
  },
  {
    "start": 59.61,
    "end": 61.55,
    "text": "Tidurlah malam ini dengan rasa"
  },
  {
    "start": 61.55,
    "end": 63.88,
    "text": "bangga atas integritas yang berhasil"
  },
  {
    "start": 63.88,
    "end": 65.88,
    "text": "kamu jaga hari ini."
  }
]