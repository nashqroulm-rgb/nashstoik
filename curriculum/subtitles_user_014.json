[
  {
    "start": 0.0,
    "end": 1.38,
    "text": "Malam Minggu ini,"
  },
  {
    "start": 1.38,
    "end": 3.19,
    "text": "sebelum kamu menutup pekan dan"
  },
  {
    "start": 3.19,
    "end": 3.91,
    "text": "tidur,"
  },
  {
    "start": 3.91,
    "end": 5.84,
    "text": "mari letakkan semua ransel beban"
  },
  {
    "start": 5.84,
    "end": 7.46,
    "text": "yang kamu bawa selama tujuh"
  },
  {
    "start": 7.46,
    "end": 9.03,
    "text": "hari terakhir."
  },
  {
    "start": 9.03,
    "end": 11.02,
    "text": "Mungkin sepekan ini terasa sangat"
  },
  {
    "start": 11.02,
    "end": 12.52,
    "text": "berat bagimu."
  },
  {
    "start": 12.52,
    "end": 14.39,
    "text": "Ada rencana yang meleset,"
  },
  {
    "start": 14.39,
    "end": 16.01,
    "text": "ada target kerja yang belum"
  },
  {
    "start": 16.01,
    "end": 16.92,
    "text": "tercapai,"
  },
  {
    "start": 16.92,
    "end": 18.9,
    "text": "atau ada perselisihan yang sempat"
  },
  {
    "start": 18.9,
    "end": 21.37,
    "text": "membuat hatimu gundah gulana."
  },
  {
    "start": 21.37,
    "end": 23.36,
    "text": "Jangan bawa kelelahan sepekan ini"
  },
  {
    "start": 23.36,
    "end": 25.58,
    "text": "masuk ke pekan yang baru."
  },
  {
    "start": 25.58,
    "end": 27.39,
    "text": "Apa yang sudah terjadi biarkan"
  },
  {
    "start": 27.39,
    "end": 29.38,
    "text": "menjadi pelajaran berharga,"
  },
  {
    "start": 29.38,
    "end": 31.36,
    "text": "tapi jangan biarkan rasa sesalnya"
  },
  {
    "start": 31.36,
    "end": 33.59,
    "text": "terus membebani pundakmu."
  },
  {
    "start": 33.59,
    "end": 35.22,
    "text": "Orang yang bijak tahu kapan"
  },
  {
    "start": 35.22,
    "end": 37.44,
    "text": "saatnya berjuang sekuat tenaga,"
  },
  {
    "start": 37.44,
    "end": 39.31,
    "text": "dan tahu kapan saatnya berhenti"
  },
  {
    "start": 39.31,
    "end": 41.17,
    "text": "untuk beristirahat."
  },
  {
    "start": 41.17,
    "end": 43.64,
    "text": "Istirahat bukanlah tanda kelemahan,"
  },
  {
    "start": 43.64,
    "end": 45.69,
    "text": "melainkan jeda penting agar jiwamu"
  },
  {
    "start": 45.69,
    "end": 47.68,
    "text": "punya tenaga baru untuk melangkah"
  },
  {
    "start": 47.68,
    "end": 48.88,
    "text": "kembali."
  },
  {
    "start": 48.88,
    "end": 51.41,
    "text": "Tarik napas dalam-dalam kawan."
  },
  {
    "start": 51.41,
    "end": 53.88,
    "text": "Hembuskan seluruh kepenatan yang menumpuk"
  },
  {
    "start": 53.88,
    "end": 55.2,
    "text": "di dadamu."
  },
  {
    "start": 55.2,
    "end": 57.13,
    "text": "Kamu sudah melewati sepekan yang"
  },
  {
    "start": 57.13,
    "end": 59.11,
    "text": "penuh tantangan ini dengan sangat"
  },
  {
    "start": 59.11,
    "end": 60.5,
    "text": "luar biasa."
  },
  {
    "start": 60.5,
    "end": 62.18,
    "text": "Maafkan semua hal yang tidak"
  },
  {
    "start": 62.18,
    "end": 63.45,
    "text": "sempurna."
  },
  {
    "start": 63.45,
    "end": 65.8,
    "text": "Tidurlah dengan tenang malam ini,"
  },
  {
    "start": 65.8,
    "end": 67.9,
    "text": "besok fajar akan menyambutmu dengan"
  },
  {
    "start": 67.9,
    "end": 69.41,
    "text": "harapan baru."
  }
]