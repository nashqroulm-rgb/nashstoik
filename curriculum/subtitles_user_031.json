[
  {
    "start": 0.0,
    "end": 2.1,
    "text": "Rasa malas itu seringkali datang"
  },
  {
    "start": 2.1,
    "end": 4.54,
    "text": "menyamar sebagai bisikan halus: nanti"
  },
  {
    "start": 4.54,
    "end": 5.2,
    "text": "saja,"
  },
  {
    "start": 5.2,
    "end": 7.3,
    "text": "besok masih ada waktu."
  },
  {
    "start": 7.3,
    "end": 9.67,
    "text": "Kamu menunda pekerjaan penting,"
  },
  {
    "start": 9.67,
    "end": 12.23,
    "text": "memilih bersantai di tempat tidur,"
  },
  {
    "start": 12.23,
    "end": 14.47,
    "text": "tapi ironisnya hatimu malah merasa"
  },
  {
    "start": 14.47,
    "end": 17.43,
    "text": "gelisah dan dipenuhi rasa bersalah."
  },
  {
    "start": 17.43,
    "end": 19.86,
    "text": "Bersantai yang diliputi rasa bersalah"
  },
  {
    "start": 19.86,
    "end": 21.44,
    "text": "bukanlah istirahat,"
  },
  {
    "start": 21.44,
    "end": 23.61,
    "text": "melainkan siksaan batin yang kamu"
  },
  {
    "start": 23.61,
    "end": 25.13,
    "text": "buat sendiri."
  },
  {
    "start": 25.13,
    "end": 27.3,
    "text": "Dengar baik-baik kawan."
  },
  {
    "start": 27.3,
    "end": 29.27,
    "text": "Lawan dari rasa malas bukanlah"
  },
  {
    "start": 29.27,
    "end": 31.77,
    "text": "motivasi yang meledak-ledak."
  },
  {
    "start": 31.77,
    "end": 33.74,
    "text": "Lawan dari rasa malas hanyalah"
  },
  {
    "start": 33.74,
    "end": 35.72,
    "text": "satu tindakan kecil selama dua"
  },
  {
    "start": 35.72,
    "end": 36.77,
    "text": "menit."
  },
  {
    "start": 36.77,
    "end": 39.01,
    "text": "Jangan pikirkan seberapa berat dan"
  },
  {
    "start": 39.01,
    "end": 41.31,
    "text": "panjangnya pekerjaan itu."
  },
  {
    "start": 41.31,
    "end": 43.48,
    "text": "Cukup paksa tubuhmu untuk memulai"
  },
  {
    "start": 43.48,
    "end": 45.32,
    "text": "dua menit pertama."
  },
  {
    "start": 45.32,
    "end": 46.9,
    "text": "Duduklah di mejamu,"
  },
  {
    "start": 46.9,
    "end": 48.02,
    "text": "buka bukumu,"
  },
  {
    "start": 48.02,
    "end": 50.58,
    "text": "atau ketik kalimat pertamamu."
  },
  {
    "start": 50.58,
    "end": 53.41,
    "text": "Begitu roda tindakanmu mulai berputar,"
  },
  {
    "start": 53.41,
    "end": 55.12,
    "text": "rasa malas itu akan hilang"
  },
  {
    "start": 55.12,
    "end": 56.96,
    "text": "dengan sendirinya."
  },
  {
    "start": 56.96,
    "end": 59.46,
    "text": "Kemenangan atas dirimu sendiri dimulai"
  },
  {
    "start": 59.46,
    "end": 61.96,
    "text": "dari langkah kecil hari ini."
  }
]