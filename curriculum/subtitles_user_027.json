[
  {
    "start": 0.0,
    "end": 1.92,
    "text": "Besok pagi saat kamu melangkah"
  },
  {
    "start": 1.92,
    "end": 3.96,
    "text": "keluar dari pintu rumahmu,"
  },
  {
    "start": 3.96,
    "end": 5.94,
    "text": "sadarilah bahwa kamu pasti akan"
  },
  {
    "start": 5.94,
    "end": 9.14,
    "text": "bertemu dengan berbagai macam manusia."
  },
  {
    "start": 9.14,
    "end": 11.18,
    "text": "Akan ada orang yang egois,"
  },
  {
    "start": 11.18,
    "end": 12.97,
    "text": "orang yang tidak tahu terima"
  },
  {
    "start": 12.97,
    "end": 13.73,
    "text": "kasih,"
  },
  {
    "start": 13.73,
    "end": 15.78,
    "text": "orang yang suka berbohong,"
  },
  {
    "start": 15.78,
    "end": 18.27,
    "text": "dan orang yang mudah marah."
  },
  {
    "start": 18.27,
    "end": 20.25,
    "text": "Jangan kaget dan jangan biarkan"
  },
  {
    "start": 20.25,
    "end": 23.25,
    "text": "hal itu merusak ketenangan batinmu."
  },
  {
    "start": 23.25,
    "end": 25.36,
    "text": "Mereka bersikap seperti itu bukan"
  },
  {
    "start": 25.36,
    "end": 27.34,
    "text": "karena mereka membencimu,"
  },
  {
    "start": 27.34,
    "end": 29.39,
    "text": "tapi karena batin mereka sendiri"
  },
  {
    "start": 29.39,
    "end": 31.3,
    "text": "sedang buta terhadap mana yang"
  },
  {
    "start": 31.3,
    "end": 33.67,
    "text": "baik dan mana yang salah."
  },
  {
    "start": 33.67,
    "end": 36.86,
    "text": "Persiapkan pelindung jiwamu malam ini."
  },
  {
    "start": 36.86,
    "end": 39.1,
    "text": "Katakan pada dirimu sendiri: mereka"
  },
  {
    "start": 39.1,
    "end": 41.01,
    "text": "tidak akan bisa merusak hariku"
  },
  {
    "start": 41.01,
    "end": 43.06,
    "text": "karena aku tidak akan membiarkan"
  },
  {
    "start": 43.06,
    "end": 45.04,
    "text": "keburukan mereka masuk ke dalam"
  },
  {
    "start": 45.04,
    "end": 46.25,
    "text": "hatiku."
  },
  {
    "start": 46.25,
    "end": 48.36,
    "text": "Tunjukkan kepada dunia bahwa kamu"
  },
  {
    "start": 48.36,
    "end": 50.34,
    "text": "bisa tetap menjadi manusia yang"
  },
  {
    "start": 50.34,
    "end": 53.28,
    "text": "berintegritas dan berbudi pekerti luhur,"
  },
  {
    "start": 53.28,
    "end": 55.45,
    "text": "betapa pun kacaunya orang-orang di"
  },
  {
    "start": 55.45,
    "end": 56.85,
    "text": "sekitarmu."
  },
  {
    "start": 56.85,
    "end": 58.71,
    "text": "Istirahatlah malam ini,"
  },
  {
    "start": 58.71,
    "end": 60.75,
    "text": "dan siapkan hatimu untuk menjadi"
  },
  {
    "start": 60.75,
    "end": 63.24,
    "text": "teladan kebaikan esok pagi."
  }
]