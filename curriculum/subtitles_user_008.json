[
  {
    "start": 0.0,
    "end": 1.95,
    "text": "Pernah tidak kamu merasa sangat"
  },
  {
    "start": 1.95,
    "end": 3.27,
    "text": "cemas seharian,"
  },
  {
    "start": 3.27,
    "end": 5.91,
    "text": "padahal setelah ditelusuri masalah aslinya"
  },
  {
    "start": 5.91,
    "end": 7.61,
    "text": "cuma hal kecil?"
  },
  {
    "start": 7.61,
    "end": 9.69,
    "text": "Kita ini seringkali terluka bukan"
  },
  {
    "start": 9.69,
    "end": 11.83,
    "text": "karena keadaan di luar sana,"
  },
  {
    "start": 11.83,
    "end": 14.03,
    "text": "tapi karena cerita menyeramkan yang"
  },
  {
    "start": 14.03,
    "end": 15.79,
    "text": "kita karang sendiri di dalam"
  },
  {
    "start": 15.79,
    "end": 16.98,
    "text": "kepala."
  },
  {
    "start": 16.98,
    "end": 18.74,
    "text": "Ada pesan singkat yang belum"
  },
  {
    "start": 18.74,
    "end": 19.63,
    "text": "dibalas,"
  },
  {
    "start": 19.63,
    "end": 21.64,
    "text": "kita langsung berpikir orang itu"
  },
  {
    "start": 21.64,
    "end": 23.27,
    "text": "membenci kita."
  },
  {
    "start": 23.27,
    "end": 25.92,
    "text": "Ada sedikit kendala dalam pekerjaan,"
  },
  {
    "start": 25.92,
    "end": 28.56,
    "text": "kita langsung panik membayangkan kegagalan"
  },
  {
    "start": 28.56,
    "end": 29.69,
    "text": "besar."
  },
  {
    "start": 29.69,
    "end": 32.14,
    "text": "Tarik napas perlahan kawan."
  },
  {
    "start": 32.14,
    "end": 34.85,
    "text": "Hembuskan dan tenangkan dirimu."
  },
  {
    "start": 34.85,
    "end": 36.17,
    "text": "Mulai hari ini,"
  },
  {
    "start": 36.17,
    "end": 38.56,
    "text": "belajar pisahkan mana yang benar-benar"
  },
  {
    "start": 38.56,
    "end": 39.31,
    "text": "fakta,"
  },
  {
    "start": 39.31,
    "end": 40.89,
    "text": "dan mana yang cuma asumsi"
  },
  {
    "start": 40.89,
    "end": 42.08,
    "text": "liarmu."
  },
  {
    "start": 42.08,
    "end": 43.78,
    "text": "Fakta adalah apa yang nyata"
  },
  {
    "start": 43.78,
    "end": 45.54,
    "text": "terjadi di depan mata,"
  },
  {
    "start": 45.54,
    "end": 47.99,
    "text": "sedangkan asumsi adalah bumbu ketakutan"
  },
  {
    "start": 47.99,
    "end": 50.19,
    "text": "yang kamu buat sendiri."
  },
  {
    "start": 50.19,
    "end": 52.71,
    "text": "Jangan biarkan imajinasimu menjadi musuh"
  },
  {
    "start": 52.71,
    "end": 55.54,
    "text": "terbesar bagi ketenangan batinmu."
  },
  {
    "start": 55.54,
    "end": 57.93,
    "text": "Begitu pikiran buruk itu datang,"
  },
  {
    "start": 57.93,
    "end": 59.94,
    "text": "tanyakan pada dirimu: apakah ini"
  },
  {
    "start": 59.94,
    "end": 61.58,
    "text": "benar-benar terjadi,"
  },
  {
    "start": 61.58,
    "end": 63.78,
    "text": "atau aku cuma sedang menakut-nakuti"
  },
  {
    "start": 63.78,
    "end": 65.48,
    "text": "diriku sendiri?"
  },
  {
    "start": 65.48,
    "end": 68.31,
    "text": "Pegang kendali pikiranmu kembali."
  },
  {
    "start": 68.31,
    "end": 70.7,
    "text": "Pandanglah kenyataan apa adanya,"
  },
  {
    "start": 70.7,
    "end": 73.09,
    "text": "tanpa ditambah rasa panik."
  }
]