[
  {
    "start": 0.0,
    "end": 2.42,
    "text": "Malam ini kita menggenapkan seratus"
  },
  {
    "start": 2.42,
    "end": 4.49,
    "text": "dua belas hari perjalanan suci"
  },
  {
    "start": 4.49,
    "end": 5.52,
    "text": "kita."
  },
  {
    "start": 5.52,
    "end": 7.59,
    "text": "Tepat empat bulan kita melatih"
  },
  {
    "start": 7.59,
    "end": 9.8,
    "text": "batin ini tanpa henti."
  },
  {
    "start": 9.8,
    "end": 12.91,
    "text": "Renungkan sejenak betapa jauhnya transformasi"
  },
  {
    "start": 12.91,
    "end": 15.05,
    "text": "jiwamu telah terjadi sejak hari"
  },
  {
    "start": 15.05,
    "end": 17.88,
    "text": "pertama kita melangkah bersama."
  },
  {
    "start": 17.88,
    "end": 19.74,
    "text": "Kini kamu bukan lagi perahu"
  },
  {
    "start": 19.74,
    "end": 22.44,
    "text": "kecil yang terombang-ambing tak berdaya"
  },
  {
    "start": 22.44,
    "end": 24.58,
    "text": "oleh badai kehidupan."
  },
  {
    "start": 24.58,
    "end": 26.92,
    "text": "Kamu telah menjadi mercusuar kokoh"
  },
  {
    "start": 26.92,
    "end": 29.48,
    "text": "yang berdiri tegak memancarkan cahaya"
  },
  {
    "start": 29.48,
    "end": 32.79,
    "text": "ketenangan di tengah gelombang lautan."
  },
  {
    "start": 32.79,
    "end": 34.73,
    "text": "Kamu adalah saksi hidup dari"
  },
  {
    "start": 34.73,
    "end": 36.38,
    "text": "kekuatan ketabahan,"
  },
  {
    "start": 36.38,
    "end": 37.42,
    "text": "kesabaran,"
  },
  {
    "start": 37.42,
    "end": 39.83,
    "text": "dan keanggunan budi pekerti manusia"
  },
  {
    "start": 39.83,
    "end": 41.01,
    "text": "sejati."
  },
  {
    "start": 41.01,
    "end": 43.15,
    "text": "Tarik napas panjang dengan rasa"
  },
  {
    "start": 43.15,
    "end": 45.22,
    "text": "syukur yang mendalam malam ini"
  },
  {
    "start": 45.22,
    "end": 46.32,
    "text": "kawan."
  },
  {
    "start": 46.32,
    "end": 49.36,
    "text": "Beristirahatlah dalam naungan berkah semesta"
  },
  {
    "start": 49.36,
    "end": 50.4,
    "text": "raya."
  },
  {
    "start": 50.4,
    "end": 52.74,
    "text": "Fajar baru menanti langkah gagahmu"
  },
  {
    "start": 52.74,
    "end": 54.13,
    "text": "esok hari."
  }
]