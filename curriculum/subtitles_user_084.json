[
  {
    "start": 0.0,
    "end": 1.97,
    "text": "Malam ini genap delapan puluh"
  },
  {
    "start": 1.97,
    "end": 4.08,
    "text": "empat hari perjalanan suci kita"
  },
  {
    "start": 4.08,
    "end": 7.35,
    "text": "bersama meniti jalan ketenangan batin."
  },
  {
    "start": 7.35,
    "end": 9.73,
    "text": "Tepat seperempat tahun kita melatih"
  },
  {
    "start": 9.73,
    "end": 11.83,
    "text": "jiwa ini setiap hari."
  },
  {
    "start": 11.83,
    "end": 14.96,
    "text": "Lihatlah dirimu yang sekarang kawan."
  },
  {
    "start": 14.96,
    "end": 16.73,
    "text": "Kamu bukan lagi orang yang"
  },
  {
    "start": 16.73,
    "end": 18.64,
    "text": "sama dengan dirimu yang dulu"
  },
  {
    "start": 18.64,
    "end": 20.4,
    "text": "mudah goyah oleh caci maki"
  },
  {
    "start": 20.4,
    "end": 22.78,
    "text": "dunia atau panik oleh bayang-bayang"
  },
  {
    "start": 22.78,
    "end": 24.21,
    "text": "masa depan."
  },
  {
    "start": 24.21,
    "end": 26.46,
    "text": "Kamu telah melatih dirimu menjadi"
  },
  {
    "start": 26.46,
    "end": 28.5,
    "text": "pribadi yang berakar kuat pada"
  },
  {
    "start": 28.5,
    "end": 30.4,
    "text": "nilai-nilai ketenangan,"
  },
  {
    "start": 30.4,
    "end": 31.42,
    "text": "kesabaran,"
  },
  {
    "start": 31.42,
    "end": 33.39,
    "text": "dan integritas batin yang tak"
  },
  {
    "start": 33.39,
    "end": 34.89,
    "text": "tergoyahkan."
  },
  {
    "start": 34.89,
    "end": 37.61,
    "text": "Kamu telah membuktikan bahwa kebahagiaan"
  },
  {
    "start": 37.61,
    "end": 39.92,
    "text": "sejati bukanlah mimpi kosong,"
  },
  {
    "start": 39.92,
    "end": 42.17,
    "text": "melainkan kenyataan yang hidup di"
  },
  {
    "start": 42.17,
    "end": 44.28,
    "text": "dalam dadamu sendiri."
  },
  {
    "start": 44.28,
    "end": 46.66,
    "text": "Tarik napas dalam-dalam dengan rasa"
  },
  {
    "start": 46.66,
    "end": 49.17,
    "text": "syukur yang paling khidmat."
  },
  {
    "start": 49.17,
    "end": 51.48,
    "text": "Terima kasih atas keteguhan hatimu"
  },
  {
    "start": 51.48,
    "end": 53.66,
    "text": "selama tiga bulan ini."
  },
  {
    "start": 53.66,
    "end": 56.18,
    "text": "Tidurlah dalam kedamaian mutlak malam"
  },
  {
    "start": 56.18,
    "end": 56.79,
    "text": "ini,"
  },
  {
    "start": 56.79,
    "end": 58.63,
    "text": "esok adalah awal dari babak"
  },
  {
    "start": 58.63,
    "end": 61.07,
    "text": "baru yang gilang gemilang."
  }
]