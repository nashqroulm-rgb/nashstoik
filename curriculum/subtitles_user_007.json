[
  {
    "start": 0.0,
    "end": 2.29,
    "text": "Sebelum kamu mematikan lampu malam ini,"
  },
  {
    "start": 2.29,
    "end": 4.59,
    "text": "luangkan waktu sebentar untuk"
  },
  {
    "start": 4.59,
    "end": 6.89,
    "text": "berdamai dengan dirimu sendiri."
  },
  {
    "start": 7.55,
    "end": 10.37,
    "text": "Mungkin hari ini tidak berjalan sempurna,"
  },
  {
    "start": 10.37,
    "end": 12.87,
    "text": "mungkin ada target yang terlewat,"
  },
  {
    "start": 12.87,
    "end": 14.45,
    "text": "ada kata-kata salah"
  },
  {
    "start": 14.45,
    "end": 16.03,
    "text": "yang sempat kamu ucapkan,"
  },
  {
    "start": 16.03,
    "end": 19.5,
    "text": "atau kamu merasa harimu kurang produktif."
  },
  {
    "start": 19.86,
    "end": 21.35,
    "text": "Jangan bawa rasa bersalah"
  },
  {
    "start": 21.35,
    "end": 22.84,
    "text": "itu ke tempat tidurmu."
  },
  {
    "start": 23.01,
    "end": 24.66,
    "text": "Menghukum diri sendiri terus"
  },
  {
    "start": 24.66,
    "end": 26.3,
    "text": "menerus tidak akan mengubah"
  },
  {
    "start": 26.3,
    "end": 27.95,
    "text": "apapun yang sudah lewat."
  },
  {
    "start": 28.27,
    "end": 30.7,
    "text": "Cukup tanyakan pada dirimu dengan jujur,"
  },
  {
    "start": 30.7,
    "end": 32.18,
    "text": "apa yang bisa kupelajari"
  },
  {
    "start": 32.18,
    "end": 33.66,
    "text": "dari hari ini dan"
  },
  {
    "start": 33.66,
    "end": 35.15,
    "text": "apa yang bisa kubikin"
  },
  {
    "start": 35.15,
    "end": 36.63,
    "text": "lebih baik besok pagi."
  },
  {
    "start": 37.16,
    "end": 39.33,
    "text": "Menjadi pribadi yang bijak bukan"
  },
  {
    "start": 39.33,
    "end": 41.51,
    "text": "berarti harus sempurna tanpa cacat."
  },
  {
    "start": 41.87,
    "end": 43.25,
    "text": "Kamu cuma perlu belajar"
  },
  {
    "start": 43.25,
    "end": 44.62,
    "text": "dari kesalahanmu, supaya kamu"
  },
  {
    "start": 44.62,
    "end": 46.0,
    "text": "tidak jatuh ke lubang"
  },
  {
    "start": 46.0,
    "end": 47.38,
    "text": "yang sama dua kali."
  },
  {
    "start": 47.92,
    "end": 49.99,
    "text": "Hargai usahamu hari ini, kawan."
  },
  {
    "start": 50.15,
    "end": 51.55,
    "text": "Kamu sudah bertahan"
  },
  {
    "start": 51.55,
    "end": 52.94,
    "text": "melewati hari yang"
  },
  {
    "start": 52.94,
    "end": 54.34,
    "text": "berat ini dengan sangat baik."
  },
  {
    "start": 54.67,
    "end": 58.07,
    "text": "Tarik nafas dalam-dalam, hembuskan perlahan,"
  },
  {
    "start": 58.46,
    "end": 61.03,
    "text": "dan maafkan semua kekuranganmu."
  },
  {
    "start": 61.42,
    "end": 64.6,
    "text": "Pejamkan matamu, istirahatlah dengan tenang."
  },
  {
    "start": 64.91,
    "end": 66.35,
    "text": "Besok adalah hari"
  },
  {
    "start": 66.35,
    "end": 67.8,
    "text": "yang baru untuk jiwamu."
  }
]