[
  {
    "start": 0.0,
    "end": 2.46,
    "text": "Kehilangan uang karena investasi yang"
  },
  {
    "start": 2.46,
    "end": 3.19,
    "text": "gagal,"
  },
  {
    "start": 3.19,
    "end": 4.65,
    "text": "bisnis yang sepi,"
  },
  {
    "start": 4.65,
    "end": 6.98,
    "text": "atau pengeluaran tak terduga memang"
  },
  {
    "start": 6.98,
    "end": 9.71,
    "text": "bisa membuat dada terasa sesak."
  },
  {
    "start": 9.71,
    "end": 11.97,
    "text": "Wajar jika kamu merasa sedih,"
  },
  {
    "start": 11.97,
    "end": 14.29,
    "text": "tapi jangan biarkan kerugian materi"
  },
  {
    "start": 14.29,
    "end": 16.16,
    "text": "itu merenggut harga diri dan"
  },
  {
    "start": 16.16,
    "end": 17.95,
    "text": "semangat hidupmu."
  },
  {
    "start": 17.95,
    "end": 19.28,
    "text": "Ingatlah kawan,"
  },
  {
    "start": 19.28,
    "end": 21.07,
    "text": "uang dan harta benda adalah"
  },
  {
    "start": 21.07,
    "end": 22.87,
    "text": "hal-hal yang berada di luar"
  },
  {
    "start": 22.87,
    "end": 24.0,
    "text": "dirimu."
  },
  {
    "start": 24.0,
    "end": 26.19,
    "text": "Hari ini mereka bisa hilang,"
  },
  {
    "start": 26.19,
    "end": 27.92,
    "text": "tapi esok hari mereka bisa"
  },
  {
    "start": 27.92,
    "end": 30.25,
    "text": "dicari kembali dengan kerja kerasmu"
  },
  {
    "start": 30.25,
    "end": 31.65,
    "text": "yang jujur."
  },
  {
    "start": 31.65,
    "end": 33.97,
    "text": "Yang paling berbahaya bukanlah saat"
  },
  {
    "start": 33.97,
    "end": 35.44,
    "text": "dompetmu menipis,"
  },
  {
    "start": 35.44,
    "end": 37.96,
    "text": "melainkan saat kepanikan itu membuatmu"
  },
  {
    "start": 37.96,
    "end": 41.68,
    "text": "kehilangan integritas dan ketenangan berpikir."
  },
  {
    "start": 41.68,
    "end": 43.94,
    "text": "Tarik napas dalam-dalam."
  },
  {
    "start": 43.94,
    "end": 46.01,
    "text": "Selama kamu masih memiliki akal"
  },
  {
    "start": 46.01,
    "end": 46.74,
    "text": "sehat,"
  },
  {
    "start": 46.74,
    "end": 48.13,
    "text": "tubuh yang kuat,"
  },
  {
    "start": 48.13,
    "end": 50.26,
    "text": "dan kemauan untuk berusaha,"
  },
  {
    "start": 50.26,
    "end": 52.85,
    "text": "kamu belum benar-benar kalah."
  },
  {
    "start": 52.85,
    "end": 56.11,
    "text": "Bangkitlah kembali dengan kepala tegak."
  }
]