[
  {
    "start": 0.0,
    "end": 1.72,
    "text": "Di dalam rumah tangga atau"
  },
  {
    "start": 1.72,
    "end": 2.91,
    "text": "persahabatan,"
  },
  {
    "start": 2.91,
    "end": 5.35,
    "text": "perselisihan pendapat adalah hal yang"
  },
  {
    "start": 5.35,
    "end": 7.4,
    "text": "sangat wajar terjadi dari waktu"
  },
  {
    "start": 7.4,
    "end": 8.66,
    "text": "ke waktu."
  },
  {
    "start": 8.66,
    "end": 10.71,
    "text": "Tapi bencana besar terjadi saat"
  },
  {
    "start": 10.71,
    "end": 12.96,
    "text": "kita membiarkan ego kita mengambil"
  },
  {
    "start": 12.96,
    "end": 14.15,
    "text": "alih kendali,"
  },
  {
    "start": 14.15,
    "end": 16.99,
    "text": "sehingga kita lebih mementingkan kemenangan"
  },
  {
    "start": 16.99,
    "end": 19.76,
    "text": "dalam perdebatan daripada menjaga perasaan"
  },
  {
    "start": 19.76,
    "end": 22.01,
    "text": "orang yang kita sayangi."
  },
  {
    "start": 22.01,
    "end": 24.72,
    "text": "Kamu mungkin berhasil memenangkan argumen"
  },
  {
    "start": 24.72,
    "end": 27.17,
    "text": "itu dengan kata-kata yang tajam,"
  },
  {
    "start": 27.17,
    "end": 29.02,
    "text": "tapi kamu telah melukai hati"
  },
  {
    "start": 29.02,
    "end": 31.13,
    "text": "orang yang paling berharga dalam"
  },
  {
    "start": 31.13,
    "end": 32.32,
    "text": "hidupmu."
  },
  {
    "start": 32.32,
    "end": 34.44,
    "text": "Saat suasana mulai memanas,"
  },
  {
    "start": 34.44,
    "end": 36.95,
    "text": "jadilah orang pertama yang merendahkan"
  },
  {
    "start": 36.95,
    "end": 38.41,
    "text": "nada bicara."
  },
  {
    "start": 38.41,
    "end": 41.05,
    "text": "Ingatlah bahwa tujuanmu berbicara adalah"
  },
  {
    "start": 41.05,
    "end": 43.76,
    "text": "untuk menyelesaikan masalah bersama,"
  },
  {
    "start": 43.76,
    "end": 46.47,
    "text": "bukan untuk saling mengalahkan."
  },
  {
    "start": 46.47,
    "end": 49.05,
    "text": "Kemenangan sejati dalam hubungan adalah"
  },
  {
    "start": 49.05,
    "end": 50.96,
    "text": "saat kedua belah pihak merasa"
  },
  {
    "start": 50.96,
    "end": 51.89,
    "text": "didengar,"
  },
  {
    "start": 51.89,
    "end": 52.82,
    "text": "dihargai,"
  },
  {
    "start": 52.82,
    "end": 55.33,
    "text": "dan tetap saling menyayangi."
  }
]