[
  {
    "start": 0.0,
    "end": 1.88,
    "text": "Malam ini kita menutup pekan"
  },
  {
    "start": 1.88,
    "end": 4.71,
    "text": "kesembilan dari perjalanan panjang melatih"
  },
  {
    "start": 4.71,
    "end": 6.53,
    "text": "ketenangan hidup."
  },
  {
    "start": 6.53,
    "end": 8.61,
    "text": "Coba renungkan sejenak: hal apa"
  },
  {
    "start": 8.61,
    "end": 10.77,
    "text": "yang sepekan ini paling menguras"
  },
  {
    "start": 10.77,
    "end": 11.78,
    "text": "pikiranmu,"
  },
  {
    "start": 11.78,
    "end": 14.81,
    "text": "dan bagaimana caramu melepaskannya?"
  },
  {
    "start": 14.81,
    "end": 17.3,
    "text": "Ketenangan hidup bukanlah hadiah yang"
  },
  {
    "start": 17.3,
    "end": 20.32,
    "text": "jatuh dari langit secara tiba-tiba."
  },
  {
    "start": 20.32,
    "end": 23.08,
    "text": "Ketenangan adalah keterampilan batin yang"
  },
  {
    "start": 23.08,
    "end": 25.04,
    "text": "kamu latih setiap hari dengan"
  },
  {
    "start": 25.04,
    "end": 27.39,
    "text": "memilih untuk tidak membalas amarah"
  },
  {
    "start": 27.39,
    "end": 29.01,
    "text": "dengan amarah."
  },
  {
    "start": 29.01,
    "end": 31.23,
    "text": "Kamu sudah melakukan yang terbaik"
  },
  {
    "start": 31.23,
    "end": 34.19,
    "text": "sepanjang tujuh hari terakhir ini."
  },
  {
    "start": 34.19,
    "end": 36.95,
    "text": "Jangan biarkan sisa penyesalan mengganggu"
  },
  {
    "start": 36.95,
    "end": 39.37,
    "text": "tidur nyenyakmu malam ini."
  },
  {
    "start": 39.37,
    "end": 41.32,
    "text": "Tarik napas dalam-dalam,"
  },
  {
    "start": 41.32,
    "end": 44.15,
    "text": "hembuskan rasa penatmu perlahan."
  },
  {
    "start": 44.15,
    "end": 45.5,
    "text": "Maafkan harimu,"
  },
  {
    "start": 45.5,
    "end": 47.38,
    "text": "tidurlah dengan tenang,"
  },
  {
    "start": 47.38,
    "end": 49.67,
    "text": "fajar esok menanti dengan senyuman"
  },
  {
    "start": 49.67,
    "end": 50.68,
    "text": "baru."
  }
]