[
  {
    "start": 0.0,
    "end": 1.69,
    "text": "Saat hari terasa berat dan"
  },
  {
    "start": 1.69,
    "end": 3.97,
    "text": "segala urusan seolah tidak berpihak"
  },
  {
    "start": 3.97,
    "end": 4.75,
    "text": "padamu,"
  },
  {
    "start": 4.75,
    "end": 6.57,
    "text": "sangat mudah bagi kita untuk"
  },
  {
    "start": 6.57,
    "end": 9.04,
    "text": "mengeluh dan mengutuk nasib."
  },
  {
    "start": 9.04,
    "end": 10.8,
    "text": "Tapi percayalah kawan,"
  },
  {
    "start": 10.8,
    "end": 12.62,
    "text": "di balik setiap awan mendung"
  },
  {
    "start": 12.62,
    "end": 13.66,
    "text": "yang gelap,"
  },
  {
    "start": 13.66,
    "end": 15.55,
    "text": "selalu ada sinar mentari yang"
  },
  {
    "start": 15.55,
    "end": 16.65,
    "text": "hangat."
  },
  {
    "start": 16.65,
    "end": 18.61,
    "text": "Di balik setiap peristiwa yang"
  },
  {
    "start": 18.61,
    "end": 19.71,
    "text": "menyakitkan,"
  },
  {
    "start": 19.71,
    "end": 21.73,
    "text": "selalu ada hikmah berharga yang"
  },
  {
    "start": 21.73,
    "end": 23.94,
    "text": "sedang membentuk jiwamu."
  },
  {
    "start": 23.94,
    "end": 26.09,
    "text": "Mungkin kegagalan hari ini sedang"
  },
  {
    "start": 26.09,
    "end": 28.62,
    "text": "menyelamatkanmu dari jurang bahaya yang"
  },
  {
    "start": 28.62,
    "end": 30.97,
    "text": "lebih besar di masa depan."
  },
  {
    "start": 30.97,
    "end": 33.11,
    "text": "Mungkin penolakan yang kamu alami"
  },
  {
    "start": 33.11,
    "end": 35.32,
    "text": "hari ini sedang menuntun langkahmu"
  },
  {
    "start": 35.32,
    "end": 37.21,
    "text": "menuju pintu rezeki yang jauh"
  },
  {
    "start": 37.21,
    "end": 38.71,
    "text": "lebih berkah."
  },
  {
    "start": 38.71,
    "end": 40.59,
    "text": "Latih matamu untuk tidak cuma"
  },
  {
    "start": 40.59,
    "end": 41.96,
    "text": "melihat durinya,"
  },
  {
    "start": 41.96,
    "end": 43.98,
    "text": "tapi juga melihat bunganya yang"
  },
  {
    "start": 43.98,
    "end": 45.02,
    "text": "mekar."
  },
  {
    "start": 45.02,
    "end": 45.99,
    "text": "Malam ini,"
  },
  {
    "start": 45.99,
    "end": 47.75,
    "text": "carilah satu hal baik kecil"
  },
  {
    "start": 47.75,
    "end": 49.51,
    "text": "yang terjadi hari ini,"
  },
  {
    "start": 49.51,
    "end": 51.46,
    "text": "sekecil apa pun itu."
  },
  {
    "start": 51.46,
    "end": 53.47,
    "text": "Bersyukurlah atas hal itu,"
  },
  {
    "start": 53.47,
    "end": 55.43,
    "text": "dan rasakan damai yang kembali"
  },
  {
    "start": 55.43,
    "end": 57.31,
    "text": "mengalir di dadamu."
  }
]