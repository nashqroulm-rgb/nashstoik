[
  {
    "start": 0.0,
    "end": 2.18,
    "text": "Musuh paling berbahaya dalam hidupmu"
  },
  {
    "start": 2.18,
    "end": 4.66,
    "text": "sebenarnya bukanlah pesaing bisnismu atau"
  },
  {
    "start": 4.66,
    "end": 6.84,
    "text": "orang-orang yang tidak menyukaimu di"
  },
  {
    "start": 6.84,
    "end": 8.18,
    "text": "luar sana."
  },
  {
    "start": 8.18,
    "end": 10.17,
    "text": "Musuh terbesar yang paling sering"
  },
  {
    "start": 10.17,
    "end": 13.87,
    "text": "menghancurkan kebahagiaanmu adalah egomu sendiri."
  },
  {
    "start": 13.87,
    "end": 15.38,
    "text": "Rasa tidak mau kalah saat"
  },
  {
    "start": 15.38,
    "end": 16.29,
    "text": "berdebat,"
  },
  {
    "start": 16.29,
    "end": 17.99,
    "text": "rasa malu untuk meminta maaf"
  },
  {
    "start": 17.99,
    "end": 19.5,
    "text": "saat berbuat salah,"
  },
  {
    "start": 19.5,
    "end": 21.32,
    "text": "dan rasa gengsi untuk mengakui"
  },
  {
    "start": 21.32,
    "end": 23.01,
    "text": "kekurangan diri."
  },
  {
    "start": 23.01,
    "end": 24.95,
    "text": "Ego selalu menuntut untuk selalu"
  },
  {
    "start": 24.95,
    "end": 26.95,
    "text": "dianggap benar dan dihormati oleh"
  },
  {
    "start": 26.95,
    "end": 28.4,
    "text": "semua orang."
  },
  {
    "start": 28.4,
    "end": 30.4,
    "text": "Dialah yang membuat dadamu terasa"
  },
  {
    "start": 30.4,
    "end": 31.91,
    "text": "panas saat ada orang yang"
  },
  {
    "start": 31.91,
    "end": 33.43,
    "text": "mengkritikmu."
  },
  {
    "start": 33.43,
    "end": 35.24,
    "text": "Orang yang bijak belajar untuk"
  },
  {
    "start": 35.24,
    "end": 37.61,
    "text": "menundukkan egonya sendiri."
  },
  {
    "start": 37.61,
    "end": 39.36,
    "text": "Mereka tidak merasa hina saat"
  },
  {
    "start": 39.36,
    "end": 40.88,
    "text": "harus meminta maaf,"
  },
  {
    "start": 40.88,
    "end": 42.51,
    "text": "dan tidak merasa kecil saat"
  },
  {
    "start": 42.51,
    "end": 44.27,
    "text": "harus belajar dari orang lain"
  },
  {
    "start": 44.27,
    "end": 45.96,
    "text": "yang lebih muda."
  },
  {
    "start": 45.96,
    "end": 48.81,
    "text": "Kerendahan hati bukanlah tanda kelemahan,"
  },
  {
    "start": 48.81,
    "end": 50.69,
    "text": "melainkan tanda jiwa yang sudah"
  },
  {
    "start": 50.69,
    "end": 53.29,
    "text": "selesai dengan dirinya sendiri."
  },
  {
    "start": 53.29,
    "end": 54.26,
    "text": "Malam ini,"
  },
  {
    "start": 54.26,
    "end": 56.38,
    "text": "lepaskan rasa gengsimu."
  },
  {
    "start": 56.38,
    "end": 58.56,
    "text": "Minta maaflah jika kamu salah,"
  },
  {
    "start": 58.56,
    "end": 60.32,
    "text": "dan tidurlah dengan hati yang"
  },
  {
    "start": 60.32,
    "end": 61.47,
    "text": "lapang."
  }
]