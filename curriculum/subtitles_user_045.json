[
  {
    "start": 0.0,
    "end": 2.46,
    "text": "Banyak orang yang menghabiskan seumur"
  },
  {
    "start": 2.46,
    "end": 4.53,
    "text": "hidupnya dalam penyesalan,"
  },
  {
    "start": 4.53,
    "end": 6.66,
    "text": "bukan karena mereka mencoba lalu"
  },
  {
    "start": 6.66,
    "end": 7.39,
    "text": "gagal,"
  },
  {
    "start": 7.39,
    "end": 9.46,
    "text": "tapi karena mereka tidak pernah"
  },
  {
    "start": 9.46,
    "end": 11.66,
    "text": "berani mencoba sama sekali akibat"
  },
  {
    "start": 11.66,
    "end": 13.05,
    "text": "rasa takut."
  },
  {
    "start": 13.05,
    "end": 15.25,
    "text": "Mereka takut dicemooh orang,"
  },
  {
    "start": 15.25,
    "end": 16.32,
    "text": "takut rugi,"
  },
  {
    "start": 16.32,
    "end": 18.45,
    "text": "dan takut merasa malu."
  },
  {
    "start": 18.45,
    "end": 20.71,
    "text": "Akhirnya mereka memilih hidup aman"
  },
  {
    "start": 20.71,
    "end": 22.11,
    "text": "tapi hampa."
  },
  {
    "start": 22.11,
    "end": 24.31,
    "text": "Dengar baik-baik kawan."
  },
  {
    "start": 24.31,
    "end": 27.71,
    "text": "Kegagalan bukanlah lawan dari kesuksesan."
  },
  {
    "start": 27.71,
    "end": 29.9,
    "text": "Kegagalan adalah anak tangga yang"
  },
  {
    "start": 29.9,
    "end": 31.97,
    "text": "wajib kamu naiki untuk mencapai"
  },
  {
    "start": 31.97,
    "end": 34.17,
    "text": "kesuksesan itu sendiri."
  },
  {
    "start": 34.17,
    "end": 36.03,
    "text": "Setiap orang hebat yang kamu"
  },
  {
    "start": 36.03,
    "end": 37.76,
    "text": "kagumi di dunia ini pernah"
  },
  {
    "start": 37.76,
    "end": 41.03,
    "text": "mengalami kegagalan berkali-kali sebelum akhirnya"
  },
  {
    "start": 41.03,
    "end": 42.29,
    "text": "berhasil."
  },
  {
    "start": 42.29,
    "end": 44.56,
    "text": "Mereka tidak berhenti hanya karena"
  },
  {
    "start": 44.56,
    "end": 46.29,
    "text": "tersandung batu."
  },
  {
    "start": 46.29,
    "end": 48.09,
    "text": "Lebih baik kamu mencoba dan"
  },
  {
    "start": 48.09,
    "end": 50.62,
    "text": "belajar dari kegagalanmu dengan kepala"
  },
  {
    "start": 50.62,
    "end": 51.35,
    "text": "tegak,"
  },
  {
    "start": 51.35,
    "end": 53.55,
    "text": "daripada hidup aman tapi dihantui"
  },
  {
    "start": 53.55,
    "end": 55.81,
    "text": "penyesalan seumur hidup."
  },
  {
    "start": 55.81,
    "end": 58.94,
    "text": "Beranikan dirimu melangkah esok pagi."
  },
  {
    "start": 58.94,
    "end": 61.81,
    "text": "Percayalah pada kemampuan jiwamu."
  }
]