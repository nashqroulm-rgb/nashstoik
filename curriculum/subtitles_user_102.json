[
  {
    "start": 0.0,
    "end": 3.48,
    "text": "Obsesi berlebihan terhadap kesempurnaan seringkali"
  },
  {
    "start": 3.48,
    "end": 6.06,
    "text": "menjadi musuh terbesar dari kedamaian"
  },
  {
    "start": 6.06,
    "end": 8.63,
    "text": "dan kebahagiaan hidup kita."
  },
  {
    "start": 8.63,
    "end": 10.72,
    "text": "Kita menuntut rumah kita harus"
  },
  {
    "start": 10.72,
    "end": 12.53,
    "text": "selalu rapi sempurna,"
  },
  {
    "start": 12.53,
    "end": 15.11,
    "text": "pekerjaan kita harus tanpa cela,"
  },
  {
    "start": 15.11,
    "end": 17.2,
    "text": "dan pasangan kita harus selalu"
  },
  {
    "start": 17.2,
    "end": 20.06,
    "text": "memahami setiap keinginan kita."
  },
  {
    "start": 20.06,
    "end": 22.91,
    "text": "Padahal keindahan hidup yang sesungguhnya"
  },
  {
    "start": 22.91,
    "end": 25.9,
    "text": "justru terletak pada ketidaksempurnaan yang"
  },
  {
    "start": 25.9,
    "end": 28.97,
    "text": "dirawat dengan penuh kasih sayang."
  },
  {
    "start": 28.97,
    "end": 31.2,
    "text": "Ibarat seni tembikar Jepang kuno"
  },
  {
    "start": 31.2,
    "end": 33.77,
    "text": "yang menyambung pecahan mangkuk retak"
  },
  {
    "start": 33.77,
    "end": 35.45,
    "text": "dengan serbuk emas,"
  },
  {
    "start": 35.45,
    "end": 37.6,
    "text": "membuat mangkuk itu justru jauh"
  },
  {
    "start": 37.6,
    "end": 40.46,
    "text": "lebih bernilai dari sebelumnya."
  },
  {
    "start": 40.46,
    "end": 43.24,
    "text": "Belajarlah merangkul kekurangan yang ada"
  },
  {
    "start": 43.24,
    "end": 46.45,
    "text": "di sekitarmu dengan senyuman hangat."
  },
  {
    "start": 46.45,
    "end": 48.54,
    "text": "Kedamaian sejati ada pada hati"
  },
  {
    "start": 48.54,
    "end": 50.77,
    "text": "yang bisa mencintai hal-hal yang"
  },
  {
    "start": 50.77,
    "end": 52.51,
    "text": "tidak sempurna."
  }
]