[
  {
    "start": 0.0,
    "end": 2.76,
    "text": "Coba duduk sebentar dan renungkan kawan."
  },
  {
    "start": 3.32,
    "end": 5.09,
    "text": "Masalah yang hari ini"
  },
  {
    "start": 5.09,
    "end": 6.87,
    "text": "membuatmu pusing dan uring-uringan"
  },
  {
    "start": 6.87,
    "end": 8.64,
    "text": "seharian, kira-kira 5 tahun"
  },
  {
    "start": 8.64,
    "end": 10.42,
    "text": "lagi masih penting tidak?"
  },
  {
    "start": 10.98,
    "end": 12.66,
    "text": "Atau dendam yang kamu"
  },
  {
    "start": 12.66,
    "end": 14.34,
    "text": "simpan rapat terhadap seseorang"
  },
  {
    "start": 14.34,
    "end": 16.02,
    "text": "di masa lalu, sepadan"
  },
  {
    "start": 16.02,
    "end": 17.7,
    "text": "tidak dengan waktu hidupmu"
  },
  {
    "start": 17.7,
    "end": 19.38,
    "text": "yang terus berkurang setiap hari?"
  },
  {
    "start": 20.36,
    "end": 22.47,
    "text": "Sadar atau tidak, waktu kita"
  },
  {
    "start": 22.47,
    "end": 24.58,
    "text": "di dunia ini sangat terbatas."
  },
  {
    "start": 25.04,
    "end": 26.65,
    "text": "Kita tidak pernah tahu"
  },
  {
    "start": 26.65,
    "end": 28.26,
    "text": "kapan jatah hari kita habis."
  },
  {
    "start": 28.52,
    "end": 30.34,
    "text": "Sayang sekali kalau sisa"
  },
  {
    "start": 30.34,
    "end": 32.17,
    "text": "umur yang ada dipakai"
  },
  {
    "start": 32.17,
    "end": 33.99,
    "text": "cuma untuk berdebat, menuruti"
  },
  {
    "start": 33.99,
    "end": 35.82,
    "text": "gengsi, atau memendam rasa"
  },
  {
    "start": 35.82,
    "end": 37.64,
    "text": "iri pada keberuntungan orang lain."
  },
  {
    "start": 38.08,
    "end": 40.11,
    "text": "Hal-hal seperti itu cuma membuat"
  },
  {
    "start": 40.11,
    "end": 42.14,
    "text": "hidupmu sempit dan melelahkan batin."
  },
  {
    "start": 42.54,
    "end": 44.78,
    "text": "Gunakan energimu untuk hal yang nyata."
  },
  {
    "start": 45.18,
    "end": 46.54,
    "text": "Peluk keluargamu."
  },
  {
    "start": 46.86,
    "end": 49.0,
    "text": "Ajak bicara orang-orang yang kamu sayangi."
  },
  {
    "start": 49.32,
    "end": 51.71,
    "text": "Tertawalah bersama teman-teman baikmu"
  },
  {
    "start": 51.71,
    "end": 54.1,
    "text": "dan kerjakan apa yang bermanfaat."
  },
  {
    "start": 54.52,
    "end": 56.43,
    "text": "Saat kamu sadar betapa mahalnya"
  },
  {
    "start": 56.43,
    "end": 58.34,
    "text": "waktu yang kamu miliki, kamu"
  },
  {
    "start": 58.34,
    "end": 60.25,
    "text": "tidak bakal sudi lagi membuang-buangnya"
  },
  {
    "start": 60.25,
    "end": 62.16,
    "text": "untuk drama yang tidak penting."
  },
  {
    "start": 62.58,
    "end": 64.5,
    "text": "Hidup ini terlalu berharga untuk"
  },
  {
    "start": 64.5,
    "end": 66.42,
    "text": "dihabiskan dengan hati yang sempit."
  }
]