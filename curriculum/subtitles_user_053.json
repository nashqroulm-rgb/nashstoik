[
  {
    "start": 0.0,
    "end": 2.15,
    "text": "Malam ini badanmu mungkin terasa"
  },
  {
    "start": 2.15,
    "end": 3.35,
    "text": "sangat pegal,"
  },
  {
    "start": 3.35,
    "end": 4.56,
    "text": "matamu berat,"
  },
  {
    "start": 4.56,
    "end": 6.84,
    "text": "dan tenagamu terasa terkuras habis"
  },
  {
    "start": 6.84,
    "end": 9.59,
    "text": "setelah seharian bekerja keras."
  },
  {
    "start": 9.59,
    "end": 11.74,
    "text": "Tapi sebelum kamu mengeluh,"
  },
  {
    "start": 11.74,
    "end": 13.55,
    "text": "coba syukuri rasa lelah itu"
  },
  {
    "start": 13.55,
    "end": 14.76,
    "text": "sejenak."
  },
  {
    "start": 14.76,
    "end": 16.63,
    "text": "Rasa lelahmu hari ini adalah"
  },
  {
    "start": 16.63,
    "end": 18.51,
    "text": "bukti nyata bahwa kamu telah"
  },
  {
    "start": 18.51,
    "end": 19.99,
    "text": "seharian berguna,"
  },
  {
    "start": 19.99,
    "end": 22.33,
    "text": "kamu telah berjuang untuk menafkahi"
  },
  {
    "start": 22.33,
    "end": 24.62,
    "text": "orang-orang yang kamu cintai,"
  },
  {
    "start": 24.62,
    "end": 26.36,
    "text": "dan kamu telah berkarya di"
  },
  {
    "start": 26.36,
    "end": 27.7,
    "text": "dunia ini."
  },
  {
    "start": 27.7,
    "end": 29.71,
    "text": "Betapa banyak orang yang tidak"
  },
  {
    "start": 29.71,
    "end": 32.26,
    "text": "punya pekerjaan untuk dikerjakan,"
  },
  {
    "start": 32.26,
    "end": 34.54,
    "text": "betapa banyak orang yang terbaring"
  },
  {
    "start": 34.54,
    "end": 36.15,
    "text": "lemah di rumah sakit dan"
  },
  {
    "start": 36.15,
    "end": 39.3,
    "text": "merindukan rasa lelah karena bekerja."
  },
  {
    "start": 39.3,
    "end": 41.38,
    "text": "Rasa lelah fisik yang dilandasi"
  },
  {
    "start": 41.38,
    "end": 43.33,
    "text": "oleh niat tulus adalah sebuah"
  },
  {
    "start": 43.33,
    "end": 46.48,
    "text": "kehormatan bagi jiwa seorang pejuang."
  },
  {
    "start": 46.48,
    "end": 47.49,
    "text": "Malam ini,"
  },
  {
    "start": 47.49,
    "end": 50.17,
    "text": "izinkan tubuhmu beristirahat dengan rasa"
  },
  {
    "start": 50.17,
    "end": 51.31,
    "text": "bangga."
  },
  {
    "start": 51.31,
    "end": 53.46,
    "text": "Rehatkan ragamu yang setia,"
  },
  {
    "start": 53.46,
    "end": 55.67,
    "text": "besok energimu akan kembali pulih"
  },
  {
    "start": 55.67,
    "end": 57.55,
    "text": "seperti sediakala."
  }
]