[
  {
    "start": 0.0,
    "end": 2.87,
    "text": "Memiliki cita-cita tinggi untuk memperbaiki"
  },
  {
    "start": 2.87,
    "end": 5.34,
    "text": "taraf hidup keluarga adalah perbuatan"
  },
  {
    "start": 5.34,
    "end": 7.34,
    "text": "yang sangat terpuji."
  },
  {
    "start": 7.34,
    "end": 9.34,
    "text": "Tapi bahaya muncul saat ambisi"
  },
  {
    "start": 9.34,
    "end": 11.48,
    "text": "itu berubah menjadi rasa serakah"
  },
  {
    "start": 11.48,
    "end": 13.74,
    "text": "yang membuatmu lupa bersyukur atas"
  },
  {
    "start": 13.74,
    "end": 15.14,
    "text": "apa yang sudah ada di"
  },
  {
    "start": 15.14,
    "end": 17.21,
    "text": "genggamanmu saat ini."
  },
  {
    "start": 17.21,
    "end": 19.28,
    "text": "Kamu terus berlari mengejar apa"
  },
  {
    "start": 19.28,
    "end": 20.62,
    "text": "yang belum ada,"
  },
  {
    "start": 20.62,
    "end": 22.95,
    "text": "sampai kamu lupa menikmati senyuman"
  },
  {
    "start": 22.95,
    "end": 23.75,
    "text": "anakmu,"
  },
  {
    "start": 23.75,
    "end": 25.29,
    "text": "kesehatan tubuhmu,"
  },
  {
    "start": 25.29,
    "end": 27.29,
    "text": "dan hangatnya secangkir teh di"
  },
  {
    "start": 27.29,
    "end": 28.62,
    "text": "sore hari."
  },
  {
    "start": 28.62,
    "end": 31.09,
    "text": "Keseimbangan hidup sejati adalah saat"
  },
  {
    "start": 31.09,
    "end": 33.49,
    "text": "kakimu tetap giat melangkah mengejar"
  },
  {
    "start": 33.49,
    "end": 34.29,
    "text": "impian,"
  },
  {
    "start": 34.29,
    "end": 36.36,
    "text": "tapi hatimu selalu merasa cukup"
  },
  {
    "start": 36.36,
    "end": 38.03,
    "text": "dan damai dengan apa yang"
  },
  {
    "start": 38.03,
    "end": 39.56,
    "text": "ada hari ini."
  },
  {
    "start": 39.56,
    "end": 41.83,
    "text": "Kejarlah masa depanmu dengan kerja"
  },
  {
    "start": 41.83,
    "end": 42.57,
    "text": "keras,"
  },
  {
    "start": 42.57,
    "end": 45.03,
    "text": "tapi jangan gadaikan kebahagiaan saat"
  },
  {
    "start": 45.03,
    "end": 47.57,
    "text": "ini demi bayangan esok hari."
  }
]