[
  {
    "start": 0.0,
    "end": 2.72,
    "text": "Pernah tidak kamu merasa cemas seharian?"
  },
  {
    "start": 2.72,
    "end": 5.49,
    "text": "Padahal masalahnya belum tentu terjadi."
  },
  {
    "start": 5.49,
    "end": 7.82,
    "text": "Takut besok pekerjaan"
  },
  {
    "start": 7.82,
    "end": 10.15,
    "text": "bermasalah, takut usahamu gagal,"
  },
  {
    "start": 10.15,
    "end": 12.03,
    "text": "atau takut ditinggalkan oleh"
  },
  {
    "start": 12.03,
    "end": 13.91,
    "text": "orang yang kamu sayangi?"
  },
  {
    "start": 13.91,
    "end": 16.27,
    "text": "Rasa takut itu wajar kawan."
  },
  {
    "start": 16.27,
    "end": 18.55,
    "text": "Tapi kalau dibiarkan, kamu"
  },
  {
    "start": 18.55,
    "end": 20.84,
    "text": "bakal capek sendiri sebelum melangkah."
  },
  {
    "start": 20.84,
    "end": 24.16,
    "text": "Coba sesekali ajak batinmu bicara jujur."
  },
  {
    "start": 24.16,
    "end": 26.15,
    "text": "Seandainya hal paling"
  },
  {
    "start": 26.15,
    "end": 28.14,
    "text": "buruk yang kamu"
  },
  {
    "start": 28.14,
    "end": 30.13,
    "text": "takuti itu benar-benar terjadi besok,"
  },
  {
    "start": 30.13,
    "end": 31.34,
    "text": "apakah hidupmu langsung"
  },
  {
    "start": 31.34,
    "end": 32.55,
    "text": "berakhir saat itu juga?"
  },
  {
    "start": 32.55,
    "end": 35.17,
    "text": "Kenyataannya tidak seperti itu."
  },
  {
    "start": 35.17,
    "end": 37.89,
    "text": "Kamu mungkin bakal repot sebentar,"
  },
  {
    "start": 37.89,
    "end": 39.81,
    "text": "kamu mungkin bakal sedih,"
  },
  {
    "start": 39.81,
    "end": 41.48,
    "text": "tapi kamu pasti punya"
  },
  {
    "start": 41.48,
    "end": 43.16,
    "text": "daya tahan untuk melewatinya."
  },
  {
    "start": 43.16,
    "end": 45.47,
    "text": "Jiwamu jauh lebih tangguh dari"
  },
  {
    "start": 45.47,
    "end": 47.78,
    "text": "apa yang ada di kepalamu."
  },
  {
    "start": 47.78,
    "end": 49.31,
    "text": "Sebagian besar ketakutan"
  },
  {
    "start": 49.31,
    "end": 50.84,
    "text": "kita cuma hidup"
  },
  {
    "start": 50.84,
    "end": 52.37,
    "text": "di pikiran, bukan di kenyataan."
  },
  {
    "start": 52.37,
    "end": 54.72,
    "text": "Kita sering menderita duluan gara-gara"
  },
  {
    "start": 54.72,
    "end": 57.06,
    "text": "bayangan yang kita buat sendiri."
  },
  {
    "start": 57.06,
    "end": 59.27,
    "text": "Tarik nafas dalam-dalam."
  },
  {
    "start": 59.27,
    "end": 67.93,
    "text": "Berhentilah meramal hari esok"
  },
  {
    "start": 67.93,
    "end": 76.59,
    "text": "dengan rasa panik, jalani"
  },
  {
    "start": 76.59,
    "end": 85.26,
    "text": "saja apa yang ada"
  },
  {
    "start": 85.26,
    "end": 93.92,
    "text": "di depan matamu hari"
  },
  {
    "start": 93.92,
    "end": 102.58,
    "text": "ini satu persatu dengan hati yang tenang."
  }
]