[
  {
    "start": 0.0,
    "end": 1.21,
    "text": "Pada akhirnya,"
  },
  {
    "start": 1.21,
    "end": 2.87,
    "text": "ketika waktu kita di dunia"
  },
  {
    "start": 2.87,
    "end": 4.34,
    "text": "ini sudah selesai,"
  },
  {
    "start": 4.34,
    "end": 6.12,
    "text": "apa yang paling akan diingat"
  },
  {
    "start": 6.12,
    "end": 8.8,
    "text": "oleh orang-orang dari diri kita?"
  },
  {
    "start": 8.8,
    "end": 10.65,
    "text": "Bukan merek mobil yang pernah"
  },
  {
    "start": 10.65,
    "end": 11.86,
    "text": "kita kendarai,"
  },
  {
    "start": 11.86,
    "end": 13.71,
    "text": "bukan luasnya rumah yang kita"
  },
  {
    "start": 13.71,
    "end": 14.48,
    "text": "miliki,"
  },
  {
    "start": 14.48,
    "end": 16.33,
    "text": "dan bukan saldo tabungan yang"
  },
  {
    "start": 16.33,
    "end": 17.98,
    "text": "kita tinggalkan."
  },
  {
    "start": 17.98,
    "end": 19.58,
    "text": "Hal yang paling abadi dan"
  },
  {
    "start": 19.58,
    "end": 21.3,
    "text": "membekas di hati orang lain"
  },
  {
    "start": 21.3,
    "end": 24.11,
    "text": "adalah bagaimana caramu memperlakukan mereka"
  },
  {
    "start": 24.11,
    "end": 26.34,
    "text": "saat mereka sedang susah."
  },
  {
    "start": 26.34,
    "end": 28.51,
    "text": "Seberapa hangat tutur katamu,"
  },
  {
    "start": 28.51,
    "end": 30.48,
    "text": "seberapa jujur perilakumu,"
  },
  {
    "start": 30.48,
    "end": 32.53,
    "text": "dan seberapa banyak beban mereka"
  },
  {
    "start": 32.53,
    "end": 35.01,
    "text": "yang berhasil kamu ringankan."
  },
  {
    "start": 35.01,
    "end": 36.93,
    "text": "Kebaikan kecil yang kamu tabur"
  },
  {
    "start": 36.93,
    "end": 38.58,
    "text": "dengan tulus hari ini akan"
  },
  {
    "start": 38.58,
    "end": 41.07,
    "text": "terus beresonansi di alam semesta,"
  },
  {
    "start": 41.07,
    "end": 43.69,
    "text": "bahkan jauh setelah kamu tiada."
  },
  {
    "start": 43.69,
    "end": 45.79,
    "text": "Hiduplah bukan hanya untuk dirimu"
  },
  {
    "start": 45.79,
    "end": 47.32,
    "text": "sendiri kawan."
  },
  {
    "start": 47.32,
    "end": 49.55,
    "text": "Tinggalkan jejak kebaikan di setiap"
  },
  {
    "start": 49.55,
    "end": 51.34,
    "text": "hati manusia yang kamu temui"
  },
  {
    "start": 51.34,
    "end": 53.32,
    "text": "di sepanjang jalanmu."
  }
]