[
  {
    "start": 0.0,
    "end": 1.64,
    "text": "Malam ini genap tiga puluh"
  },
  {
    "start": 1.64,
    "end": 3.73,
    "text": "lima hari perjalanan kita melatih"
  },
  {
    "start": 3.73,
    "end": 5.37,
    "text": "ketahanan batin."
  },
  {
    "start": 5.37,
    "end": 6.89,
    "text": "Sebelum kamu tidur,"
  },
  {
    "start": 6.89,
    "end": 8.92,
    "text": "coba lihat kembali peristiwa apa"
  },
  {
    "start": 8.92,
    "end": 10.94,
    "text": "saja yang terjadi selama sepekan"
  },
  {
    "start": 10.94,
    "end": 11.82,
    "text": "ini."
  },
  {
    "start": 11.82,
    "end": 13.47,
    "text": "Ada berapa banyak hal yang"
  },
  {
    "start": 13.47,
    "end": 15.3,
    "text": "awalnya membuatmu cemas,"
  },
  {
    "start": 15.3,
    "end": 17.39,
    "text": "tapi ternyata berhasil kamu lalui"
  },
  {
    "start": 17.39,
    "end": 18.97,
    "text": "dengan selamat?"
  },
  {
    "start": 18.97,
    "end": 21.18,
    "text": "Seringkali kita lupa bersyukur atas"
  },
  {
    "start": 21.18,
    "end": 23.84,
    "text": "kekuatan yang sudah kita miliki."
  },
  {
    "start": 23.84,
    "end": 25.54,
    "text": "Kita terlalu fokus pada apa"
  },
  {
    "start": 25.54,
    "end": 27.25,
    "text": "yang belum kita capai,"
  },
  {
    "start": 27.25,
    "end": 29.34,
    "text": "sampai lupa melihat seberapa jauh"
  },
  {
    "start": 29.34,
    "end": 31.23,
    "text": "kita sudah melangkah dari masa"
  },
  {
    "start": 31.23,
    "end": 32.18,
    "text": "lalu."
  },
  {
    "start": 32.18,
    "end": 33.89,
    "text": "Kamu masih berdiri tegak di"
  },
  {
    "start": 33.89,
    "end": 35.47,
    "text": "sini malam ini."
  },
  {
    "start": 35.47,
    "end": 37.24,
    "text": "Itu adalah bukti nyata bahwa"
  },
  {
    "start": 37.24,
    "end": 39.01,
    "text": "kamu jauh lebih tangguh dari"
  },
  {
    "start": 39.01,
    "end": 42.05,
    "text": "segala ujian yang datang menghantammu."
  },
  {
    "start": 42.05,
    "end": 44.01,
    "text": "Tarik napas panjang dengan rasa"
  },
  {
    "start": 44.01,
    "end": 46.35,
    "text": "terima kasih yang mendalam."
  },
  {
    "start": 46.35,
    "end": 48.5,
    "text": "Maafkan semua lelah dan kekurangan"
  },
  {
    "start": 48.5,
    "end": 49.89,
    "text": "sepekan ini."
  },
  {
    "start": 49.89,
    "end": 52.1,
    "text": "Tidurlah dengan nyenyak kawan,"
  },
  {
    "start": 52.1,
    "end": 54.76,
    "text": "jiwamu pantas mendapatkan ketenangan malam"
  },
  {
    "start": 54.76,
    "end": 55.64,
    "text": "ini."
  }
]