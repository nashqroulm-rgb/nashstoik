[
  {
    "start": 0.0,
    "end": 2.68,
    "text": "Kemewahan seringkali menjadi jebakan yang"
  },
  {
    "start": 2.68,
    "end": 5.43,
    "text": "membungkus kebebasan manusia dengan rantai"
  },
  {
    "start": 5.43,
    "end": 7.33,
    "text": "emas yang berkilau."
  },
  {
    "start": 7.33,
    "end": 9.43,
    "text": "Semakin mewah gaya hidupmu,"
  },
  {
    "start": 9.43,
    "end": 11.46,
    "text": "semakin banyak biaya yang harus"
  },
  {
    "start": 11.46,
    "end": 12.7,
    "text": "kamu tanggung,"
  },
  {
    "start": 12.7,
    "end": 14.53,
    "text": "dan semakin keras kamu harus"
  },
  {
    "start": 14.53,
    "end": 16.96,
    "text": "bekerja membanting tulang hanya untuk"
  },
  {
    "start": 16.96,
    "end": 19.64,
    "text": "mempertahankan gengsi tersebut."
  },
  {
    "start": 19.64,
    "end": 22.19,
    "text": "Orang-orang bijak sengaja memilih hidup"
  },
  {
    "start": 22.19,
    "end": 24.49,
    "text": "bersahaja bukan karena mereka tidak"
  },
  {
    "start": 24.49,
    "end": 25.21,
    "text": "mampu,"
  },
  {
    "start": 25.21,
    "end": 27.82,
    "text": "melainkan karena mereka sangat mencintai"
  },
  {
    "start": 27.82,
    "end": 29.92,
    "text": "kebebasan jiwa mereka."
  },
  {
    "start": 29.92,
    "end": 31.82,
    "text": "Saat kamu bisa merasa bahagia"
  },
  {
    "start": 31.82,
    "end": 34.11,
    "text": "dengan hal-hal yang sederhana,"
  },
  {
    "start": 34.11,
    "end": 35.68,
    "text": "tidak ada satu pun orang"
  },
  {
    "start": 35.68,
    "end": 37.12,
    "text": "di dunia ini yang bisa"
  },
  {
    "start": 37.12,
    "end": 40.4,
    "text": "memperbudakmu dengan iming-iming materi."
  },
  {
    "start": 40.4,
    "end": 41.38,
    "text": "Malam ini,"
  },
  {
    "start": 41.38,
    "end": 44.59,
    "text": "lihatlah kebutuhan aslimu secara jujur."
  },
  {
    "start": 44.59,
    "end": 46.55,
    "text": "Lepaskan beban gaya hidup yang"
  },
  {
    "start": 46.55,
    "end": 48.12,
    "text": "membebani pundakmu,"
  },
  {
    "start": 48.12,
    "end": 50.22,
    "text": "dan rasakan nikmatnya hidup yang"
  },
  {
    "start": 50.22,
    "end": 52.11,
    "text": "ringan dan merdeka."
  }
]