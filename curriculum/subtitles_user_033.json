[
  {
    "start": 0.0,
    "end": 2.22,
    "text": "Banyak orang sangat takut sendirian"
  },
  {
    "start": 2.22,
    "end": 3.81,
    "text": "di dalam kamar."
  },
  {
    "start": 3.81,
    "end": 6.66,
    "text": "Mereka harus selalu menyalakan televisi,"
  },
  {
    "start": 6.66,
    "end": 8.63,
    "text": "memutar musik keras-keras,"
  },
  {
    "start": 8.63,
    "end": 10.53,
    "text": "atau sibuk mengobrol di ponsel"
  },
  {
    "start": 10.53,
    "end": 13.33,
    "text": "hanya untuk menghindari kesunyian."
  },
  {
    "start": 13.33,
    "end": 15.17,
    "text": "Mereka takut sepi karena saat"
  },
  {
    "start": 15.17,
    "end": 16.31,
    "text": "sunyi datang,"
  },
  {
    "start": 16.31,
    "end": 18.72,
    "text": "pikiran-pikiran yang selama ini mereka"
  },
  {
    "start": 18.72,
    "end": 20.5,
    "text": "kubur akan mulai bersuara di"
  },
  {
    "start": 20.5,
    "end": 21.58,
    "text": "kepala."
  },
  {
    "start": 21.58,
    "end": 23.29,
    "text": "Tapi ketahuilah kawan,"
  },
  {
    "start": 23.29,
    "end": 25.26,
    "text": "ada perbedaan yang sangat besar"
  },
  {
    "start": 25.26,
    "end": 27.54,
    "text": "antara merasa kesepian dan menikmati"
  },
  {
    "start": 27.54,
    "end": 28.81,
    "text": "kesunyian."
  },
  {
    "start": 28.81,
    "end": 30.72,
    "text": "Kesunyian adalah ruang suci di"
  },
  {
    "start": 30.72,
    "end": 32.87,
    "text": "mana jiwamu bisa beristirahat dari"
  },
  {
    "start": 32.87,
    "end": 34.9,
    "text": "kebisingan dunia luar."
  },
  {
    "start": 34.9,
    "end": 36.87,
    "text": "Di dalam keheningan itulah kamu"
  },
  {
    "start": 36.87,
    "end": 39.03,
    "text": "bisa mendengar apa yang sebenarnya"
  },
  {
    "start": 39.03,
    "end": 40.81,
    "text": "diinginkan oleh hatimu,"
  },
  {
    "start": 40.81,
    "end": 43.15,
    "text": "tanpa terdistorsi oleh tuntutan orang"
  },
  {
    "start": 43.15,
    "end": 44.11,
    "text": "lain."
  },
  {
    "start": 44.11,
    "end": 45.06,
    "text": "Malam ini,"
  },
  {
    "start": 45.06,
    "end": 48.04,
    "text": "jangan takut pada keheningan kamarmu."
  },
  {
    "start": 48.04,
    "end": 50.39,
    "text": "Jadikan kesunyian itu sebagai sahabat"
  },
  {
    "start": 50.39,
    "end": 52.74,
    "text": "terbaikmu untuk menyembuhkan luka dan"
  },
  {
    "start": 52.74,
    "end": 54.83,
    "text": "mengisi ulang energimu."
  }
]