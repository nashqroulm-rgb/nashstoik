[
  {
    "start": 0.0,
    "end": 2.24,
    "text": "Banyak orang bermimpi ingin pindah"
  },
  {
    "start": 2.24,
    "end": 4.28,
    "text": "ke pulau terpencil atau tinggal"
  },
  {
    "start": 4.28,
    "end": 6.18,
    "text": "di puncak gunung demi mencari"
  },
  {
    "start": 6.18,
    "end": 7.96,
    "text": "ketenangan hidup."
  },
  {
    "start": 7.96,
    "end": 10.59,
    "text": "Mereka mengira ketenangan adalah kondisi"
  },
  {
    "start": 10.59,
    "end": 13.03,
    "text": "geografis yang ditentukan oleh tempat"
  },
  {
    "start": 13.03,
    "end": 14.67,
    "text": "tinggal mereka."
  },
  {
    "start": 14.67,
    "end": 16.45,
    "text": "Tapi ketahuilah kawan,"
  },
  {
    "start": 16.45,
    "end": 17.9,
    "text": "ke mana pun kamu pergi"
  },
  {
    "start": 17.9,
    "end": 19.28,
    "text": "membawa tubuhmu,"
  },
  {
    "start": 19.28,
    "end": 21.38,
    "text": "kamu akan selalu membawa pikiran"
  },
  {
    "start": 21.38,
    "end": 24.02,
    "text": "dan batinmu sendiri bersamamu."
  },
  {
    "start": 24.02,
    "end": 25.79,
    "text": "Jika batinmu di dalam masih"
  },
  {
    "start": 25.79,
    "end": 27.31,
    "text": "dipenuhi rasa iri,"
  },
  {
    "start": 27.31,
    "end": 28.1,
    "text": "amarah,"
  },
  {
    "start": 28.1,
    "end": 29.54,
    "text": "dan kekhawatiran,"
  },
  {
    "start": 29.54,
    "end": 31.25,
    "text": "maka di puncak gunung yang"
  },
  {
    "start": 31.25,
    "end": 32.96,
    "text": "paling sunyi pun kamu akan"
  },
  {
    "start": 32.96,
    "end": 35.0,
    "text": "tetap merasa gelisah."
  },
  {
    "start": 35.0,
    "end": 37.24,
    "text": "Ketenangan sejati adalah saat kamu"
  },
  {
    "start": 37.24,
    "end": 39.61,
    "text": "mampu menemukan keheningan di tengah"
  },
  {
    "start": 39.61,
    "end": 41.52,
    "text": "pasar yang riuh dan kemacetan"
  },
  {
    "start": 41.52,
    "end": 43.23,
    "text": "kota yang padat."
  },
  {
    "start": 43.23,
    "end": 45.27,
    "text": "Bangunlah kuil kedamaian itu di"
  },
  {
    "start": 45.27,
    "end": 47.31,
    "text": "dalam dadamu sendiri."
  }
]