[
  {
    "start": 0.0,
    "end": 2.56,
    "text": "Banyak orang mengira kesabaran adalah"
  },
  {
    "start": 2.56,
    "end": 4.43,
    "text": "sikap pasrah yang lemah dan"
  },
  {
    "start": 4.43,
    "end": 8.11,
    "text": "membiarkan diri diinjak-injak oleh keadaan."
  },
  {
    "start": 8.11,
    "end": 10.32,
    "text": "Itu adalah pemahaman yang sangat"
  },
  {
    "start": 10.32,
    "end": 11.5,
    "text": "keliru."
  },
  {
    "start": 11.5,
    "end": 14.21,
    "text": "Kesabaran sejati adalah bentuk kekuatan"
  },
  {
    "start": 14.21,
    "end": 16.08,
    "text": "batin yang paling tinggi di"
  },
  {
    "start": 16.08,
    "end": 17.46,
    "text": "muka bumi."
  },
  {
    "start": 17.46,
    "end": 19.96,
    "text": "Sabar adalah kemampuanmu untuk tetap"
  },
  {
    "start": 19.96,
    "end": 21.97,
    "text": "tenang menahan diri saat kamu"
  },
  {
    "start": 21.97,
    "end": 24.18,
    "text": "punya kekuatan untuk marah,"
  },
  {
    "start": 24.18,
    "end": 26.68,
    "text": "dan kemampuanmu untuk terus berjuang"
  },
  {
    "start": 26.68,
    "end": 28.76,
    "text": "saat semua hal tampak berjalan"
  },
  {
    "start": 28.76,
    "end": 29.93,
    "text": "lambat."
  },
  {
    "start": 29.93,
    "end": 32.57,
    "text": "Kesabaran adalah keyakinan teguh bahwa"
  },
  {
    "start": 32.57,
    "end": 34.72,
    "text": "segala benih kebaikan yang kamu"
  },
  {
    "start": 34.72,
    "end": 37.63,
    "text": "tanam dengan sungguh-sungguh pada akhirnya"
  },
  {
    "start": 37.63,
    "end": 39.64,
    "text": "pasti akan berbuah manis pada"
  },
  {
    "start": 39.64,
    "end": 40.95,
    "text": "waktunya."
  },
  {
    "start": 40.95,
    "end": 43.45,
    "text": "Jangan terburu-buru kawan."
  },
  {
    "start": 43.45,
    "end": 46.29,
    "text": "Tanamkan kesabaranmu dalam-dalam di dalam"
  },
  {
    "start": 46.29,
    "end": 46.98,
    "text": "dada,"
  },
  {
    "start": 46.98,
    "end": 49.48,
    "text": "dan biarkan proses alami menuntaskan"
  },
  {
    "start": 49.48,
    "end": 51.07,
    "text": "keajaibannya."
  }
]