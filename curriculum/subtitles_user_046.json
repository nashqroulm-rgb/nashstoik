[
  {
    "start": 0.0,
    "end": 2.27,
    "text": "Sangat mudah untuk bersikap jujur"
  },
  {
    "start": 2.27,
    "end": 4.41,
    "text": "dan bermartabat saat semua mata"
  },
  {
    "start": 4.41,
    "end": 6.96,
    "text": "sedang memandang ke arahmu."
  },
  {
    "start": 6.96,
    "end": 9.31,
    "text": "Tapi ukuran sejati dari integritas"
  },
  {
    "start": 9.31,
    "end": 11.24,
    "text": "batinmu adalah apa yang kamu"
  },
  {
    "start": 11.24,
    "end": 13.3,
    "text": "lakukan saat kamu sendirian di"
  },
  {
    "start": 13.3,
    "end": 14.89,
    "text": "dalam kamar gelap,"
  },
  {
    "start": 14.89,
    "end": 16.41,
    "text": "di mana tidak ada satu"
  },
  {
    "start": 16.41,
    "end": 18.27,
    "text": "pun orang yang melihat atau"
  },
  {
    "start": 18.27,
    "end": 19.92,
    "text": "mengetahuinya."
  },
  {
    "start": 19.92,
    "end": 21.85,
    "text": "Apakah kamu tetap jujur saat"
  },
  {
    "start": 21.85,
    "end": 24.06,
    "text": "ada peluang untuk berbuat curang"
  },
  {
    "start": 24.06,
    "end": 25.78,
    "text": "tanpa ketahuan?"
  },
  {
    "start": 25.78,
    "end": 27.99,
    "text": "Apakah kamu tetap menepati janji"
  },
  {
    "start": 27.99,
    "end": 29.71,
    "text": "saat tidak ada saksi yang"
  },
  {
    "start": 29.71,
    "end": 31.23,
    "text": "mengawasimu?"
  },
  {
    "start": 31.23,
    "end": 33.71,
    "text": "Mungkin kamu bisa membohongi seluruh"
  },
  {
    "start": 33.71,
    "end": 35.36,
    "text": "orang di dunia ini,"
  },
  {
    "start": 35.36,
    "end": 37.22,
    "text": "tapi kamu tidak akan pernah"
  },
  {
    "start": 37.22,
    "end": 40.53,
    "text": "bisa membohongi hati nuranimu sendiri."
  },
  {
    "start": 40.53,
    "end": 42.74,
    "text": "Tidur yang paling nyenyak adalah"
  },
  {
    "start": 42.74,
    "end": 45.08,
    "text": "tidurnya orang yang hatinya bersih"
  },
  {
    "start": 45.08,
    "end": 47.91,
    "text": "dari kebohongan dan kecurangan."
  },
  {
    "start": 47.91,
    "end": 50.87,
    "text": "Jagalah kejujuranmu seperti menjaga nyawamu"
  },
  {
    "start": 50.87,
    "end": 52.11,
    "text": "sendiri."
  }
]