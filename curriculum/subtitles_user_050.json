[
  {
    "start": 0.0,
    "end": 2.67,
    "text": "Pernahkah kamu memperhatikan bagaimana air"
  },
  {
    "start": 2.67,
    "end": 4.82,
    "text": "sungai mengalir di antara bebatuan"
  },
  {
    "start": 4.82,
    "end": 6.86,
    "text": "yang besar dan terjal?"
  },
  {
    "start": 6.86,
    "end": 8.89,
    "text": "Ketika air sungai membentur batu"
  },
  {
    "start": 8.89,
    "end": 10.35,
    "text": "karang yang kokoh,"
  },
  {
    "start": 10.35,
    "end": 12.25,
    "text": "dia tidak pernah memaksa untuk"
  },
  {
    "start": 12.25,
    "end": 14.47,
    "text": "menabrak dan menghancurkan batu itu"
  },
  {
    "start": 14.47,
    "end": 16.0,
    "text": "dengan amarah."
  },
  {
    "start": 16.0,
    "end": 17.01,
    "text": "Sebaliknya,"
  },
  {
    "start": 17.01,
    "end": 19.3,
    "text": "air sungai mengalir lentur mengitari"
  },
  {
    "start": 19.3,
    "end": 20.5,
    "text": "batu tersebut,"
  },
  {
    "start": 20.5,
    "end": 22.34,
    "text": "lalu terus melaju ke samudera"
  },
  {
    "start": 22.34,
    "end": 23.3,
    "text": "luas."
  },
  {
    "start": 23.3,
    "end": 25.65,
    "text": "Belajarlah menjadi lentur seperti air"
  },
  {
    "start": 25.65,
    "end": 26.66,
    "text": "kawan."
  },
  {
    "start": 26.66,
    "end": 29.07,
    "text": "Jangan keras kepala memaksakan keadaan"
  },
  {
    "start": 29.07,
    "end": 31.1,
    "text": "harus selalu tunduk pada kemauan"
  },
  {
    "start": 31.1,
    "end": 32.37,
    "text": "pribadimu."
  },
  {
    "start": 32.37,
    "end": 35.04,
    "text": "Ketika ada rintangan yang menghadang,"
  },
  {
    "start": 35.04,
    "end": 36.88,
    "text": "jangan patah dan jangan putus"
  },
  {
    "start": 36.88,
    "end": 37.77,
    "text": "asa."
  },
  {
    "start": 37.77,
    "end": 39.93,
    "text": "Beradaptasilah dengan cerdas,"
  },
  {
    "start": 39.93,
    "end": 41.58,
    "text": "cari jalan lain yang lebih"
  },
  {
    "start": 41.58,
    "end": 42.28,
    "text": "bijak,"
  },
  {
    "start": 42.28,
    "end": 44.5,
    "text": "dan tetaplah mengalir menuju tujuan"
  },
  {
    "start": 44.5,
    "end": 45.64,
    "text": "muliamu."
  },
  {
    "start": 45.64,
    "end": 48.24,
    "text": "Kekuatan sejati bukanlah tentang seberapa"
  },
  {
    "start": 48.24,
    "end": 49.77,
    "text": "keras kamu memukul,"
  },
  {
    "start": 49.77,
    "end": 52.31,
    "text": "melainkan tentang seberapa lentur jiwamu"
  },
  {
    "start": 52.31,
    "end": 55.8,
    "text": "beradaptasi dengan setiap tikungan kehidupan."
  }
]