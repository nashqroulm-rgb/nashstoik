[
  {
    "start": 0.0,
    "end": 1.87,
    "text": "Empat belas pekan sudah kita"
  },
  {
    "start": 1.87,
    "end": 5.4,
    "text": "mengarungi samudera batin ini bersama-sama."
  },
  {
    "start": 5.4,
    "end": 8.21,
    "text": "Lihatlah bagaimana kompas batinmu sekarang"
  },
  {
    "start": 8.21,
    "end": 9.41,
    "text": "bekerja."
  },
  {
    "start": 9.41,
    "end": 11.48,
    "text": "Jarum kompasmu sudah tidak lagi"
  },
  {
    "start": 11.48,
    "end": 13.95,
    "text": "mudah terpengaruh oleh tarikan magnet"
  },
  {
    "start": 13.95,
    "end": 15.81,
    "text": "opini orang lain atau godaan"
  },
  {
    "start": 15.81,
    "end": 17.68,
    "text": "kenyamanan sesaat."
  },
  {
    "start": 17.68,
    "end": 19.68,
    "text": "Arah hidupmu kini sudah jelas:"
  },
  {
    "start": 19.68,
    "end": 21.62,
    "text": "menuju ketenangan batin,"
  },
  {
    "start": 21.62,
    "end": 23.22,
    "text": "integritas pribadi,"
  },
  {
    "start": 23.22,
    "end": 25.22,
    "text": "dan pengabdian yang tulus bagi"
  },
  {
    "start": 25.22,
    "end": 26.36,
    "text": "sesama."
  },
  {
    "start": 26.36,
    "end": 29.03,
    "text": "Betapa pun pekatnya kabut ketidakpastian"
  },
  {
    "start": 29.03,
    "end": 30.43,
    "text": "di depan matamu,"
  },
  {
    "start": 30.43,
    "end": 33.1,
    "text": "teruslah melangkah maju dengan keyakinan"
  },
  {
    "start": 33.1,
    "end": 34.5,
    "text": "yang teguh."
  },
  {
    "start": 34.5,
    "end": 36.63,
    "text": "Batin yang tenang adalah pemandu"
  },
  {
    "start": 36.63,
    "end": 38.9,
    "text": "jalan yang paling setia."
  },
  {
    "start": 38.9,
    "end": 39.9,
    "text": "Malam ini,"
  },
  {
    "start": 39.9,
    "end": 42.17,
    "text": "rehatkan jiwamu dengan rasa syukur"
  },
  {
    "start": 42.17,
    "end": 43.77,
    "text": "yang mendalam."
  },
  {
    "start": 43.77,
    "end": 46.78,
    "text": "Tidurlah dalam naungan kedamaian sejati,"
  },
  {
    "start": 46.78,
    "end": 48.58,
    "text": "esok adalah hari yang penuh"
  },
  {
    "start": 48.58,
    "end": 49.71,
    "text": "berkah."
  }
]