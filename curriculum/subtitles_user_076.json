[
  {
    "start": 0.0,
    "end": 1.74,
    "text": "Ada hari-hari di mana dari"
  },
  {
    "start": 1.74,
    "end": 3.94,
    "text": "pagi sampai malam semuanya terasa"
  },
  {
    "start": 3.94,
    "end": 6.02,
    "text": "salah dan berantakan."
  },
  {
    "start": 6.02,
    "end": 8.22,
    "text": "Pagi hari ban motormu bocor,"
  },
  {
    "start": 8.22,
    "end": 11.16,
    "text": "siang hari pekerjaanmu dimarahi atasan,"
  },
  {
    "start": 11.16,
    "end": 13.44,
    "text": "dan sore hari rencanamu dibatalkan"
  },
  {
    "start": 13.44,
    "end": 14.64,
    "text": "sepihak."
  },
  {
    "start": 14.64,
    "end": 18.25,
    "text": "Rasanya dunia sedang bersekongkol melawanmu."
  },
  {
    "start": 18.25,
    "end": 20.92,
    "text": "Tarik napas dalam-dalam kawan."
  },
  {
    "start": 20.92,
    "end": 23.0,
    "text": "Mengalami hari yang buruk bukan"
  },
  {
    "start": 23.0,
    "end": 25.47,
    "text": "berarti hidupmu adalah kehidupan yang"
  },
  {
    "start": 25.47,
    "end": 26.54,
    "text": "buruk."
  },
  {
    "start": 26.54,
    "end": 28.75,
    "text": "Hari yang melelahkan ini hanyalah"
  },
  {
    "start": 28.75,
    "end": 30.75,
    "text": "satu lembar halaman kecil dari"
  },
  {
    "start": 30.75,
    "end": 33.16,
    "text": "sebuah buku tebal perjalanan hidupmu"
  },
  {
    "start": 33.16,
    "end": 34.56,
    "text": "yang indah."
  },
  {
    "start": 34.56,
    "end": 36.57,
    "text": "Lembaran buruk ini akan segera"
  },
  {
    "start": 36.57,
    "end": 38.37,
    "text": "ditutup malam ini saat kamu"
  },
  {
    "start": 38.37,
    "end": 40.11,
    "text": "memejamkan mata."
  },
  {
    "start": 40.11,
    "end": 41.92,
    "text": "Jangan bawa rasa kesal hari"
  },
  {
    "start": 41.92,
    "end": 44.12,
    "text": "ini masuk ke hari esok."
  },
  {
    "start": 44.12,
    "end": 46.26,
    "text": "Mandilah dengan air hangat,"
  },
  {
    "start": 46.26,
    "end": 48.53,
    "text": "lupakan kekacauan tadi siang,"
  },
  {
    "start": 48.53,
    "end": 51.41,
    "text": "dan tidurlah dengan harapan baru."
  }
]