[
  {
    "start": 0.0,
    "end": 1.93,
    "text": "Pernah tidak kamu merasa patah"
  },
  {
    "start": 1.93,
    "end": 4.12,
    "text": "semangat melakukan hal baik,"
  },
  {
    "start": 4.12,
    "end": 6.05,
    "text": "cuma gara-gara tidak ada orang"
  },
  {
    "start": 6.05,
    "end": 9.13,
    "text": "yang memuji atau menghargai usahamu?"
  },
  {
    "start": 9.13,
    "end": 12.16,
    "text": "Kita seringkali menggantungkan kebahagiaan kita"
  },
  {
    "start": 12.16,
    "end": 14.15,
    "text": "pada tepuk tangan dan pengakuan"
  },
  {
    "start": 14.15,
    "end": 15.95,
    "text": "dari dunia luar."
  },
  {
    "start": 15.95,
    "end": 18.39,
    "text": "Saat dipuji kita terbang tinggi,"
  },
  {
    "start": 18.39,
    "end": 20.52,
    "text": "tapi saat diabaikan kita langsung"
  },
  {
    "start": 20.52,
    "end": 22.7,
    "text": "merasa tidak berharga."
  },
  {
    "start": 22.7,
    "end": 25.15,
    "text": "Tarik napas sejenak kawan."
  },
  {
    "start": 25.15,
    "end": 27.4,
    "text": "Renungkan kembali mengapa dari awal"
  },
  {
    "start": 27.4,
    "end": 29.97,
    "text": "kamu memulai perjuangan ini."
  },
  {
    "start": 29.97,
    "end": 32.61,
    "text": "Orang-orang bijak selalu menaruh kepuasan"
  },
  {
    "start": 32.61,
    "end": 34.67,
    "text": "batin mereka pada kualitas usaha"
  },
  {
    "start": 34.67,
    "end": 37.3,
    "text": "dan kejujuran kerja mereka sendiri,"
  },
  {
    "start": 37.3,
    "end": 39.1,
    "text": "bukan pada riuh tepuk tangan"
  },
  {
    "start": 39.1,
    "end": 40.45,
    "text": "penonton."
  },
  {
    "start": 40.45,
    "end": 42.26,
    "text": "Hasil akhir dan pujian orang"
  },
  {
    "start": 42.26,
    "end": 44.38,
    "text": "lain itu di luar kendalimu,"
  },
  {
    "start": 44.38,
    "end": 46.37,
    "text": "tapi dedikasi dan kerja kerasmu"
  },
  {
    "start": 46.37,
    "end": 48.88,
    "text": "sepenuhnya ada di tanganmu."
  },
  {
    "start": 48.88,
    "end": 51.39,
    "text": "Bekerjalah seperti matahari yang terbit"
  },
  {
    "start": 51.39,
    "end": 52.93,
    "text": "setiap pagi."
  },
  {
    "start": 52.93,
    "end": 54.93,
    "text": "Dia menyinari bumi dengan setia"
  },
  {
    "start": 54.93,
    "end": 56.66,
    "text": "dan penuh kehangatan,"
  },
  {
    "start": 56.66,
    "end": 58.78,
    "text": "tanpa pernah menuntut pujian dari"
  },
  {
    "start": 58.78,
    "end": 60.2,
    "text": "siapa pun."
  },
  {
    "start": 60.2,
    "end": 62.06,
    "text": "Lakukan yang terbaik hari ini"
  },
  {
    "start": 62.06,
    "end": 64.32,
    "text": "dengan hati yang tulus."
  },
  {
    "start": 64.32,
    "end": 66.31,
    "text": "Kepuasan sejati lahir saat kamu"
  },
  {
    "start": 66.31,
    "end": 68.3,
    "text": "tahu kamu sudah berjuang dengan"
  },
  {
    "start": 68.3,
    "end": 70.43,
    "text": "segenap integritasmu."
  }
]