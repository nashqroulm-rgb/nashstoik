[
  {
    "start": 0.0,
    "end": 2.16,
    "text": "Kehilangan orang yang sangat kita"
  },
  {
    "start": 2.16,
    "end": 4.06,
    "text": "cintai adalah salah satu luka"
  },
  {
    "start": 4.06,
    "end": 6.15,
    "text": "paling perih yang bisa dirasakan"
  },
  {
    "start": 6.15,
    "end": 7.99,
    "text": "oleh hati manusia."
  },
  {
    "start": 7.99,
    "end": 10.28,
    "text": "Wajar jika air matamu menetes,"
  },
  {
    "start": 10.28,
    "end": 12.31,
    "text": "wajar jika dadamu terasa hancur"
  },
  {
    "start": 12.31,
    "end": 14.07,
    "text": "berkeping-keping."
  },
  {
    "start": 14.07,
    "end": 16.56,
    "text": "Jangan tahan kesedihan itu kawan,"
  },
  {
    "start": 16.56,
    "end": 18.65,
    "text": "menangislah sepuasnya."
  },
  {
    "start": 18.65,
    "end": 20.49,
    "text": "Rasa duka adalah tanda bahwa"
  },
  {
    "start": 20.49,
    "end": 22.52,
    "text": "cintamu tulus adanya."
  },
  {
    "start": 22.52,
    "end": 24.28,
    "text": "Tapi setelah badai air mata"
  },
  {
    "start": 24.28,
    "end": 25.33,
    "text": "itu mereda,"
  },
  {
    "start": 25.33,
    "end": 27.16,
    "text": "ingatlah satu hal ini: tidak"
  },
  {
    "start": 27.16,
    "end": 28.67,
    "text": "ada satu pun manusia di"
  },
  {
    "start": 28.67,
    "end": 30.7,
    "text": "dunia ini yang abadi."
  },
  {
    "start": 30.7,
    "end": 32.79,
    "text": "Kita semua hanyalah musafir yang"
  },
  {
    "start": 32.79,
    "end": 35.93,
    "text": "saling menemani untuk sementara waktu."
  },
  {
    "start": 35.93,
    "end": 39.01,
    "text": "Alih-alih terus meratapi kepergian mereka,"
  },
  {
    "start": 39.01,
    "end": 41.43,
    "text": "bersyukurlah bahwa kamu pernah diberi"
  },
  {
    "start": 41.43,
    "end": 44.05,
    "text": "kesempatan berharga untuk mengenal,"
  },
  {
    "start": 44.05,
    "end": 45.03,
    "text": "mencintai,"
  },
  {
    "start": 45.03,
    "end": 47.32,
    "text": "dan dicintai oleh mereka."
  },
  {
    "start": 47.32,
    "end": 49.61,
    "text": "Hormati kenangan mereka dengan cara"
  },
  {
    "start": 49.61,
    "end": 52.1,
    "text": "meneruskan kebaikan yang pernah mereka"
  },
  {
    "start": 52.1,
    "end": 53.28,
    "text": "ajarkan."
  },
  {
    "start": 53.28,
    "end": 54.98,
    "text": "Hiduplah dengan baik,"
  },
  {
    "start": 54.98,
    "end": 56.81,
    "text": "demi cinta mereka yang abadi"
  },
  {
    "start": 56.81,
    "end": 58.12,
    "text": "di jiwamu."
  }
]