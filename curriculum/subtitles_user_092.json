[
  {
    "start": 0.0,
    "end": 2.47,
    "text": "Pikiran kita seringkali terasa seperti"
  },
  {
    "start": 2.47,
    "end": 4.61,
    "text": "ruangan sempit yang dijejali oleh"
  },
  {
    "start": 4.61,
    "end": 6.88,
    "text": "ratusan barang rongsokan yang tidak"
  },
  {
    "start": 6.88,
    "end": 8.05,
    "text": "berguna."
  },
  {
    "start": 8.05,
    "end": 10.39,
    "text": "Kekhawatiran tentang hari esok,"
  },
  {
    "start": 10.39,
    "end": 12.08,
    "text": "penyesalan masa lalu,"
  },
  {
    "start": 12.08,
    "end": 13.96,
    "text": "dan gosip orang lain semuanya"
  },
  {
    "start": 13.96,
    "end": 16.36,
    "text": "bertumpuk menjadi satu hingga membuat"
  },
  {
    "start": 16.36,
    "end": 18.31,
    "text": "kita sulit bernapas."
  },
  {
    "start": 18.31,
    "end": 19.28,
    "text": "Malam ini,"
  },
  {
    "start": 19.28,
    "end": 21.62,
    "text": "luangkan waktu sejenak untuk menyapu"
  },
  {
    "start": 21.62,
    "end": 23.96,
    "text": "bersih sampah-sampah mental itu dari"
  },
  {
    "start": 23.96,
    "end": 25.19,
    "text": "kepalamu."
  },
  {
    "start": 25.19,
    "end": 28.31,
    "text": "Tuliskan kekhawatiranmu di selembar kertas,"
  },
  {
    "start": 28.31,
    "end": 30.45,
    "text": "lalu tanyakan pada dirimu: apakah"
  },
  {
    "start": 30.45,
    "end": 32.4,
    "text": "ada hal yang bisa kuselesaikan"
  },
  {
    "start": 32.4,
    "end": 34.02,
    "text": "malam ini juga?"
  },
  {
    "start": 34.02,
    "end": 35.32,
    "text": "Jika tidak ada,"
  },
  {
    "start": 35.32,
    "end": 37.21,
    "text": "lipat kertas itu dan letakkan"
  },
  {
    "start": 37.21,
    "end": 38.5,
    "text": "di mejamu."
  },
  {
    "start": 38.5,
    "end": 40.52,
    "text": "Biarkan malam ini menjadi ruang"
  },
  {
    "start": 40.52,
    "end": 42.47,
    "text": "kosong yang bersih bagi jiwamu"
  },
  {
    "start": 42.47,
    "end": 44.35,
    "text": "untuk beristirahat."
  },
  {
    "start": 44.35,
    "end": 46.23,
    "text": "Pikiran yang jernih esok pagi"
  },
  {
    "start": 46.23,
    "end": 48.5,
    "text": "akan menyelesaikan masalah itu jauh"
  },
  {
    "start": 48.5,
    "end": 49.87,
    "text": "lebih baik."
  }
]