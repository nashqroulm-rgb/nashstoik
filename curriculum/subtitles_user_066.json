[
  {
    "start": 0.0,
    "end": 2.53,
    "text": "Kekecewaan paling besar dalam hubungan"
  },
  {
    "start": 2.53,
    "end": 5.67,
    "text": "antarmanusia seringkali berakar dari ekspektasi"
  },
  {
    "start": 5.67,
    "end": 8.0,
    "text": "kita yang terlalu tinggi."
  },
  {
    "start": 8.0,
    "end": 9.93,
    "text": "Kita berharap orang lain akan"
  },
  {
    "start": 9.93,
    "end": 12.26,
    "text": "selalu mengerti perasaan kita,"
  },
  {
    "start": 12.26,
    "end": 14.53,
    "text": "berharap mereka membalas budi baik"
  },
  {
    "start": 14.53,
    "end": 15.2,
    "text": "kita,"
  },
  {
    "start": 15.2,
    "end": 17.26,
    "text": "atau berharap mereka tidak akan"
  },
  {
    "start": 17.26,
    "end": 19.59,
    "text": "pernah mengecewakan kita."
  },
  {
    "start": 19.59,
    "end": 21.93,
    "text": "Tapi manusia tetaplah manusia,"
  },
  {
    "start": 21.93,
    "end": 23.86,
    "text": "dengan segala kelemahan,"
  },
  {
    "start": 23.86,
    "end": 24.99,
    "text": "kebingungan,"
  },
  {
    "start": 24.99,
    "end": 27.99,
    "text": "dan masalah pribadi mereka sendiri."
  },
  {
    "start": 27.99,
    "end": 30.72,
    "text": "Saat kamu belajar menurunkan ekspektasimu"
  },
  {
    "start": 30.72,
    "end": 33.12,
    "text": "dan menerima mereka apa adanya,"
  },
  {
    "start": 33.12,
    "end": 35.12,
    "text": "hatimu akan terbebas dari rasa"
  },
  {
    "start": 35.12,
    "end": 37.86,
    "text": "sakit hati yang berkepanjangan."
  },
  {
    "start": 37.86,
    "end": 40.52,
    "text": "Cintailah orang-orang di sekitarmu tanpa"
  },
  {
    "start": 40.52,
    "end": 43.25,
    "text": "menuntut mereka harus sempurna."
  },
  {
    "start": 43.25,
    "end": 45.25,
    "text": "Kebaikan yang kamu beri dengan"
  },
  {
    "start": 45.25,
    "end": 47.32,
    "text": "tulus tidak akan pernah membuat"
  },
  {
    "start": 47.32,
    "end": 49.32,
    "text": "batinmu merasa rugi."
  }
]