[
  {
    "start": 0.0,
    "end": 2.33,
    "text": "Tersenyum saat semua keadaan sedang"
  },
  {
    "start": 2.33,
    "end": 4.99,
    "text": "membahagiakan itu sangat mudah dilakukan"
  },
  {
    "start": 4.99,
    "end": 6.71,
    "text": "oleh siapa saja."
  },
  {
    "start": 6.71,
    "end": 8.91,
    "text": "Tapi tersenyum dengan tenang saat"
  },
  {
    "start": 8.91,
    "end": 10.97,
    "text": "pekerjaan sedang menumpuk,"
  },
  {
    "start": 10.97,
    "end": 12.96,
    "text": "saat rencanamu terhambat,"
  },
  {
    "start": 12.96,
    "end": 14.89,
    "text": "atau saat orang lain bersikap"
  },
  {
    "start": 14.89,
    "end": 16.02,
    "text": "menyebalkan,"
  },
  {
    "start": 16.02,
    "end": 18.08,
    "text": "itulah tanda dari kekuatan jiwa"
  },
  {
    "start": 18.08,
    "end": 19.54,
    "text": "yang sejati."
  },
  {
    "start": 19.54,
    "end": 21.8,
    "text": "Senyuman yang tulus bukanlah tanda"
  },
  {
    "start": 21.8,
    "end": 24.13,
    "text": "bahwa kamu sedang pura-pura bahagia"
  },
  {
    "start": 24.13,
    "end": 26.39,
    "text": "atau meremehkan masalah."
  },
  {
    "start": 26.39,
    "end": 28.72,
    "text": "Senyuman adalah sinyal tegas kepada"
  },
  {
    "start": 28.72,
    "end": 30.91,
    "text": "batinmu sendiri bahwa masalah ini"
  },
  {
    "start": 30.91,
    "end": 33.24,
    "text": "tidak memiliki kuasa untuk merampas"
  },
  {
    "start": 33.24,
    "end": 35.03,
    "text": "keceriaan jiwamu."
  },
  {
    "start": 35.03,
    "end": 36.82,
    "text": "Ketika kamu tersenyum,"
  },
  {
    "start": 36.82,
    "end": 39.15,
    "text": "otot-otot di tubuhmu akan melonggar"
  },
  {
    "start": 39.15,
    "end": 41.34,
    "text": "dan pikiranmu akan kembali jernih"
  },
  {
    "start": 41.34,
    "end": 43.54,
    "text": "mencari solusi terbaik."
  },
  {
    "start": 43.54,
    "end": 45.8,
    "text": "Jangan biarkan beban hidup membuat"
  },
  {
    "start": 45.8,
    "end": 48.59,
    "text": "wajahmu selalu masam dan murung."
  },
  {
    "start": 48.59,
    "end": 50.19,
    "text": "Tersenyumlah kawan,"
  },
  {
    "start": 50.19,
    "end": 51.91,
    "text": "kamu jauh lebih besar dari"
  },
  {
    "start": 51.91,
    "end": 53.71,
    "text": "masalah apa pun yang sedang"
  },
  {
    "start": 53.71,
    "end": 55.17,
    "text": "kamu hadapi."
  }
]