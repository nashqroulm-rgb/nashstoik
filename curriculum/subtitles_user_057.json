[
  {
    "start": 0.0,
    "end": 2.21,
    "text": "Seringkali kita merasa berkecil hati"
  },
  {
    "start": 2.21,
    "end": 4.06,
    "text": "melihat orang lain yang tampak"
  },
  {
    "start": 4.06,
    "end": 6.09,
    "text": "melesat begitu cepat dalam karier"
  },
  {
    "start": 6.09,
    "end": 7.87,
    "text": "atau bisnis mereka."
  },
  {
    "start": 7.87,
    "end": 9.53,
    "text": "Tapi kita lupa bahwa setiap"
  },
  {
    "start": 9.53,
    "end": 11.31,
    "text": "orang lahir dengan garis awal"
  },
  {
    "start": 11.31,
    "end": 13.34,
    "text": "dan bekal yang berbeda."
  },
  {
    "start": 13.34,
    "end": 14.75,
    "text": "Ada yang lahir di jalan"
  },
  {
    "start": 14.75,
    "end": 15.98,
    "text": "tol yang mulus,"
  },
  {
    "start": 15.98,
    "end": 17.95,
    "text": "ada yang harus merintis jalannya"
  },
  {
    "start": 17.95,
    "end": 20.65,
    "text": "sendiri di tengah hutan belantara."
  },
  {
    "start": 20.65,
    "end": 23.3,
    "text": "Membandingkan kecepatanmu dengan orang yang"
  },
  {
    "start": 23.3,
    "end": 25.39,
    "text": "punya fasilitas berbeda hanya akan"
  },
  {
    "start": 25.39,
    "end": 27.41,
    "text": "membuat jiwamu lelah dan dipenuhi"
  },
  {
    "start": 27.41,
    "end": 28.58,
    "text": "rasa iri."
  },
  {
    "start": 28.58,
    "end": 31.16,
    "text": "Satu-satunya perbandingan yang adil adalah"
  },
  {
    "start": 31.16,
    "end": 33.38,
    "text": "membandingkan dirimu hari ini dengan"
  },
  {
    "start": 33.38,
    "end": 35.22,
    "text": "dirimu yang kemarin."
  },
  {
    "start": 35.22,
    "end": 37.68,
    "text": "Apakah kamu sudah lebih bijak?"
  },
  {
    "start": 37.68,
    "end": 40.32,
    "text": "Apakah kamu sudah melangkah maju?"
  },
  {
    "start": 40.32,
    "end": 42.41,
    "text": "Tatap jalanmu sendiri dengan teguh"
  },
  {
    "start": 42.41,
    "end": 43.4,
    "text": "kawan."
  },
  {
    "start": 43.4,
    "end": 45.61,
    "text": "Hargai setiap tetes keringatmu,"
  },
  {
    "start": 45.61,
    "end": 47.82,
    "text": "dan banggalah atas perjuanganmu yang"
  },
  {
    "start": 47.82,
    "end": 48.93,
    "text": "mandiri."
  }
]