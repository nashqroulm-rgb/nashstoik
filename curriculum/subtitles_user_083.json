[
  {
    "start": 0.0,
    "end": 2.05,
    "text": "Dunia ini tidak kekurangan orang"
  },
  {
    "start": 2.05,
    "end": 4.36,
    "text": "yang pintar berbicara dan berkhotbah"
  },
  {
    "start": 4.36,
    "end": 6.09,
    "text": "tentang kebaikan."
  },
  {
    "start": 6.09,
    "end": 7.95,
    "text": "Yang paling langka dan sangat"
  },
  {
    "start": 7.95,
    "end": 9.87,
    "text": "dibutuhkan oleh dunia saat ini"
  },
  {
    "start": 9.87,
    "end": 12.24,
    "text": "adalah orang-orang yang mampu menjadi"
  },
  {
    "start": 12.24,
    "end": 14.75,
    "text": "teladan ketenangan dan kehangatan lewat"
  },
  {
    "start": 14.75,
    "end": 16.92,
    "text": "perilakunya sehari-hari."
  },
  {
    "start": 16.92,
    "end": 18.66,
    "text": "Saat orang lain panik,"
  },
  {
    "start": 18.66,
    "end": 21.28,
    "text": "jadilah orang yang menenangkan."
  },
  {
    "start": 21.28,
    "end": 23.59,
    "text": "Saat orang lain saling mencaci,"
  },
  {
    "start": 23.59,
    "end": 25.64,
    "text": "jadilah orang yang merangkul dan"
  },
  {
    "start": 25.64,
    "end": 27.05,
    "text": "mendamaikan."
  },
  {
    "start": 27.05,
    "end": 29.81,
    "text": "Ketenangan jiwamu memiliki kekuatan getaran"
  },
  {
    "start": 29.81,
    "end": 31.73,
    "text": "yang menular ke orang-orang di"
  },
  {
    "start": 31.73,
    "end": 34.17,
    "text": "sekitarmu tanpa perlu banyak kata-kata"
  },
  {
    "start": 34.17,
    "end": 35.32,
    "text": "nasihat."
  },
  {
    "start": 35.32,
    "end": 36.29,
    "text": "Malam ini,"
  },
  {
    "start": 36.29,
    "end": 38.14,
    "text": "niatkan di dalam dadamu untuk"
  },
  {
    "start": 38.14,
    "end": 40.77,
    "text": "menjadi lentera kedamaian bagi keluargamu"
  },
  {
    "start": 40.77,
    "end": 43.15,
    "text": "dan lingkunganmu esok hari."
  },
  {
    "start": 43.15,
    "end": 45.33,
    "text": "Menjadi saluran berkah bagi sesama"
  },
  {
    "start": 45.33,
    "end": 48.27,
    "text": "adalah kehormatan tertinggi hidupmu."
  }
]