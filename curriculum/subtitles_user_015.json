[
  {
    "start": 0.0,
    "end": 1.91,
    "text": "Berapa banyak waktu yang kamu"
  },
  {
    "start": 1.91,
    "end": 3.83,
    "text": "habiskan hari ini hanya untuk"
  },
  {
    "start": 3.83,
    "end": 7.13,
    "text": "mengandai-andai kejadian di masa lalu?"
  },
  {
    "start": 7.13,
    "end": 9.31,
    "text": "Seandainya dulu aku memilih jalan"
  },
  {
    "start": 9.31,
    "end": 10.03,
    "text": "lain,"
  },
  {
    "start": 10.03,
    "end": 12.21,
    "text": "seandainya dulu aku tidak berkata"
  },
  {
    "start": 12.21,
    "end": 13.4,
    "text": "seperti itu,"
  },
  {
    "start": 13.4,
    "end": 15.45,
    "text": "atau seandainya orang itu tidak"
  },
  {
    "start": 15.45,
    "end": 18.02,
    "text": "pergi meninggalkan hidupku."
  },
  {
    "start": 18.02,
    "end": 20.93,
    "text": "Pikiran-pikiran pengandaian itu cuma membuat"
  },
  {
    "start": 20.93,
    "end": 23.3,
    "text": "batinmu lelah dan terperangkap dalam"
  },
  {
    "start": 23.3,
    "end": 26.34,
    "text": "penyesalan yang tidak ada gunanya."
  },
  {
    "start": 26.34,
    "end": 28.91,
    "text": "Tarik napas perlahan kawan."
  },
  {
    "start": 28.91,
    "end": 32.08,
    "text": "Sadarilah satu kebenaran mutlak ini."
  },
  {
    "start": 32.08,
    "end": 33.73,
    "text": "Masa lalu adalah hal yang"
  },
  {
    "start": 33.73,
    "end": 35.78,
    "text": "paling mustahil untuk diubah di"
  },
  {
    "start": 35.78,
    "end": 37.23,
    "text": "dunia ini."
  },
  {
    "start": 37.23,
    "end": 39.21,
    "text": "Bahkan dengan seluruh air mata"
  },
  {
    "start": 39.21,
    "end": 40.99,
    "text": "dan kekayaan di bumi,"
  },
  {
    "start": 40.99,
    "end": 42.84,
    "text": "sedetik yang lalu tidak akan"
  },
  {
    "start": 42.84,
    "end": 45.48,
    "text": "pernah bisa ditarik kembali."
  },
  {
    "start": 45.48,
    "end": 47.53,
    "text": "Orang yang bijak tidak membuang"
  },
  {
    "start": 47.53,
    "end": 49.51,
    "text": "air matanya untuk meratapi hal"
  },
  {
    "start": 49.51,
    "end": 51.55,
    "text": "yang sudah terjadi."
  },
  {
    "start": 51.55,
    "end": 54.19,
    "text": "Mereka memilih untuk merangkul kenyataan"
  },
  {
    "start": 54.19,
    "end": 55.58,
    "text": "itu apa adanya,"
  },
  {
    "start": 55.58,
    "end": 58.42,
    "text": "lalu menjadikannya bekal pelajaran berharga"
  },
  {
    "start": 58.42,
    "end": 60.6,
    "text": "untuk melangkah maju."
  },
  {
    "start": 60.6,
    "end": 61.65,
    "text": "Malam ini,"
  },
  {
    "start": 61.65,
    "end": 65.09,
    "text": "berhentilah bertarung melawan masa lalu."
  },
  {
    "start": 65.09,
    "end": 67.33,
    "text": "Ikhlaskan apa yang sudah terlanjur"
  },
  {
    "start": 67.33,
    "end": 68.26,
    "text": "terjadi,"
  },
  {
    "start": 68.26,
    "end": 70.43,
    "text": "dan fokuskan kedua tanganmu untuk"
  },
  {
    "start": 70.43,
    "end": 71.89,
    "text": "menata apa yang ada di"
  },
  {
    "start": 71.89,
    "end": 73.4,
    "text": "depan mata."
  }
]