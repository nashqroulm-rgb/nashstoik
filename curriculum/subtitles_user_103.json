[
  {
    "start": 0.0,
    "end": 2.31,
    "text": "Ada masa-masa di dalam kehidupan"
  },
  {
    "start": 2.31,
    "end": 4.18,
    "text": "di mana kita merasa begitu"
  },
  {
    "start": 4.18,
    "end": 5.26,
    "text": "sendirian,"
  },
  {
    "start": 5.26,
    "end": 7.06,
    "text": "seolah tidak ada satu pun"
  },
  {
    "start": 7.06,
    "end": 8.72,
    "text": "orang di dunia ini yang"
  },
  {
    "start": 8.72,
    "end": 11.31,
    "text": "benar-benar memahami beban di pundak"
  },
  {
    "start": 11.31,
    "end": 12.39,
    "text": "kita."
  },
  {
    "start": 12.39,
    "end": 14.19,
    "text": "Rasa sepi itu bisa terasa"
  },
  {
    "start": 14.19,
    "end": 16.43,
    "text": "sangat dingin dan mencekam jika"
  },
  {
    "start": 16.43,
    "end": 19.45,
    "text": "kita terus menolak kehadirannya."
  },
  {
    "start": 19.45,
    "end": 21.4,
    "text": "Tapi ketahuilah kawan,"
  },
  {
    "start": 21.4,
    "end": 24.06,
    "text": "kesepian adalah panggilan dari jiwamu"
  },
  {
    "start": 24.06,
    "end": 26.44,
    "text": "untuk lebih mengenal siapa dirimu"
  },
  {
    "start": 26.44,
    "end": 28.46,
    "text": "yang sesungguhnya."
  },
  {
    "start": 28.46,
    "end": 30.55,
    "text": "Saat seluruh suara dunia luar"
  },
  {
    "start": 30.55,
    "end": 32.57,
    "text": "mereda dan kamu sendirian di"
  },
  {
    "start": 32.57,
    "end": 33.5,
    "text": "kamarmu,"
  },
  {
    "start": 33.5,
    "end": 36.31,
    "text": "belajarlah menjadi sahabat terbaik bagi"
  },
  {
    "start": 36.31,
    "end": 38.11,
    "text": "dirimu sendiri."
  },
  {
    "start": 38.11,
    "end": 41.64,
    "text": "Rangkul dirimu dengan penuh kelembutan."
  },
  {
    "start": 41.64,
    "end": 44.45,
    "text": "Kamu tidak pernah benar-benar sendirian"
  },
  {
    "start": 44.45,
    "end": 46.76,
    "text": "selama kamu masih setia menemani"
  },
  {
    "start": 46.76,
    "end": 49.14,
    "text": "dan merawat jiwamu sendiri dengan"
  },
  {
    "start": 49.14,
    "end": 51.23,
    "text": "penuh kasih sayang."
  }
]