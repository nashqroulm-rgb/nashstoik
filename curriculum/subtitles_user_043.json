[
  {
    "start": 0.0,
    "end": 1.74,
    "text": "Waktumu di dunia ini adalah"
  },
  {
    "start": 1.74,
    "end": 3.8,
    "text": "sumber daya yang paling berharga"
  },
  {
    "start": 3.8,
    "end": 6.58,
    "text": "dan tidak pernah bisa diperbarui."
  },
  {
    "start": 6.58,
    "end": 7.74,
    "text": "Tapi anehnya,"
  },
  {
    "start": 7.74,
    "end": 9.86,
    "text": "kita seringkali sangat murah hati"
  },
  {
    "start": 9.86,
    "end": 12.44,
    "text": "membagi-bagikan waktu kita untuk hal-hal"
  },
  {
    "start": 12.44,
    "end": 14.31,
    "text": "yang tidak berguna."
  },
  {
    "start": 14.31,
    "end": 16.44,
    "text": "Ajakan nongkrong yang cuma berisi"
  },
  {
    "start": 16.44,
    "end": 17.21,
    "text": "ghibah,"
  },
  {
    "start": 17.21,
    "end": 19.21,
    "text": "rapat yang tidak berujung,"
  },
  {
    "start": 19.21,
    "end": 21.4,
    "text": "atau scroll layar berjam-jam tanpa"
  },
  {
    "start": 21.4,
    "end": 22.5,
    "text": "tujuan."
  },
  {
    "start": 22.5,
    "end": 24.24,
    "text": "Setiap kali kamu berkata ya"
  },
  {
    "start": 24.24,
    "end": 26.63,
    "text": "pada hal-hal yang tidak penting,"
  },
  {
    "start": 26.63,
    "end": 28.95,
    "text": "kamu sebenarnya sedang berkata tidak"
  },
  {
    "start": 28.95,
    "end": 30.36,
    "text": "pada kesehatanmu,"
  },
  {
    "start": 30.36,
    "end": 31.4,
    "text": "keluargamu,"
  },
  {
    "start": 31.4,
    "end": 33.59,
    "text": "dan impian masa depanmu."
  },
  {
    "start": 33.59,
    "end": 34.88,
    "text": "Mulai hari ini,"
  },
  {
    "start": 34.88,
    "end": 37.52,
    "text": "milikilah keberanian untuk menolak dengan"
  },
  {
    "start": 37.52,
    "end": 39.26,
    "text": "sopan tapi tegas."
  },
  {
    "start": 39.26,
    "end": 41.78,
    "text": "Kamu tidak berhutang penjelasan panjang"
  },
  {
    "start": 41.78,
    "end": 43.9,
    "text": "kepada siapa pun untuk melindungi"
  },
  {
    "start": 43.9,
    "end": 45.58,
    "text": "waktumu sendiri."
  },
  {
    "start": 45.58,
    "end": 47.9,
    "text": "Fokuskan energimu hanya pada hal-hal"
  },
  {
    "start": 47.9,
    "end": 50.35,
    "text": "yang benar-benar selaras dengan tujuan"
  },
  {
    "start": 50.35,
    "end": 51.51,
    "text": "hidupmu."
  },
  {
    "start": 51.51,
    "end": 53.44,
    "text": "Hidup yang tenang dimulai dari"
  },
  {
    "start": 53.44,
    "end": 56.35,
    "text": "kemampuanmu menjaga batasan dirimu."
  }
]