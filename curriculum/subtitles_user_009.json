[
  {
    "start": 0.0,
    "end": 2.08,
    "text": "Berapa banyak rencana baik yang"
  },
  {
    "start": 2.08,
    "end": 4.03,
    "text": "terus kamu tunda hanya karena"
  },
  {
    "start": 4.03,
    "end": 6.92,
    "text": "merasa dirimu belum cukup siap?"
  },
  {
    "start": 6.92,
    "end": 9.01,
    "text": "Kamu menunggu sampai punya ilmu"
  },
  {
    "start": 9.01,
    "end": 10.35,
    "text": "yang sempurna,"
  },
  {
    "start": 10.35,
    "end": 12.9,
    "text": "menunggu modal terkumpul banyak,"
  },
  {
    "start": 12.9,
    "end": 15.32,
    "text": "atau menunggu waktu yang benar-benar"
  },
  {
    "start": 15.32,
    "end": 16.53,
    "text": "tepat."
  },
  {
    "start": 16.53,
    "end": 19.76,
    "text": "Akhirnya berbulan-bulan lewat begitu saja,"
  },
  {
    "start": 19.76,
    "end": 21.24,
    "text": "dan kamu masih diam di"
  },
  {
    "start": 21.24,
    "end": 23.19,
    "text": "tempat yang sama."
  },
  {
    "start": 23.19,
    "end": 25.54,
    "text": "Dengar baik-baik kawan."
  },
  {
    "start": 25.54,
    "end": 27.15,
    "text": "Rasa siap itu tidak akan"
  },
  {
    "start": 27.15,
    "end": 29.1,
    "text": "pernah datang kalau kamu cuma"
  },
  {
    "start": 29.1,
    "end": 32.06,
    "text": "duduk menunggu di zona nyamanmu."
  },
  {
    "start": 32.06,
    "end": 34.54,
    "text": "Kesiapan mental dan keberanian justru"
  },
  {
    "start": 34.54,
    "end": 36.36,
    "text": "baru akan lahir saat kakimu"
  },
  {
    "start": 36.36,
    "end": 38.44,
    "text": "sudah berani melangkah di jalan"
  },
  {
    "start": 38.44,
    "end": 39.99,
    "text": "yang nyata."
  },
  {
    "start": 39.99,
    "end": 42.81,
    "text": "Orang-orang bijak tidak menunggu ketakutan"
  },
  {
    "start": 42.81,
    "end": 46.04,
    "text": "mereka hilang untuk mulai bertindak."
  },
  {
    "start": 46.04,
    "end": 48.39,
    "text": "Mereka melangkah bersama rasa takut"
  },
  {
    "start": 48.39,
    "end": 49.06,
    "text": "itu,"
  },
  {
    "start": 49.06,
    "end": 51.15,
    "text": "lalu membuktikan bahwa jalan di"
  },
  {
    "start": 51.15,
    "end": 54.44,
    "text": "depan tidak seseram yang dibayangkan."
  },
  {
    "start": 54.44,
    "end": 57.06,
    "text": "Tidak perlu langsung melakukan lompatan"
  },
  {
    "start": 57.06,
    "end": 58.4,
    "text": "raksasa."
  },
  {
    "start": 58.4,
    "end": 60.42,
    "text": "Cukup ambil satu langkah kecil"
  },
  {
    "start": 60.42,
    "end": 61.97,
    "text": "hari ini yang bisa kamu"
  },
  {
    "start": 61.97,
    "end": 64.99,
    "text": "kerjakan dengan tanganmu sendiri."
  },
  {
    "start": 64.99,
    "end": 67.34,
    "text": "Mulailah dari tempatmu berdiri saat"
  },
  {
    "start": 67.34,
    "end": 68.01,
    "text": "ini,"
  },
  {
    "start": 68.01,
    "end": 69.83,
    "text": "dengan apa yang kamu miliki"
  },
  {
    "start": 69.83,
    "end": 71.24,
    "text": "sekarang."
  },
  {
    "start": 71.24,
    "end": 73.79,
    "text": "Kesempurnaan itu dibentuk di sepanjang"
  },
  {
    "start": 73.79,
    "end": 74.94,
    "text": "perjalanan,"
  },
  {
    "start": 74.94,
    "end": 77.09,
    "text": "bukan di garis awal."
  }
]