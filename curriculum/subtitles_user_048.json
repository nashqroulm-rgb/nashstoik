[
  {
    "start": 0.0,
    "end": 2.14,
    "text": "Waktu terbaik untuk menata jiwamu"
  },
  {
    "start": 2.14,
    "end": 3.89,
    "text": "adalah saat fajar baru saja"
  },
  {
    "start": 3.89,
    "end": 6.23,
    "text": "menyingsing dan dunia masih terlelap"
  },
  {
    "start": 6.23,
    "end": 7.98,
    "text": "dalam keheningan."
  },
  {
    "start": 7.98,
    "end": 10.19,
    "text": "Sebelum kamu menyalakan ponsel dan"
  },
  {
    "start": 10.19,
    "end": 13.37,
    "text": "membiarkan tuntutan pekerjaan masuk mengacak-acak"
  },
  {
    "start": 13.37,
    "end": 14.28,
    "text": "kepalamu,"
  },
  {
    "start": 14.28,
    "end": 16.36,
    "text": "sempatkan waktu lima belas menit"
  },
  {
    "start": 16.36,
    "end": 18.04,
    "text": "untuk duduk tenang di pagi"
  },
  {
    "start": 18.04,
    "end": 19.02,
    "text": "hari."
  },
  {
    "start": 19.02,
    "end": 21.48,
    "text": "Rasakan udara dingin yang bersih,"
  },
  {
    "start": 21.48,
    "end": 24.02,
    "text": "seruput minuman hangatmu perlahan,"
  },
  {
    "start": 24.02,
    "end": 25.83,
    "text": "dan tetapkan niat baik untuk"
  },
  {
    "start": 25.83,
    "end": 26.94,
    "text": "harimu."
  },
  {
    "start": 26.94,
    "end": 29.27,
    "text": "Bagaimana caramu memulai pagimu akan"
  },
  {
    "start": 29.27,
    "end": 32.19,
    "text": "menentukan bagaimana caramu merespons masalah"
  },
  {
    "start": 32.19,
    "end": 34.14,
    "text": "di sepanjang harimu."
  },
  {
    "start": 34.14,
    "end": 36.15,
    "text": "Jika pagimu diawali dengan rasa"
  },
  {
    "start": 36.15,
    "end": 37.97,
    "text": "panik dan terburu-buru,"
  },
  {
    "start": 37.97,
    "end": 41.02,
    "text": "harimu akan penuh dengan kegelisahan."
  },
  {
    "start": 41.02,
    "end": 43.03,
    "text": "Tapi jika pagimu diawali dengan"
  },
  {
    "start": 43.03,
    "end": 45.11,
    "text": "ketenangan dan rasa syukur,"
  },
  {
    "start": 45.11,
    "end": 47.25,
    "text": "jiwamu akan memiliki perisai yang"
  },
  {
    "start": 47.25,
    "end": 49.2,
    "text": "kokoh untuk menghadapi apa pun"
  },
  {
    "start": 49.2,
    "end": 50.69,
    "text": "yang terjadi."
  },
  {
    "start": 50.69,
    "end": 53.09,
    "text": "Bangunlah lebih awal besok pagi,"
  },
  {
    "start": 53.09,
    "end": 55.11,
    "text": "dan rasakan kedamaian fajar itu"
  },
  {
    "start": 55.11,
    "end": 57.31,
    "text": "meresap ke dalam hatimu."
  }
]