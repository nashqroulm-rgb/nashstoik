[
  {
    "start": 0.0,
    "end": 2.72,
    "text": "Ada orang-orang yang kehadirannya seperti"
  },
  {
    "start": 2.72,
    "end": 4.84,
    "text": "awan mendung yang selalu membawa"
  },
  {
    "start": 4.84,
    "end": 6.1,
    "text": "hujan keluhan,"
  },
  {
    "start": 6.1,
    "end": 7.09,
    "text": "pesimisme,"
  },
  {
    "start": 7.09,
    "end": 8.75,
    "text": "dan kebencian ke mana pun"
  },
  {
    "start": 8.75,
    "end": 10.27,
    "text": "mereka pergi."
  },
  {
    "start": 10.27,
    "end": 12.52,
    "text": "Setiap kali kamu selesai berbicara"
  },
  {
    "start": 12.52,
    "end": 13.78,
    "text": "dengan mereka,"
  },
  {
    "start": 13.78,
    "end": 16.1,
    "text": "kamu merasa energimu terkuras habis"
  },
  {
    "start": 16.1,
    "end": 18.09,
    "text": "dan dadamu dipenuhi rasa cemas"
  },
  {
    "start": 18.09,
    "end": 20.14,
    "text": "yang tidak beralasan."
  },
  {
    "start": 20.14,
    "end": 21.6,
    "text": "Ketahuilah kawan,"
  },
  {
    "start": 21.6,
    "end": 23.59,
    "text": "kamu berhak memilih siapa saja"
  },
  {
    "start": 23.59,
    "end": 25.25,
    "text": "orang yang boleh duduk di"
  },
  {
    "start": 25.25,
    "end": 27.7,
    "text": "lingkaran terdekat hidupmu."
  },
  {
    "start": 27.7,
    "end": 30.21,
    "text": "Kamu tidak berkewajiban menjadi tempat"
  },
  {
    "start": 30.21,
    "end": 32.27,
    "text": "sampah bagi emosi negatif orang"
  },
  {
    "start": 32.27,
    "end": 33.26,
    "text": "lain."
  },
  {
    "start": 33.26,
    "end": 34.59,
    "text": "Perlahan-lahan,"
  },
  {
    "start": 34.59,
    "end": 36.51,
    "text": "buatlah jarak yang sehat dari"
  },
  {
    "start": 36.51,
    "end": 39.42,
    "text": "mereka yang terus-menerus meracuni kedamaian"
  },
  {
    "start": 39.42,
    "end": 40.55,
    "text": "jiwamu."
  },
  {
    "start": 40.55,
    "end": 43.2,
    "text": "Kelilingi dirimu dengan orang-orang yang"
  },
  {
    "start": 43.2,
    "end": 43.93,
    "text": "tulus,"
  },
  {
    "start": 43.93,
    "end": 45.06,
    "text": "bersemangat,"
  },
  {
    "start": 45.06,
    "end": 48.63,
    "text": "dan senantiasa mengingatkanmu pada kebaikan."
  },
  {
    "start": 48.63,
    "end": 51.15,
    "text": "Ketenangan batinmu terlalu mahal untuk"
  },
  {
    "start": 51.15,
    "end": 52.61,
    "text": "dikorbankan."
  }
]