[
  {
    "start": 0.0,
    "end": 1.92,
    "text": "Mengapa kita bisa begitu takut"
  },
  {
    "start": 1.92,
    "end": 4.67,
    "text": "mengecewakan orang lain saat berjanji,"
  },
  {
    "start": 4.67,
    "end": 6.85,
    "text": "tapi dengan sangat mudah melanggar"
  },
  {
    "start": 6.85,
    "end": 8.57,
    "text": "janji yang kita buat kepada"
  },
  {
    "start": 8.57,
    "end": 10.05,
    "text": "diri sendiri?"
  },
  {
    "start": 10.05,
    "end": 11.97,
    "text": "Kamu berjanji mau bangun lebih"
  },
  {
    "start": 11.97,
    "end": 12.61,
    "text": "pagi,"
  },
  {
    "start": 12.61,
    "end": 14.91,
    "text": "berjanji mau hidup lebih sehat,"
  },
  {
    "start": 14.91,
    "end": 18.04,
    "text": "berjanji mau belajar keterampilan baru."
  },
  {
    "start": 18.04,
    "end": 19.96,
    "text": "Tapi begitu harinya tiba,"
  },
  {
    "start": 19.96,
    "end": 22.33,
    "text": "kamu dengan mudah membatalkannya demi"
  },
  {
    "start": 22.33,
    "end": 24.12,
    "text": "kenyamanan sesaat."
  },
  {
    "start": 24.12,
    "end": 26.3,
    "text": "Setiap kali kamu mengingkari janji"
  },
  {
    "start": 26.3,
    "end": 27.9,
    "text": "pada dirimu sendiri,"
  },
  {
    "start": 27.9,
    "end": 30.39,
    "text": "rasa percaya dirimu perlahan-lahan akan"
  },
  {
    "start": 30.39,
    "end": 32.19,
    "text": "runtuh dari dalam."
  },
  {
    "start": 32.19,
    "end": 34.43,
    "text": "Kamu mulai memandang dirimu sebagai"
  },
  {
    "start": 34.43,
    "end": 37.18,
    "text": "orang yang tidak bisa diandalkan."
  },
  {
    "start": 37.18,
    "end": 38.52,
    "text": "Mulai malam ini,"
  },
  {
    "start": 38.52,
    "end": 40.82,
    "text": "mulailah belajar setia pada komitmen"
  },
  {
    "start": 40.82,
    "end": 42.1,
    "text": "pribadimu."
  },
  {
    "start": 42.1,
    "end": 45.05,
    "text": "Buatlah janji-janji kecil yang realistis,"
  },
  {
    "start": 45.05,
    "end": 46.84,
    "text": "lalu tepati janji itu dengan"
  },
  {
    "start": 46.84,
    "end": 48.82,
    "text": "segenap integritasmu."
  },
  {
    "start": 48.82,
    "end": 50.74,
    "text": "Rasa percaya diri sejati lahir"
  },
  {
    "start": 50.74,
    "end": 52.34,
    "text": "saat kamu tahu bahwa kamu"
  },
  {
    "start": 52.34,
    "end": 54.33,
    "text": "adalah orang yang bisa dipegang"
  },
  {
    "start": 54.33,
    "end": 57.08,
    "text": "kata-katanya oleh jiwamu sendiri."
  }
]