[
  {
    "start": 0.0,
    "end": 1.8,
    "text": "Saat kamu membuka matamu di"
  },
  {
    "start": 1.8,
    "end": 3.2,
    "text": "pagi hari nanti,"
  },
  {
    "start": 3.2,
    "end": 5.13,
    "text": "hal pertama yang kamu lakukan"
  },
  {
    "start": 5.13,
    "end": 7.86,
    "text": "akan menentukan suasana batinmu sepanjang"
  },
  {
    "start": 7.86,
    "end": 8.86,
    "text": "hari."
  },
  {
    "start": 8.86,
    "end": 11.19,
    "text": "Jangan langsung meraih ponselmu dan"
  },
  {
    "start": 11.19,
    "end": 13.73,
    "text": "membiarkan berita buruk dunia meracuni"
  },
  {
    "start": 13.73,
    "end": 16.66,
    "text": "kepalamu yang baru saja terbangun."
  },
  {
    "start": 16.66,
    "end": 18.59,
    "text": "Tarik napas dalam-dalam,"
  },
  {
    "start": 18.59,
    "end": 20.79,
    "text": "rasakan udara sejuk pagi mengalir"
  },
  {
    "start": 20.79,
    "end": 21.79,
    "text": "di dadamu,"
  },
  {
    "start": 21.79,
    "end": 24.25,
    "text": "lalu tersenyumlah dengan tulus kepada"
  },
  {
    "start": 24.25,
    "end": 25.92,
    "text": "hari yang baru."
  },
  {
    "start": 25.92,
    "end": 28.32,
    "text": "Senyuman itu adalah pernyataan sikap"
  },
  {
    "start": 28.32,
    "end": 30.32,
    "text": "jiwamu bahwa apa pun tantangan"
  },
  {
    "start": 30.32,
    "end": 32.38,
    "text": "yang akan datang hari ini,"
  },
  {
    "start": 32.38,
    "end": 34.98,
    "text": "kamu memilih untuk menghadapinya dengan"
  },
  {
    "start": 34.98,
    "end": 37.24,
    "text": "ketenangan dan kebaikan."
  },
  {
    "start": 37.24,
    "end": 39.04,
    "text": "Satu senyuman tulus di awal"
  },
  {
    "start": 39.04,
    "end": 41.31,
    "text": "hari memiliki kekuatan magis untuk"
  },
  {
    "start": 41.31,
    "end": 44.04,
    "text": "meredam kecemasan dan membuka pintu-pintu"
  },
  {
    "start": 44.04,
    "end": 46.11,
    "text": "rezeki berkah bagimu."
  }
]