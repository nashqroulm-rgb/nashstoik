[
  {
    "start": 0.0,
    "end": 2.17,
    "text": "Pernah tidak kamu menyesal setengah"
  },
  {
    "start": 2.17,
    "end": 4.84,
    "text": "mati gara-gara mengeluarkan kata-kata kasar"
  },
  {
    "start": 4.84,
    "end": 7.13,
    "text": "saat sedang emosi tinggi?"
  },
  {
    "start": 7.13,
    "end": 8.18,
    "text": "Saat marah,"
  },
  {
    "start": 8.18,
    "end": 10.23,
    "text": "otak kita seringkali dibajak oleh"
  },
  {
    "start": 10.23,
    "end": 12.83,
    "text": "nafsu untuk membalas seketika."
  },
  {
    "start": 12.83,
    "end": 15.13,
    "text": "Rasanya ingin membanting pintu,"
  },
  {
    "start": 15.13,
    "end": 17.61,
    "text": "ingin mengetik pesan penuh amarah,"
  },
  {
    "start": 17.61,
    "end": 19.96,
    "text": "dan meluapkan kekesalan tanpa berpikir"
  },
  {
    "start": 19.96,
    "end": 21.2,
    "text": "panjang."
  },
  {
    "start": 21.2,
    "end": 22.63,
    "text": "Tapi ingat kawan,"
  },
  {
    "start": 22.63,
    "end": 24.61,
    "text": "kata-kata yang sudah keluar dari"
  },
  {
    "start": 24.61,
    "end": 26.47,
    "text": "lidahmu tidak akan pernah bisa"
  },
  {
    "start": 26.47,
    "end": 28.4,
    "text": "kamu tarik kembali."
  },
  {
    "start": 28.4,
    "end": 29.82,
    "text": "Luka di hati orang lain"
  },
  {
    "start": 29.82,
    "end": 32.43,
    "text": "mungkin membekas selamanya hanya gara-gara"
  },
  {
    "start": 32.43,
    "end": 34.41,
    "text": "amarah lima detikmu."
  },
  {
    "start": 34.41,
    "end": 36.46,
    "text": "Orang yang benar-benar kuat bukan"
  },
  {
    "start": 36.46,
    "end": 38.69,
    "text": "mereka yang paling keras teriakannya"
  },
  {
    "start": 38.69,
    "end": 41.6,
    "text": "atau paling cepat membalas pukulan."
  },
  {
    "start": 41.6,
    "end": 43.4,
    "text": "Orang yang kuat adalah mereka"
  },
  {
    "start": 43.4,
    "end": 45.63,
    "text": "yang mampu menguasai dirinya sendiri"
  },
  {
    "start": 45.63,
    "end": 47.99,
    "text": "saat sedang dipicu amarah."
  },
  {
    "start": 47.99,
    "end": 49.29,
    "text": "Mulai sekarang,"
  },
  {
    "start": 49.29,
    "end": 51.46,
    "text": "latih satu kebiasaan sederhana ini:"
  },
  {
    "start": 51.46,
    "end": 53.51,
    "text": "beri jeda tiga detik."
  },
  {
    "start": 53.51,
    "end": 55.74,
    "text": "Tarik napas dalam-dalam sebelum kamu"
  },
  {
    "start": 55.74,
    "end": 58.71,
    "text": "membalas perkataan yang menyakitkan."
  },
  {
    "start": 58.71,
    "end": 60.57,
    "text": "Biarkan amarahmu mereda,"
  },
  {
    "start": 60.57,
    "end": 62.43,
    "text": "baru biarkan akal sehatmu yang"
  },
  {
    "start": 62.43,
    "end": 63.8,
    "text": "berbicara."
  },
  {
    "start": 63.8,
    "end": 66.28,
    "text": "Menguasai reaksimu sendiri adalah bentuk"
  },
  {
    "start": 66.28,
    "end": 69.07,
    "text": "kemenangan tertinggi bagi jiwamu."
  }
]