[
  {
    "start": 0.0,
    "end": 2.18,
    "text": "Kita sering merasa frustrasi saat"
  },
  {
    "start": 2.18,
    "end": 4.43,
    "text": "tidak bisa memahami mengapa sebuah"
  },
  {
    "start": 4.43,
    "end": 6.74,
    "text": "peristiwa buruk harus terjadi dalam"
  },
  {
    "start": 6.74,
    "end": 8.13,
    "text": "hidup kita."
  },
  {
    "start": 8.13,
    "end": 10.31,
    "text": "Mengapa harus kita yang mengalami"
  },
  {
    "start": 10.31,
    "end": 11.63,
    "text": "sakit ini?"
  },
  {
    "start": 11.63,
    "end": 13.88,
    "text": "Mengapa harus kita yang kehilangan"
  },
  {
    "start": 13.88,
    "end": 15.2,
    "text": "orang itu?"
  },
  {
    "start": 15.2,
    "end": 17.18,
    "text": "Mengapa doa kita belum kunjung"
  },
  {
    "start": 17.18,
    "end": 18.43,
    "text": "terkabul?"
  },
  {
    "start": 18.43,
    "end": 19.82,
    "text": "Sadarilah kawan,"
  },
  {
    "start": 19.82,
    "end": 22.2,
    "text": "keterbatasan akal manusia tidak akan"
  },
  {
    "start": 22.2,
    "end": 24.78,
    "text": "pernah sanggup membaca seluruh lembaran"
  },
  {
    "start": 24.78,
    "end": 26.89,
    "text": "rencana agung semesta raya dalam"
  },
  {
    "start": 26.89,
    "end": 28.28,
    "text": "satu waktu."
  },
  {
    "start": 28.28,
    "end": 30.59,
    "text": "Ibarat melihat bagian belakang dari"
  },
  {
    "start": 30.59,
    "end": 32.64,
    "text": "sebuah kain sulaman benang yang"
  },
  {
    "start": 32.64,
    "end": 34.75,
    "text": "tampak semrawut dan penuh simpul"
  },
  {
    "start": 34.75,
    "end": 35.81,
    "text": "kusut."
  },
  {
    "start": 35.81,
    "end": 37.93,
    "text": "Tapi saat kain itu dibalik,"
  },
  {
    "start": 37.93,
    "end": 40.63,
    "text": "terlihatlah lukisan pemandangan yang luar"
  },
  {
    "start": 40.63,
    "end": 42.09,
    "text": "biasa indah."
  },
  {
    "start": 42.09,
    "end": 45.19,
    "text": "Percayalah pada proses kehidupan ini."
  },
  {
    "start": 45.19,
    "end": 46.78,
    "text": "Hal yang hari ini terasa"
  },
  {
    "start": 46.78,
    "end": 47.9,
    "text": "menyakitkan,"
  },
  {
    "start": 47.9,
    "end": 49.95,
    "text": "kelak akan kamu syukuri sebagai"
  },
  {
    "start": 49.95,
    "end": 52.46,
    "text": "pembuka jalan menuju kebaikan terbesar"
  },
  {
    "start": 52.46,
    "end": 54.05,
    "text": "dalam hidupmu."
  }
]