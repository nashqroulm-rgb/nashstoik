[
  {
    "start": 0.0,
    "end": 2.09,
    "text": "Dunia di sekitar kita seringkali"
  },
  {
    "start": 2.09,
    "end": 4.38,
    "text": "penuh dengan racun kecurangan,"
  },
  {
    "start": 4.38,
    "end": 5.36,
    "text": "kelicikan,"
  },
  {
    "start": 5.36,
    "end": 6.93,
    "text": "dan kepalsuan."
  },
  {
    "start": 6.93,
    "end": 8.76,
    "text": "Sangat mudah bagi kita untuk"
  },
  {
    "start": 8.76,
    "end": 10.72,
    "text": "tergoda ikut menjadi licik dan"
  },
  {
    "start": 10.72,
    "end": 12.75,
    "text": "curang dengan dalih bahwa semua"
  },
  {
    "start": 12.75,
    "end": 15.17,
    "text": "orang juga melakukannya demi bertahan"
  },
  {
    "start": 15.17,
    "end": 16.21,
    "text": "hidup."
  },
  {
    "start": 16.21,
    "end": 17.98,
    "text": "Tapi ketahuilah kawan,"
  },
  {
    "start": 17.98,
    "end": 20.4,
    "text": "kemenangan yang didapatkan dari jalan"
  },
  {
    "start": 20.4,
    "end": 22.23,
    "text": "yang kotor tidak akan pernah"
  },
  {
    "start": 22.23,
    "end": 24.71,
    "text": "membawa keberkahan dan ketenangan bagi"
  },
  {
    "start": 24.71,
    "end": 26.28,
    "text": "tidur malammu."
  },
  {
    "start": 26.28,
    "end": 28.83,
    "text": "Kekayaan dan kemenangan terbesar adalah"
  },
  {
    "start": 28.83,
    "end": 30.73,
    "text": "saat kamu bisa menatap matamu"
  },
  {
    "start": 30.73,
    "end": 32.62,
    "text": "sendiri di depan cermin tanpa"
  },
  {
    "start": 32.62,
    "end": 34.39,
    "text": "ada rasa bersalah atau rasa"
  },
  {
    "start": 34.39,
    "end": 35.37,
    "text": "malu."
  },
  {
    "start": 35.37,
    "end": 37.66,
    "text": "Tetaplah menjadi orang yang berhati"
  },
  {
    "start": 37.66,
    "end": 38.44,
    "text": "bersih,"
  },
  {
    "start": 38.44,
    "end": 40.34,
    "text": "betapa pun kotornya lumpur di"
  },
  {
    "start": 40.34,
    "end": 41.84,
    "text": "sekelilingmu."
  },
  {
    "start": 41.84,
    "end": 43.93,
    "text": "Bunga teratai tetap mekar anggun"
  },
  {
    "start": 43.93,
    "end": 46.03,
    "text": "dan wangi meski akarnya terbenam"
  },
  {
    "start": 46.03,
    "end": 47.73,
    "text": "di dasar lumpur."
  }
]