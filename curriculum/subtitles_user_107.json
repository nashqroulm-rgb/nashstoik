[
  {
    "start": 0.0,
    "end": 1.82,
    "text": "Segala hal yang kita miliki"
  },
  {
    "start": 1.82,
    "end": 3.84,
    "text": "di dunia ini hakikatnya adalah"
  },
  {
    "start": 3.84,
    "end": 5.79,
    "text": "titipan yang suatu saat nanti"
  },
  {
    "start": 5.79,
    "end": 7.88,
    "text": "pasti akan diminta kembali oleh"
  },
  {
    "start": 7.88,
    "end": 9.3,
    "text": "pemiliknya."
  },
  {
    "start": 9.3,
    "end": 10.65,
    "text": "Kesehatan kita,"
  },
  {
    "start": 10.65,
    "end": 11.99,
    "text": "masa muda kita,"
  },
  {
    "start": 11.99,
    "end": 13.21,
    "text": "jabatan kita,"
  },
  {
    "start": 13.21,
    "end": 15.56,
    "text": "bahkan orang-orang yang paling kita"
  },
  {
    "start": 15.56,
    "end": 18.06,
    "text": "sayangi semuanya adalah pinjaman yang"
  },
  {
    "start": 18.06,
    "end": 19.34,
    "text": "berharga."
  },
  {
    "start": 19.34,
    "end": 21.76,
    "text": "Saat waktu perpisahan itu tiba,"
  },
  {
    "start": 21.76,
    "end": 24.25,
    "text": "jangan biarkan dirimu tenggelam dalam"
  },
  {
    "start": 24.25,
    "end": 27.42,
    "text": "amarah penolakan yang merusak jiwamu."
  },
  {
    "start": 27.42,
    "end": 29.64,
    "text": "Ucapkan terima kasih karena telah"
  },
  {
    "start": 29.64,
    "end": 32.54,
    "text": "diizinkan untuk merasakan keindahan titipan"
  },
  {
    "start": 32.54,
    "end": 34.83,
    "text": "itu selama sekian waktu."
  },
  {
    "start": 34.83,
    "end": 36.52,
    "text": "Rasa syukur atas apa yang"
  },
  {
    "start": 36.52,
    "end": 38.74,
    "text": "pernah ada akan menyembuhkan luka"
  },
  {
    "start": 38.74,
    "end": 41.44,
    "text": "kehilanganmu jauh lebih cepat."
  },
  {
    "start": 41.44,
    "end": 44.0,
    "text": "Ikhlaskan kepergiannya dengan doa yang"
  },
  {
    "start": 44.0,
    "end": 44.74,
    "text": "tulus,"
  },
  {
    "start": 44.74,
    "end": 47.16,
    "text": "dan simpan kenangan indahnya sebagai"
  },
  {
    "start": 47.16,
    "end": 49.79,
    "text": "pelita abadi di dalam hatimu."
  }
]