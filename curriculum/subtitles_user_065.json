[
  {
    "start": 0.0,
    "end": 2.4,
    "text": "Semua manusia yang pernah menginjakkan"
  },
  {
    "start": 2.4,
    "end": 3.92,
    "text": "kakinya di muka bumi ini"
  },
  {
    "start": 3.92,
    "end": 6.32,
    "text": "pasti pernah melakukan kesalahan,"
  },
  {
    "start": 6.32,
    "end": 7.96,
    "text": "termasuk dirimu."
  },
  {
    "start": 7.96,
    "end": 10.05,
    "text": "Mungkin kamu pernah salah memilih"
  },
  {
    "start": 10.05,
    "end": 11.44,
    "text": "keputusan karier,"
  },
  {
    "start": 11.44,
    "end": 13.72,
    "text": "salah menaruh kepercayaan pada orang"
  },
  {
    "start": 13.72,
    "end": 14.73,
    "text": "yang salah,"
  },
  {
    "start": 14.73,
    "end": 16.69,
    "text": "atau bertindak bodoh saat masih"
  },
  {
    "start": 16.69,
    "end": 17.63,
    "text": "muda."
  },
  {
    "start": 17.63,
    "end": 20.23,
    "text": "Tapi terus-menerus mencaci dirimu sendiri"
  },
  {
    "start": 20.23,
    "end": 22.12,
    "text": "atas kesalahan masa lalu tidak"
  },
  {
    "start": 22.12,
    "end": 24.02,
    "text": "akan pernah bisa memutar balik"
  },
  {
    "start": 24.02,
    "end": 25.28,
    "text": "jarum jam."
  },
  {
    "start": 25.28,
    "end": 27.24,
    "text": "Itu hanya akan menghukum jiwamu"
  },
  {
    "start": 27.24,
    "end": 30.21,
    "text": "tanpa menghasilkan perbaikan apa pun."
  },
  {
    "start": 30.21,
    "end": 32.49,
    "text": "Orang yang bijak memandang kesalahan"
  },
  {
    "start": 32.49,
    "end": 34.38,
    "text": "masa lalunya sebagai guru yang"
  },
  {
    "start": 34.38,
    "end": 35.08,
    "text": "tegas,"
  },
  {
    "start": 35.08,
    "end": 37.8,
    "text": "bukan sebagai vonis hukuman mati."
  },
  {
    "start": 37.8,
    "end": 40.14,
    "text": "Terimalah kenyataan bahwa dulu ilmumu"
  },
  {
    "start": 40.14,
    "end": 41.53,
    "text": "belum cukup."
  },
  {
    "start": 41.53,
    "end": 43.23,
    "text": "Maafkan dirimu yang di masa"
  },
  {
    "start": 43.23,
    "end": 43.86,
    "text": "lalu,"
  },
  {
    "start": 43.86,
    "end": 46.01,
    "text": "dan gunakan kebijaksanaan hari ini"
  },
  {
    "start": 46.01,
    "end": 48.35,
    "text": "untuk melangkah lebih baik."
  }
]