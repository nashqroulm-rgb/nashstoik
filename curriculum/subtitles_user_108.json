[
  {
    "start": 0.0,
    "end": 2.22,
    "text": "Dunia modern dirancang khusus untuk"
  },
  {
    "start": 2.22,
    "end": 5.44,
    "text": "memecah perhatianmu menjadi serpihan-serpihan kecil"
  },
  {
    "start": 5.44,
    "end": 7.28,
    "text": "yang tidak berdaya."
  },
  {
    "start": 7.28,
    "end": 10.0,
    "text": "Notifikasi yang berbunyi setiap menit,"
  },
  {
    "start": 10.0,
    "end": 11.9,
    "text": "video pendek tanpa henti,"
  },
  {
    "start": 11.9,
    "end": 14.06,
    "text": "dan berita sensasional yang memicu"
  },
  {
    "start": 14.06,
    "end": 15.32,
    "text": "kecemasan."
  },
  {
    "start": 15.32,
    "end": 17.47,
    "text": "Jika kamu tidak bisa mengendalikan"
  },
  {
    "start": 17.47,
    "end": 18.93,
    "text": "fokus perhatianmu,"
  },
  {
    "start": 18.93,
    "end": 20.51,
    "text": "maka orang lain yang akan"
  },
  {
    "start": 20.51,
    "end": 24.12,
    "text": "mengendalikannya demi keuntungan bisnis mereka."
  },
  {
    "start": 24.12,
    "end": 26.34,
    "text": "Fokus yang mendalam adalah kekuatan"
  },
  {
    "start": 26.34,
    "end": 28.11,
    "text": "super di abad ini."
  },
  {
    "start": 28.11,
    "end": 30.71,
    "text": "Belajarlah untuk mematikan gangguan gawai"
  },
  {
    "start": 30.71,
    "end": 32.54,
    "text": "saat kamu sedang bekerja atau"
  },
  {
    "start": 32.54,
    "end": 35.45,
    "text": "sedang berkumpul bersama keluargamu."
  },
  {
    "start": 35.45,
    "end": 37.61,
    "text": "Berikan kehadiranmu yang utuh pada"
  },
  {
    "start": 37.61,
    "end": 39.13,
    "text": "apa pun yang sedang kamu"
  },
  {
    "start": 39.13,
    "end": 40.27,
    "text": "lakukan."
  },
  {
    "start": 40.27,
    "end": 42.48,
    "text": "Kualitas hidupmu ditentukan oleh ke"
  },
  {
    "start": 42.48,
    "end": 45.01,
    "text": "mana kamu mengarahkan perhatianmu setiap"
  },
  {
    "start": 45.01,
    "end": 46.03,
    "text": "detik."
  }
]