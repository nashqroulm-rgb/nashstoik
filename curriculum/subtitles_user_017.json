[
  {
    "start": 0.0,
    "end": 1.92,
    "text": "Pernah tidak kamu merasa bahwa"
  },
  {
    "start": 1.92,
    "end": 3.91,
    "text": "semakin banyak barang yang kamu"
  },
  {
    "start": 3.91,
    "end": 4.75,
    "text": "miliki,"
  },
  {
    "start": 4.75,
    "end": 7.06,
    "text": "kepalamu justru terasa semakin penuh"
  },
  {
    "start": 7.06,
    "end": 8.47,
    "text": "dan berat?"
  },
  {
    "start": 8.47,
    "end": 10.52,
    "text": "Kita sering terjebak dalam ilusi"
  },
  {
    "start": 10.52,
    "end": 12.96,
    "text": "bahwa kebahagiaan akan bertambah kalau"
  },
  {
    "start": 12.96,
    "end": 14.82,
    "text": "kita punya barang baru,"
  },
  {
    "start": 14.82,
    "end": 16.62,
    "text": "pakaian bermerek baru,"
  },
  {
    "start": 16.62,
    "end": 19.25,
    "text": "atau mainan mahal berikutnya."
  },
  {
    "start": 19.25,
    "end": 21.62,
    "text": "Tapi begitu barang itu terbeli,"
  },
  {
    "start": 21.62,
    "end": 23.87,
    "text": "rasa puasnya cuma bertahan beberapa"
  },
  {
    "start": 23.87,
    "end": 24.57,
    "text": "hari,"
  },
  {
    "start": 24.57,
    "end": 26.43,
    "text": "lalu kita kembali merasa haus"
  },
  {
    "start": 26.43,
    "end": 27.97,
    "text": "dan gelisah."
  },
  {
    "start": 27.97,
    "end": 30.22,
    "text": "Dengar baik-baik kawan."
  },
  {
    "start": 30.22,
    "end": 32.85,
    "text": "Kekayaan sejati bukanlah tentang seberapa"
  },
  {
    "start": 32.85,
    "end": 34.84,
    "text": "banyak harta yang berhasil kamu"
  },
  {
    "start": 34.84,
    "end": 37.34,
    "text": "kumpulkan di dalam rumahmu."
  },
  {
    "start": 37.34,
    "end": 39.84,
    "text": "Kekayaan sejati adalah tentang seberapa"
  },
  {
    "start": 39.84,
    "end": 41.76,
    "text": "sedikit hal yang kamu butuhkan"
  },
  {
    "start": 41.76,
    "end": 44.39,
    "text": "untuk merasa cukup dan damai."
  },
  {
    "start": 44.39,
    "end": 46.06,
    "text": "Orang yang paling bebas di"
  },
  {
    "start": 46.06,
    "end": 47.79,
    "text": "dunia ini bukan mereka yang"
  },
  {
    "start": 47.79,
    "end": 49.21,
    "text": "punya segalanya,"
  },
  {
    "start": 49.21,
    "end": 51.32,
    "text": "tapi mereka yang tidak diperbudak"
  },
  {
    "start": 51.32,
    "end": 53.76,
    "text": "oleh keinginannya sendiri."
  },
  {
    "start": 53.76,
    "end": 54.79,
    "text": "Malam ini,"
  },
  {
    "start": 54.79,
    "end": 58.19,
    "text": "lihatlah sekelilingmu dengan rasa syukur."
  },
  {
    "start": 58.19,
    "end": 60.24,
    "text": "Syukuri pakaian hangat yang kamu"
  },
  {
    "start": 60.24,
    "end": 61.01,
    "text": "pakai,"
  },
  {
    "start": 61.01,
    "end": 64.28,
    "text": "makanan sederhana yang mengenyangkan perutmu,"
  },
  {
    "start": 64.28,
    "end": 67.49,
    "text": "dan tempat berteduh yang melindungimu."
  },
  {
    "start": 67.49,
    "end": 69.8,
    "text": "Belajarlah merasa cukup."
  }
]