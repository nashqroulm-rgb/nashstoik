[
  {
    "start": 0.0,
    "end": 1.73,
    "text": "Malam ini genap tujuh pekan"
  },
  {
    "start": 1.73,
    "end": 4.48,
    "text": "kita berjalan beriringan melatih ketenangan"
  },
  {
    "start": 4.48,
    "end": 6.33,
    "text": "dan ketahanan jiwa."
  },
  {
    "start": 6.33,
    "end": 9.4,
    "text": "Perhatikan bagaimana batinmu sekarang."
  },
  {
    "start": 9.4,
    "end": 11.64,
    "text": "Beban-beban yang dulu terasa begitu"
  },
  {
    "start": 11.64,
    "end": 13.04,
    "text": "menyesakkan dada,"
  },
  {
    "start": 13.04,
    "end": 14.9,
    "text": "kini terasa jauh lebih ringan"
  },
  {
    "start": 14.9,
    "end": 17.2,
    "text": "bukan karena masalahnya hilang,"
  },
  {
    "start": 17.2,
    "end": 19.25,
    "text": "tapi karena jiwamu sudah semakin"
  },
  {
    "start": 19.25,
    "end": 20.91,
    "text": "kuat memikulnya."
  },
  {
    "start": 20.91,
    "end": 23.08,
    "text": "Kamu sudah belajar membedakan mana"
  },
  {
    "start": 23.08,
    "end": 24.94,
    "text": "yang bisa kamu kendalikan dan"
  },
  {
    "start": 24.94,
    "end": 27.49,
    "text": "mana yang harus kamu lepaskan."
  },
  {
    "start": 27.49,
    "end": 29.6,
    "text": "Kamu sudah belajar menjaga reaksi"
  },
  {
    "start": 29.6,
    "end": 31.33,
    "text": "batinmu di tengah caci maki"
  },
  {
    "start": 31.33,
    "end": 32.35,
    "text": "dunia."
  },
  {
    "start": 32.35,
    "end": 34.4,
    "text": "Itu adalah kemenangan batin yang"
  },
  {
    "start": 34.4,
    "end": 36.57,
    "text": "tidak ternilai harganya."
  },
  {
    "start": 36.57,
    "end": 39.07,
    "text": "Kemenangan yang tidak membutuhkan piala"
  },
  {
    "start": 39.07,
    "end": 41.62,
    "text": "atau pengakuan dari siapa pun."
  },
  {
    "start": 41.62,
    "end": 44.12,
    "text": "Tersenyumlah malam ini kawan."
  },
  {
    "start": 44.12,
    "end": 46.16,
    "text": "Banggalah pada dirimu yang terus"
  },
  {
    "start": 46.16,
    "end": 48.59,
    "text": "setia belajar dan bertumbuh."
  },
  {
    "start": 48.59,
    "end": 50.58,
    "text": "Tidurlah dengan rasa damai yang"
  },
  {
    "start": 50.58,
    "end": 51.22,
    "text": "utuh,"
  },
  {
    "start": 51.22,
    "end": 53.07,
    "text": "esok kita akan melangkah lagi"
  },
  {
    "start": 53.07,
    "end": 54.99,
    "text": "ke pekan berikutnya."
  }
]