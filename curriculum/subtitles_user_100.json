[
  {
    "start": 0.0,
    "end": 2.12,
    "text": "Malam ini kita merayakan tonggak"
  },
  {
    "start": 2.12,
    "end": 4.76,
    "text": "bersejarah: seratus hari perjalanan kita"
  },
  {
    "start": 4.76,
    "end": 7.94,
    "text": "melatih ketenangan dan ketahanan jiwa."
  },
  {
    "start": 7.94,
    "end": 9.79,
    "text": "Seratus hari yang lalu,"
  },
  {
    "start": 9.79,
    "end": 12.3,
    "text": "mungkin hatimu masih sering bergejolak"
  },
  {
    "start": 12.3,
    "end": 14.02,
    "text": "oleh hal-hal kecil di luar"
  },
  {
    "start": 14.02,
    "end": 15.34,
    "text": "kendalimu."
  },
  {
    "start": 15.34,
    "end": 17.33,
    "text": "Tapi lihatlah dirimu malam ini"
  },
  {
    "start": 17.33,
    "end": 18.38,
    "text": "kawan."
  },
  {
    "start": 18.38,
    "end": 20.57,
    "text": "Kamu telah belajar melepaskan apa"
  },
  {
    "start": 20.57,
    "end": 22.15,
    "text": "yang bukan milikmu,"
  },
  {
    "start": 22.15,
    "end": 24.14,
    "text": "memaafkan luka masa lalu,"
  },
  {
    "start": 24.14,
    "end": 26.52,
    "text": "dan menemukan kedamaian yang berakar"
  },
  {
    "start": 26.52,
    "end": 29.1,
    "text": "kuat di dalam dadamu sendiri."
  },
  {
    "start": 29.1,
    "end": 31.01,
    "text": "Seratus hari ini adalah bukti"
  },
  {
    "start": 31.01,
    "end": 33.26,
    "text": "nyata bahwa kamu memiliki kekuatan"
  },
  {
    "start": 33.26,
    "end": 35.25,
    "text": "luar biasa untuk mengubah cara"
  },
  {
    "start": 35.25,
    "end": 37.56,
    "text": "pandangmu terhadap dunia."
  },
  {
    "start": 37.56,
    "end": 40.21,
    "text": "Berterima kasihlah kepada dirimu sendiri"
  },
  {
    "start": 40.21,
    "end": 42.32,
    "text": "yang tidak pernah menyerah untuk"
  },
  {
    "start": 42.32,
    "end": 44.44,
    "text": "belajar dan bertumbuh."
  },
  {
    "start": 44.44,
    "end": 45.43,
    "text": "Malam ini,"
  },
  {
    "start": 45.43,
    "end": 47.61,
    "text": "tidurlah dengan penuh rasa hormat"
  },
  {
    "start": 47.61,
    "end": 50.52,
    "text": "dan syukur atas pencapaian jiwamu."
  }
]