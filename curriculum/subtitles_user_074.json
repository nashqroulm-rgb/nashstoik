[
  {
    "start": 0.0,
    "end": 2.04,
    "text": "Saat kamu pergi berolahraga dan"
  },
  {
    "start": 2.04,
    "end": 3.88,
    "text": "mengangkat beban berat,"
  },
  {
    "start": 3.88,
    "end": 6.06,
    "text": "otot-ototmu akan terasa sakit dan"
  },
  {
    "start": 6.06,
    "end": 7.51,
    "text": "lelah bukan?"
  },
  {
    "start": 7.51,
    "end": 9.48,
    "text": "Tapi kamu tidak mengutuk beban"
  },
  {
    "start": 9.48,
    "end": 10.4,
    "text": "besi itu,"
  },
  {
    "start": 10.4,
    "end": 12.18,
    "text": "karena kamu tahu bahwa rasa"
  },
  {
    "start": 12.18,
    "end": 14.29,
    "text": "sakit itulah yang sedang merobek"
  },
  {
    "start": 14.29,
    "end": 16.39,
    "text": "serat ototmu agar tumbuh menjadi"
  },
  {
    "start": 16.39,
    "end": 18.44,
    "text": "lebih kekar dan kuat."
  },
  {
    "start": 18.44,
    "end": 20.61,
    "text": "Begitu juga dengan setiap masalah"
  },
  {
    "start": 20.61,
    "end": 23.04,
    "text": "dan kesulitan yang datang menghampiri"
  },
  {
    "start": 23.04,
    "end": 24.82,
    "text": "hidupmu hari ini."
  },
  {
    "start": 24.82,
    "end": 26.93,
    "text": "Masalah itu adalah beban latihan"
  },
  {
    "start": 26.93,
    "end": 29.1,
    "text": "yang sedang semesta berikan untuk"
  },
  {
    "start": 29.1,
    "end": 31.47,
    "text": "memperkuat otot-otot kesabaran,"
  },
  {
    "start": 31.47,
    "end": 32.72,
    "text": "kebijaksanaan,"
  },
  {
    "start": 32.72,
    "end": 34.76,
    "text": "dan ketahanan jiwamu."
  },
  {
    "start": 34.76,
    "end": 37.33,
    "text": "Tanpa adanya ujian yang menantang,"
  },
  {
    "start": 37.33,
    "end": 39.64,
    "text": "jiwamu akan selamanya menjadi lemah"
  },
  {
    "start": 39.64,
    "end": 41.55,
    "text": "dan mudah tumbang oleh tiupan"
  },
  {
    "start": 41.55,
    "end": 43.06,
    "text": "angin sepele."
  },
  {
    "start": 43.06,
    "end": 44.97,
    "text": "Rangkul ujian hari ini dengan"
  },
  {
    "start": 44.97,
    "end": 46.75,
    "text": "senyuman pejuang."
  },
  {
    "start": 46.75,
    "end": 49.25,
    "text": "Batinmu sedang ditempa menjadi pribadi"
  },
  {
    "start": 49.25,
    "end": 51.49,
    "text": "yang luar biasa tangguh."
  }
]