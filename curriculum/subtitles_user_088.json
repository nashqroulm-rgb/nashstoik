[
  {
    "start": 0.0,
    "end": 2.0,
    "text": "Berapa kali kamu mengatakan ya"
  },
  {
    "start": 2.0,
    "end": 3.93,
    "text": "untuk ajakan orang lain,"
  },
  {
    "start": 3.93,
    "end": 6.0,
    "text": "padahal seluruh jiwa dan ragamu"
  },
  {
    "start": 6.0,
    "end": 8.8,
    "text": "menjerit ingin mengatakan tidak?"
  },
  {
    "start": 8.8,
    "end": 11.0,
    "text": "Kamu takut dianggap sombong,"
  },
  {
    "start": 11.0,
    "end": 12.66,
    "text": "takut dijauhi teman,"
  },
  {
    "start": 12.66,
    "end": 14.6,
    "text": "atau takut membuat orang lain"
  },
  {
    "start": 14.6,
    "end": 15.73,
    "text": "kecewa."
  },
  {
    "start": 15.73,
    "end": 18.53,
    "text": "Akhirnya kamu mengorbankan waktu istirahat"
  },
  {
    "start": 18.53,
    "end": 21.26,
    "text": "dan kesehatan mentalmu sendiri."
  },
  {
    "start": 21.26,
    "end": 22.73,
    "text": "Ketahuilah kawan,"
  },
  {
    "start": 22.73,
    "end": 24.73,
    "text": "setiap kali kamu mengatakan ya"
  },
  {
    "start": 24.73,
    "end": 26.92,
    "text": "pada hal yang tidak penting,"
  },
  {
    "start": 26.92,
    "end": 29.52,
    "text": "kamu sebenarnya sedang mengatakan tidak"
  },
  {
    "start": 29.52,
    "end": 30.92,
    "text": "pada keluargamu,"
  },
  {
    "start": 30.92,
    "end": 32.06,
    "text": "kesehatanmu,"
  },
  {
    "start": 32.06,
    "end": 33.99,
    "text": "dan tujuan hidupmu."
  },
  {
    "start": 33.99,
    "end": 36.32,
    "text": "Menolak dengan sopan bukanlah tanda"
  },
  {
    "start": 36.32,
    "end": 37.32,
    "text": "kebencian,"
  },
  {
    "start": 37.32,
    "end": 39.85,
    "text": "melainkan tanda bahwa kamu menghormati"
  },
  {
    "start": 39.85,
    "end": 42.05,
    "text": "batas kemampuan dirimu."
  },
  {
    "start": 42.05,
    "end": 44.32,
    "text": "Katakan tidak dengan senyuman yang"
  },
  {
    "start": 44.32,
    "end": 46.12,
    "text": "hangat dan nada bicara yang"
  },
  {
    "start": 46.12,
    "end": 47.18,
    "text": "tegas."
  },
  {
    "start": 47.18,
    "end": 49.92,
    "text": "Orang-orang yang tulus menyayangimu pasti"
  },
  {
    "start": 49.92,
    "end": 53.32,
    "text": "akan memahami dan menghargai keputusanmu."
  }
]