[
  {
    "start": 0.0,
    "end": 1.61,
    "text": "Besi baja yang kuat tidak"
  },
  {
    "start": 1.61,
    "end": 3.42,
    "text": "pernah dibentuk di dalam air"
  },
  {
    "start": 3.42,
    "end": 5.49,
    "text": "yang sejuk dan tenang."
  },
  {
    "start": 5.49,
    "end": 7.36,
    "text": "Baja terkuat ditempa di dalam"
  },
  {
    "start": 7.36,
    "end": 9.62,
    "text": "tungku api yang menyala-nyala,"
  },
  {
    "start": 9.62,
    "end": 12.0,
    "text": "lalu dihantam palu godam berkali-kali"
  },
  {
    "start": 12.0,
    "end": 14.2,
    "text": "hingga membentuk pedang yang tajam"
  },
  {
    "start": 14.2,
    "end": 15.49,
    "text": "dan kokoh."
  },
  {
    "start": 15.49,
    "end": 18.01,
    "text": "Begitu pula dengan pembentukan karakter"
  },
  {
    "start": 18.01,
    "end": 20.01,
    "text": "dan ketahanan mentalmu di dunia"
  },
  {
    "start": 20.01,
    "end": 20.91,
    "text": "ini."
  },
  {
    "start": 20.91,
    "end": 23.56,
    "text": "Tiap kali kamu menghadapi kegagalan,"
  },
  {
    "start": 23.56,
    "end": 25.36,
    "text": "tiap kali kamu ditolak,"
  },
  {
    "start": 25.36,
    "end": 26.91,
    "text": "dan tiap kali kamu harus"
  },
  {
    "start": 26.91,
    "end": 28.85,
    "text": "membasuh air matamu sendiri di"
  },
  {
    "start": 28.85,
    "end": 29.88,
    "text": "malam hari,"
  },
  {
    "start": 29.88,
    "end": 32.33,
    "text": "kamu sebenarnya sedang ditempa menjadi"
  },
  {
    "start": 32.33,
    "end": 35.05,
    "text": "pribadi yang luar biasa tangguh."
  },
  {
    "start": 35.05,
    "end": 37.43,
    "text": "Jangan gentar menghadapi pukulan palu"
  },
  {
    "start": 37.43,
    "end": 38.85,
    "text": "ujian hidup."
  },
  {
    "start": 38.85,
    "end": 41.56,
    "text": "Semesta sedang membentukmu menjadi pribadi"
  },
  {
    "start": 41.56,
    "end": 43.89,
    "text": "yang matang dan bijaksana."
  },
  {
    "start": 43.89,
    "end": 47.31,
    "text": "Sambutlah setiap tempaan dengan keikhlasan."
  }
]