[
  {
    "start": 0.0,
    "end": 2.06,
    "text": "Pernah tidak kamu merasa sangat"
  },
  {
    "start": 2.06,
    "end": 4.65,
    "text": "kecewa setelah membantu seseorang,"
  },
  {
    "start": 4.65,
    "end": 6.64,
    "text": "cuma gara-gara orang itu tidak"
  },
  {
    "start": 6.64,
    "end": 8.9,
    "text": "mengucapkan terima kasih atau lupa"
  },
  {
    "start": 8.9,
    "end": 10.89,
    "text": "membalas kebaikanmu?"
  },
  {
    "start": 10.89,
    "end": 12.81,
    "text": "Rasa kecewa itu muncul karena"
  },
  {
    "start": 12.81,
    "end": 15.07,
    "text": "sejak awal niatmu belum sepenuhnya"
  },
  {
    "start": 15.07,
    "end": 16.13,
    "text": "murni."
  },
  {
    "start": 16.13,
    "end": 17.33,
    "text": "Kamu memberi,"
  },
  {
    "start": 17.33,
    "end": 19.05,
    "text": "tapi di dalam hati kecilmu"
  },
  {
    "start": 19.05,
    "end": 22.31,
    "text": "kamu diam-diam sedang menuntut imbalan."
  },
  {
    "start": 22.31,
    "end": 24.76,
    "text": "Belajarlah memberi seperti pohon buah"
  },
  {
    "start": 24.76,
    "end": 26.36,
    "text": "di tepi jalan."
  },
  {
    "start": 26.36,
    "end": 28.88,
    "text": "Dia menghasilkan buah yang manis,"
  },
  {
    "start": 28.88,
    "end": 31.8,
    "text": "membiarkan orang yang lewat memetiknya,"
  },
  {
    "start": 31.8,
    "end": 34.06,
    "text": "tanpa pernah menagih ucapan terima"
  },
  {
    "start": 34.06,
    "end": 36.12,
    "text": "kasih dari siapa pun."
  },
  {
    "start": 36.12,
    "end": 38.31,
    "text": "Kepuasan sejati dari berbuat baik"
  },
  {
    "start": 38.31,
    "end": 40.7,
    "text": "ada pada perbuatan itu sendiri,"
  },
  {
    "start": 40.7,
    "end": 43.48,
    "text": "bukan pada balasan dari manusia."
  },
  {
    "start": 43.48,
    "end": 45.87,
    "text": "Begitu kamu melepaskan harapan untuk"
  },
  {
    "start": 45.87,
    "end": 47.53,
    "text": "dipuji atau dibalas,"
  },
  {
    "start": 47.53,
    "end": 49.53,
    "text": "hatimu akan terbebas dari rasa"
  },
  {
    "start": 49.53,
    "end": 50.65,
    "text": "kecewa."
  },
  {
    "start": 50.65,
    "end": 52.91,
    "text": "Berbuatlah baik dengan tulus,"
  },
  {
    "start": 52.91,
    "end": 54.44,
    "text": "lalu lupakan."
  }
]